---
import Arrow from "../components/common/Arrow.astro";
import PageMotion from "../components/common/PageMotion.astro";

const colors = [
	{ name: "Jet Black", value: "#252525", className: "black" },
	{ name: "Studio White", value: "#FFFFFF", className: "white" },
	{ name: "Spotlight Yellow", value: "#EFDA4A", className: "yellow" },
	{ name: "Sky Blue", value: "#93E9F9", className: "blue" },
	{ name: "Soft Pink", value: "#FDBFBF", className: "pink" },
	{ name: "Fresh Mint", value: "#7CF5B5", className: "mint" },
];

const secondaryColors = [
	{ name: "Grid Gray", value: "#383838", className: "grid-gray" },
	{ name: "Signal Red", value: "#F55C66", className: "signal-red" },
	{ name: "Deep Teal", value: "#26798A", className: "deep-teal" },
	{ name: "Warm Ochre", value: "#CC9504", className: "warm-ochre" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow, noarchive" />
		<meta
			name="description"
			content="The visual identity, colors, typography, and approved assets for Jet Sullivan."
		/>
		<link rel="icon" type="image/png" href="/brand-center-favicon.png" />
		<title>Brand Center · Jet Sullivan</title>
	</head>

	<body>
		<a class="skip-link" href="#brand-content">Skip to brand guide</a>

		<header class="page-header">
			<a class="home-link" href="/" aria-label="Return to the Jet Sullivan website">
				<svg class="home-arrow-icon" viewBox="0 0 26 20" aria-hidden="true">
					<path d="M23 10H3M10 3L3 10L10 17"></path>
				</svg>
			</a>
			<p>Brand Center</p>
		</header>

		<main id="brand-content" data-motion-root data-motion-speed="0.8">
			<section class="hero" aria-labelledby="brand-heading">
				<div class="hero-shape hero-shape-one" data-motion-depth="far-a" aria-hidden="true"></div>
				<div class="hero-shape hero-shape-two" data-motion-depth="far-b" aria-hidden="true"></div>

				<div class="hero-copy" data-motion-depth="scene">
					<p class="eyebrow">The official guide</p>
					<h1 id="brand-heading"><span>JET</span><span>SULLIVAN</span></h1>
					<p class="hero-intro">
						I created this guide to help with creating graphics, sites, or pages
						to maintain consistency!
					</p>
				</div>

				<figure class="portrait-window" data-motion-depth="deep">
					<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<div class="portrait-frame">
						<picture>
							<source media="(max-width: 700px)" srcset="/jet-profile.png" />
							<img src="/jet-portrait-background.PNG" alt="Jet Sullivan" />
						</picture>
					</div>
					<figcaption>
						<span>Actor</span><span>Filmmaker</span><span>Storyteller</span>
					</figcaption>
				</figure>
			</section>

			<div class="section-divider hero-divider" aria-hidden="true"></div>

			<section class="section identity-section" aria-labelledby="identity-heading">
				<div class="section-heading" data-motion-depth="scene">
					<p class="section-number">01</p>
					<div>
						<p class="eyebrow" id="identity-heading">Identity</p>
					</div>
				</div>

				<div class="identity-grid" data-motion-depth="counter">
					<article class="wordmark-card wordmark-primary">
						<p class="card-label">Primary treatment</p>
						<p class="wordmark">JET SULLIVAN</p>
					</article>
					<article class="wordmark-card wordmark-reverse">
						<p class="card-label">Reverse treatment</p>
						<p class="wordmark">JET SULLIVAN</p>
					</article>
				</div>

				<div class="usage-notes" data-motion-depth="deep">
					<article class="note-window identity-note">
						<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<p>Full name.</p>
					</article>
					<article class="note-window identity-note">
						<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<p>Bold.</p>
					</article>
					<article class="note-window identity-note">
						<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<p>Easy to Read.</p>
					</article>
				</div>
			</section>

			<section class="section palette-section" aria-labelledby="palette-heading">
				<div class="section-heading" data-motion-depth="scene">
					<p class="section-number">02</p>
					<div>
						<p class="eyebrow" id="palette-heading">Color</p>
					</div>
				</div>

				<div class="palette-grid" data-motion-depth="counter">
					{
						colors.map((color) => (
							<button
								class={`color-card color-${color.className}`}
								type="button"
								data-copy-color={color.value}
								aria-label={`Copy ${color.name} color ${color.value}`}
							>
								<span class="color-fill" aria-hidden="true"></span>
								<span class="color-info">
									<strong>{color.name}</strong>
									<code>{color.value}</code>
								</span>
								<span class="copy-label" aria-hidden="true">Copy</span>
							</button>
						))
					}
				</div>
				<div class="note-window palette-note" data-motion-depth="deep">
					<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<p class="section-supporting">
						The colors are bright and vibrant and keep the site feeling bold.
					</p>
				</div>
				<div class="secondary-palette" data-motion-depth="counter">
					<div class="secondary-palette-heading">
						<h3>Secondary colors</h3>
						<p>Use these supporting accents sparingly when the core six need extra range.</p>
					</div>
					<div class="palette-grid secondary-palette-grid">
						{
							secondaryColors.map((color) => (
								<button
									class={`color-card color-${color.className}`}
									type="button"
									data-copy-color={color.value}
									aria-label={`Copy ${color.name} color ${color.value}`}
								>
									<span class="color-fill" aria-hidden="true"></span>
									<span class="color-info">
										<strong>{color.name}</strong>
										<code>{color.value}</code>
									</span>
									<span class="copy-label" aria-hidden="true">Copy</span>
								</button>
							))
						}
					</div>
				</div>
				<p class="copy-status" aria-live="polite"></p>
			</section>

			<section class="section type-section" aria-labelledby="type-heading">
				<div class="section-heading" data-motion-depth="scene">
					<p class="section-number">03</p>
					<div>
						<p class="eyebrow" id="type-heading">Typography</p>
					</div>
				</div>

				<div class="type-grid" data-motion-depth="counter">
					<article class="type-card display-type">
						<div class="type-meta">
							<p>Display</p>
							<span>Arial Black</span>
						</div>
						<p class="type-sample">Keep key parts bold!</p>
						<p class="alphabet">Aa Bb Cc Dd Ee Ff Gg 0123456789</p>
					</article>

					<article class="type-card body-type">
						<div class="type-meta">
							<p>Body</p>
							<span>Myriad Pro</span>
						</div>
						<p class="type-sample">
							Supporting text stays clean and effortless to read.
						</p>
						<p class="alphabet">Aa Bb Cc Dd Ee Ff Gg 0123456789</p>
					</article>
				</div>
			</section>

			<section class="section graphic-section" aria-labelledby="graphic-heading">
				<div class="section-heading" data-motion-depth="scene">
					<p class="section-number">04</p>
					<div>
						<p class="eyebrow" id="graphic-heading">Graphic language</p>
					</div>
				</div>

				<div class="design-details" data-motion-depth="counter">
					<details class="design-detail">
						<summary>
							<span class="detail-number">01</span>
							<span class="detail-title">
								<strong>Floating windows</strong>
								<small>About · Contact · News and Media</small>
							</span>
							<span class="detail-toggle" aria-hidden="true"></span>
						</summary>
						<div class="detail-content">
							<div class="detail-copy">
								<p>
									Rounded windows make content feel tactile and creative. Use a light
									frame, three small header dots, a soft shadow, and a slight tilt or
									drift to lift important content away from the background.
								</p>
								<ul>
									<li>Keep corners generously rounded.</li>
									<li>Use motion as a gentle accent.</li>
									<li>Keep text panels quieter than image panels.</li>
								</ul>
							</div>
							<div class="pattern-preview windows-preview" aria-hidden="true">
								<span class="pattern-window window-one"><i></i><i></i><i></i><b>✦</b></span>
								<span class="pattern-window window-two"><i></i><i></i><i></i><b>+</b></span>
							</div>
						</div>
					</details>

					<details class="design-detail">
						<summary>
							<span class="detail-number">02</span>
							<span class="detail-title">
								<strong>Angled transitions</strong>
								<small>Home · About · Media pages</small>
							</span>
							<span class="detail-toggle" aria-hidden="true"></span>
						</summary>
						<div class="detail-content">
							<div class="detail-copy">
								<p>
									Shallow diagonal bands are an optional way to add energy between major
									sections. Clean, straight transitions are equally on-brand and often
									the better choice when the content should feel quieter.
								</p>
								<ul>
									<li>Use angles only when extra movement helps.</li>
									<li>Choose clean edges for simpler layouts.</li>
									<li>If used, keep text outside the angled edge.</li>
								</ul>
							</div>
							<div class="pattern-preview angle-preview" aria-hidden="true">
								<span></span><span></span><span></span>
							</div>
						</div>
					</details>

					<details class="design-detail">
						<summary>
							<span class="detail-number">03</span>
							<span class="detail-title">
								<strong>Glass controls</strong>
								<small>Navigation · Search · Brainstorm tools</small>
							</span>
							<span class="detail-toggle" aria-hidden="true"></span>
						</summary>
						<div class="detail-content">
							<div class="detail-copy">
								<p>
									Menus and utility controls sit inside translucent white surfaces.
									Blur, thin light borders, and dark, substantial icons keep the
									controls visible over changing backgrounds.
								</p>
								<ul>
									<li>Use a 12–14px background blur.</li>
									<li>Keep primary controls circular.</li>
									<li>Use Jet Black icons with confident strokes.</li>
								</ul>
							</div>
							<div class="pattern-preview glass-preview" aria-hidden="true">
								<span class="glass-control menu-demo"><i></i></span>
								<span class="glass-control arrow-demo"><Arrow direction="left" size="32px" /></span>
							</div>
						</div>
					</details>

					<details class="design-detail">
						<summary>
							<span class="detail-number">04</span>
							<span class="detail-title">
								<strong>Bubbles &amp; connectors</strong>
								<small>Brainstorm</small>
							</span>
							<span class="detail-toggle" aria-hidden="true"></span>
						</summary>
						<div class="detail-content">
							<div class="detail-copy">
								<p>
									The Brainstorm canvas turns the window language into flexible idea
									bubbles. Soft translucency, colored glow, dotted backgrounds, and
									dashed links make the space feel playful and useful.
								</p>
								<ul>
									<li>Use a soft shadow instead of a heavy outline.</li>
									<li>Let color identify and group ideas.</li>
									<li>Keep connectors secondary to the content.</li>
								</ul>
							</div>
							<div class="pattern-preview bubble-preview" aria-hidden="true">
								<svg viewBox="0 0 400 240" preserveAspectRatio="none"><path d="M110 76 286 165"></path></svg>
								<span class="demo-bubble bubble-one">Idea</span>
								<span class="demo-bubble bubble-two">Story</span>
							</div>
						</div>
					</details>

					<details class="design-detail">
						<summary>
							<span class="detail-number">05</span>
							<span class="detail-title">
								<strong>Type in the interface</strong>
								<small>Headlines · Navigation · Supporting copy</small>
							</span>
							<span class="detail-toggle" aria-hidden="true"></span>
						</summary>
						<div class="detail-content">
							<div class="detail-copy">
								<p>
									Arial Black carries names, major headings, labels, and important
									actions. Myriad Pro supports it with open, conversational paragraphs,
									captions, and helper text.
								</p>
								<ul>
									<li>Use display type to establish hierarchy.</li>
									<li>Use body type for longer reading.</li>
									<li>Keep all-caps labels short and well spaced.</li>
								</ul>
							</div>
							<div class="pattern-preview interface-type-preview" aria-hidden="true">
								<strong>Make it<br />bold.</strong>
								<p>Then give the details room to breathe.</p>
							</div>
						</div>
					</details>

					<details class="design-detail">
						<summary>
							<span class="detail-number">06</span>
							<span class="detail-title">
								<strong>Dotted grid</strong>
								<small>Homepage footer · Brainstorm canvas</small>
							</span>
							<span class="detail-toggle" aria-hidden="true"></span>
						</summary>
						<div class="detail-content">
							<div class="detail-copy">
								<p>
									The dotted grid adds quiet structure and texture without competing
									with the work. It gives open areas a graphic rhythm while keeping
									the overall layout clean.
								</p>
								<ul>
									<li>Keep the dots small, even, and low contrast.</li>
									<li>Use the grid in open backgrounds rather than behind dense text.</li>
									<li>Pair it with bold type, clean panels, or spacious layouts.</li>
								</ul>
							</div>
							<div class="pattern-preview dot-grid-preview" aria-hidden="true">
								<span>Dotted grid</span>
							</div>
						</div>
					</details>
				</div>
			</section>

			<section class="section voice-section" aria-labelledby="voice-heading">
				<div class="section-heading" data-motion-depth="scene">
					<p class="section-number">05</p>
					<div>
						<p class="eyebrow" id="voice-heading">Voice &amp; expression</p>
					</div>
				</div>

				<div class="voice-grid" data-motion-depth="counter">
					<article>
						<span>01</span>
						<h3>Clear</h3>
						<p>Lead with the idea. Use plain language and keep the message moving.</p>
					</article>
					<article>
						<span>02</span>
						<h3>Curious</h3>
						<p>Bring a sense of discovery, play, and possibility to the work.</p>
					</article>
					<article>
						<span>03</span>
						<h3>Human</h3>
						<p>Sound like a person. Stay warm, specific, and grounded.</p>
					</article>
				</div>
			</section>

			<section class="section assets-section" aria-labelledby="assets-heading">
				<div class="section-heading" data-motion-depth="scene">
					<p class="section-number">06</p>
					<div>
						<p class="eyebrow" id="assets-heading">Assets</p>
					</div>
				</div>

				<div class="asset-grid" data-motion-depth="counter">
					<a class="asset-card asset-photo" href="/jet-portrait-background.PNG" download>
						<span class="asset-preview">
							<img src="/jet-portrait-background.PNG" alt="" />
						</span>
						<span class="asset-copy">
							<span><strong>Portrait</strong><small>PNG · high resolution</small></span>
							<Arrow direction="down" size="23px" />
						</span>
					</a>

					<a class="asset-card asset-profile" href="/jet-portrait.jpg" download>
						<span class="asset-preview">
							<img src="/jet-portrait.jpg" alt="" />
						</span>
						<span class="asset-copy">
							<span><strong>Portrait cutout</strong><small>JPG · web ready</small></span>
							<Arrow direction="down" size="23px" />
						</span>
					</a>

					<a class="asset-card asset-icon" href="/jet-profile.png" download>
						<span class="asset-preview">
							<img src="/jet-profile.png" alt="" />
						</span>
						<span class="asset-copy">
							<span><strong>Profile icon</strong><small>PNG · square</small></span>
							<Arrow direction="down" size="23px" />
						</span>
					</a>
				</div>
			</section>

			<section class="contact-strip" aria-labelledby="contact-heading">
				<p class="eyebrow">Questions or special requests?</p>
				<h2 id="contact-heading">Let’s talk!</h2>
				<a href="mailto:contact@jetsullivan.com">
					contact@jetsullivan.com
					<Arrow size="23px" />
				</a>
			</section>
		</main>

		<footer>
			<p>Jet Sullivan · Brand Center</p>
			<p>Direct-access resource</p>
		</footer>

		<PageMotion />
	</body>
</html>

<script>
	const colorButtons = Array.from(
		document.querySelectorAll<HTMLButtonElement>("[data-copy-color]"),
	);
	const copyStatus = document.querySelector<HTMLElement>(".copy-status");
	let statusTimer: number | undefined;

	for (const button of colorButtons) {
		button.addEventListener("click", async () => {
			const value = button.dataset.copyColor;
			if (!value || !copyStatus) return;

			try {
				await navigator.clipboard.writeText(value);
				colorButtons.forEach((item) => item.classList.remove("is-copied"));
				button.classList.add("is-copied");
				copyStatus.textContent = `${value} copied to clipboard.`;
				window.clearTimeout(statusTimer);
				statusTimer = window.setTimeout(() => {
					button.classList.remove("is-copied");
					copyStatus.textContent = "";
				}, 2200);
			} catch {
				copyStatus.textContent = `Copy unavailable. Color: ${value}`;
			}
		});
	}
</script>

<style>
	:root {
		--black: #252525;
		--white: #ffffff;
		--cream: #f8f5ee;
		--yellow: #efda4a;
		--pink: #fdbfbf;
		--blue: #93e9f9;
		--mint: #7cf5b5;
		--font-body: "Myriad Pro", Myriad, Arial, sans-serif;
		--font-display: "Arial Black", "Myriad Pro", Arial, sans-serif;
		--site-control-top: max(
			clamp(18px, 3vh, 32px),
			calc(env(safe-area-inset-top) + 10px)
		);
		--site-control-left: max(
			clamp(18px, 3vw, 48px),
			calc(env(safe-area-inset-left) + 10px)
		);
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		background: var(--black);
		color: var(--black);
		font-family: var(--font-body);
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		min-width: 320px;
		background: var(--cream);
	}

	:global(a) {
		color: inherit;
	}

	:global(button),
	:global(a) {
		-webkit-tap-highlight-color: transparent;
	}

	.skip-link {
		position: fixed;
		z-index: 100;
		top: 12px;
		left: 12px;
		padding: 12px 18px;
		border-radius: 999px;
		background: var(--white);
		font-weight: 700;
		transform: translateY(-160%);
		transition: transform 160ms ease;
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	.page-header {
		position: absolute;
		z-index: 10;
		top: 0;
		left: 0;
		width: 100%;
		padding: clamp(20px, 3vw, 36px) clamp(22px, 5vw, 76px);
		color: var(--white);
		pointer-events: none;
	}

	.page-header p {
		margin: 0;
		font-size: 0.76rem;
		font-weight: 800;
		letter-spacing: 0.15em;
		text-align: right;
		text-transform: uppercase;
	}

	.home-link {
		position: fixed;
		z-index: 100;
		top: var(--site-control-top);
		left: var(--site-control-left);
		display: grid;
		width: 64px;
		height: 64px;
		border: 1px solid rgb(255 255 255 / 58%);
		border-radius: 32px;
		outline: 1px solid rgb(255 255 255 / 16%);
		outline-offset: -3px;
		background: rgb(255 255 255 / 64%);
		box-shadow: 0 8px 28px rgb(37 37 37 / 14%);
		color: var(--black);
		text-decoration: none;
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		place-items: center;
		pointer-events: auto;
		transition:
			background-color 180ms ease,
			box-shadow 220ms ease,
			transform 280ms cubic-bezier(0.34, 1.4, 0.64, 1);
	}

	.home-arrow-icon {
		display: block;
		width: 26px;
		height: 20px;
		fill: none;
		stroke: var(--black);
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 4;
	}

	.home-link:hover {
		background: rgb(255 255 255 / 78%);
		box-shadow:
			0 8px 28px rgb(37 37 37 / 14%),
			0 0 18px rgb(255 255 255 / 38%);
		transform: translateX(-3px);
	}

	.home-link:focus-visible {
		outline: 3px solid var(--pink);
		outline-offset: 2px;
	}

	.hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(270px, 0.55fr);
		align-items: center;
		gap: clamp(40px, 7vw, 110px);
		min-height: min(900px, 100svh);
		padding: clamp(125px, 14vw, 180px) clamp(24px, 7vw, 110px) clamp(85px, 9vw, 130px);
		overflow: hidden;
		background-color: var(--black);
		background-image: radial-gradient(circle, #383838 1.5px, transparent 1.6px);
		background-size: 24px 24px;
		color: var(--white);
	}

	.hero::after {
		position: absolute;
		z-index: 0;
		right: -10%;
		bottom: -20%;
		width: 54vw;
		height: 48vw;
		min-width: 520px;
		min-height: 470px;
		border-radius: 50%;
		background: var(--yellow);
		content: "";
	}

	.section-divider {
		--divider-height: clamp(110px, 11vw, 190px);
		position: relative;
		z-index: 20;
		width: 100%;
		height: var(--divider-height);
		margin-block: calc(var(--divider-height) / -2);
		background: var(--black);
		clip-path: polygon(0 28%, 100% 0, 100% 72%, 0 100%);
