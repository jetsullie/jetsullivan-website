---
import SiteMenu from "../components/common/SiteMenu.astro";
import PageMotion from "../components/common/PageMotion.astro";

const backgroundWindows = Array.from({ length: 22 }, (_, index) => ({
	x: (index * 19 + 3) % 94,
	y: (index * 31 + 8) % 88,
	size: 42 + (index % 6) * 8,
	symbol: ["✦", "○", "×", "◇", "▶", "+", "⌁", "□"][index % 8],
}));
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Secure owner login for Jet Sullivan's website." />
		<meta name="robots" content="noindex, nofollow, noarchive" />
		<link rel="icon" type="image/png" href="/favicon-profile.png" />
		<title>Admin Login — Jet Sullivan</title>
	</head>

	<body>
		<main class="login-page" data-motion-root data-motion-speed="1.2">
			<div class="top-frame" data-motion-depth="counter" aria-hidden="true"></div>
			<div class="blue-panel" data-motion-depth="counter" aria-hidden="true"></div>

			<div class="background-windows" data-motion-bounds aria-hidden="true">
				{
					backgroundWindows.map((item, index) => (
						<span
							class="mini-window"
							data-motion-float
							style={`--x:${item.x}%;--y:${item.y}%;--size:${item.size}px;--delay:-${index * 0.27}s;`}
						>
							<span>{item.symbol}</span>
						</span>
					))
				}
			</div>

			<SiteMenu showHomeButton />

			<section class="login-hero" data-motion-depth="scene" aria-labelledby="login-heading">
				<div class="heading-block">
					<p class="eyebrow">Private owner portal</p>
					<h1 id="login-heading">Admin Login</h1>
				</div>

				<div class="login-card">
					<div class="lock-icon" aria-hidden="true">
						<svg viewBox="0 0 96 96" focusable="false">
							<path class="lock-shackle" d="M29 39V31c0-11 8-19 19-19s19 8 19 19v8" />
							<rect x="19" y="39" width="58" height="45" rx="13" />
							<circle cx="48" cy="59" r="5" />
							<path d="M48 64v8" />
						</svg>
					</div>

					<div class="login-copy">
						<p class="card-kicker">Jet Sullivan</p>
						<h2>Welcome back.</h2>
						<p>
							Continue with your verified owner account to manage biography,
							posts, and website media.
						</p>
					</div>

					<a class="login-button" href="/admin/">
						<span>Enter admin</span>
						<svg viewBox="0 0 28 20" aria-hidden="true">
							<path d="M3 10h21M17 3l7 7-7 7" />
						</svg>
					</a>

					<p class="security-note">
						<span aria-hidden="true"></span>
						Protected owner access
					</p>
				</div>
			</section>
		</main>

		<div class="section-divider" aria-hidden="true"></div>

		<footer class="site-footer">
			<div class="footer-content">
				<p class="footer-name">Admin Jet Sullivan</p>
				<span aria-hidden="true"></span>
				<p class="footer-location">Austin, Texas</p>
			</div>
		</footer>

		<PageMotion />
	</body>
</html>

<style>
	:root {
		--white: #fff;
		--black: #252525;
		--pink: #fdbfbf;
		--mint: #7cf5b5;
		--blue: #93e9f9;
		--display: "Arial Black", "Myriad Pro", Arial, sans-serif;
		--body: "Myriad Pro", Myriad, Arial, sans-serif;
		--footer-gap: clamp(68px, 7vw, 104px);
	}

	:global(*) { box-sizing: border-box; }
	:global(html) {
		background: var(--black);
		color: var(--black);
		font-family: var(--body);
	}
	:global(body) {
		margin: 0;
		min-width: 320px;
		min-height: 100vh;
		overflow-x: clip;
	}

	.login-page {
		position: relative;
		display: grid;
		min-height: max(760px, 100svh);
		padding: clamp(116px, 13vh, 164px) clamp(28px, 6vw, 105px) var(--footer-gap);
		overflow: hidden;
		background: linear-gradient(180deg, #fff 0%, #effcff 31%, #d4f7fd 68%, #c0f2fb 100%);
	}

	.top-frame {
		position: absolute;
		z-index: 8;
		top: -5vw;
		left: -3%;
		width: 106%;
		height: 9vw;
		min-height: 54px;
		background: var(--black);
		pointer-events: none;
		transform: rotate(-3deg);
	}

	.blue-panel {
		position: absolute;
		z-index: 1;
		top: 25%;
		bottom: -4%;
		left: 4%;
		width: 55%;
		border: 1px solid rgb(255 255 255 / 58%);
		border-radius: 26px;
		outline: 1px solid rgb(255 255 255 / 16%);
		outline-offset: -3px;
		background: rgb(226 248 252 / 68%);
		box-shadow: 0 8px 28px rgb(37 37 37 / 14%);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
	}

	.background-windows {
		position: absolute;
		z-index: 0;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.mini-window {
		position: absolute;
		top: var(--y);
		left: var(--x);
		display: grid;
		width: var(--size);
		aspect-ratio: 1;
		border: 1px solid rgb(255 255 255 / 44%);
		border-radius: clamp(7px, .8vw, 15px);
		background: rgb(156 166 170 / 20%);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 25%), 0 5px 14px rgb(37 37 37 / 5%);
		color: rgb(37 37 37 / 28%);
		font: 900 .82rem var(--display);
		-webkit-backdrop-filter: blur(3px);
		backdrop-filter: blur(3px);
		place-items: center;
	}

	.login-hero {
		position: relative;
		z-index: 30;
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(360px, .72fr);
		gap: clamp(44px, 7vw, 112px);
		align-items: center;
		width: min(100%, 1280px);
		margin: auto;
	}

	.heading-block { align-self: start; padding-top: clamp(10px, 5vh, 64px); }
	.eyebrow {
		margin: 0 0 20px;
		font-size: clamp(.76rem, 1vw, .95rem);
		font-weight: 900;
		letter-spacing: .18em;
		text-transform: uppercase;
	}

	h1 {
		max-width: 8ch;
		margin: 0;
		font: 950 clamp(5rem, 11vw, 11rem)/.78 var(--display);
		letter-spacing: -.055em;
		text-transform: uppercase;
	}

	.login-card {
		position: relative;
		display: grid;
		justify-items: start;
		padding: clamp(32px, 4.5vw, 56px);
		border: 1px solid rgb(255 255 255 / 72%);
		border-radius: clamp(30px, 4vw, 48px);
		outline: 1px solid rgb(255 255 255 / 24%);
		outline-offset: -4px;
		background:
			linear-gradient(145deg, rgb(255 255 255 / 78%), rgb(255 255 255 / 50%)),
			rgb(226 248 252 / 54%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 92%),
			0 24px 64px rgb(37 37 37 / 15%);
		-webkit-backdrop-filter: blur(18px);
		backdrop-filter: blur(18px);
	}

	.lock-icon {
		display: grid;
		width: 82px;
		aspect-ratio: 1;
		margin-bottom: 30px;
		border: 1px solid rgb(255 255 255 / 56%);
		border-radius: 26px;
		outline: 1px solid rgb(255 255 255 / 14%);
		outline-offset: -3px;
		background: rgb(37 37 37 / 90%);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 32%), 0 12px 26px rgb(37 37 37 / 16%);
		color: #c3c8c9;
		place-items: center;
	}

	.lock-icon svg {
		display: block;
		width: 58px;
		height: 58px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 5;
	}
	.lock-icon circle { fill: currentColor; stroke: none; }
	.lock-icon .lock-shackle { stroke-linecap: butt; }

	.card-kicker {
		margin: 0 0 8px;
		font-size: .72rem;
		font-weight: 950;
		letter-spacing: .18em;
		text-transform: uppercase;
	}

	h2 {
		margin: 0;
		font: 950 clamp(2rem, 3.5vw, 3.25rem)/.98 var(--display);
		letter-spacing: -.035em;
		text-transform: uppercase;
	}

	.login-copy > p:last-child {
		max-width: 38ch;
		margin: 18px 0 0;
		font-size: clamp(.96rem, 1.15vw, 1.08rem);
		font-weight: 700;
		line-height: 1.55;
	}

	.login-button {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 26px;
		width: 100%;
		margin-top: 34px;
		padding: 20px 22px 20px 26px;
		border: 1px solid rgb(255 255 255 / 50%);
		border-radius: 20px;
		outline: 1px solid rgb(255 255 255 / 14%);
		outline-offset: -3px;
		background: rgb(37 37 37 / 91%);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 34%), 0 10px 30px rgb(37 37 37 / 17%);
		color: #c3c8c9;
		font: 950 1rem var(--display);
		letter-spacing: .045em;
		text-decoration: none;
		text-transform: uppercase;
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		transition: color 180ms ease, box-shadow 240ms ease, background-color 180ms ease;
	}

	.login-button svg {
		width: 28px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 3.5;
	}

	.login-button:hover,
	.login-button:focus-visible {
		background: rgb(37 37 37 / 96%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 40%),
			0 10px 30px rgb(37 37 37 / 17%),
			0 0 34px rgb(147 233 249 / 88%);
		color: var(--blue);
	}

	.login-button:focus-visible {
		outline: 3px solid var(--black);
		outline-offset: 4px;
	}

	.security-note {
		display: flex;
		align-items: center;
		gap: 9px;
		margin: 18px 0 0;
		color: rgb(37 37 37 / 66%);
		font-size: .75rem;
		font-weight: 900;
		letter-spacing: .08em;
		text-transform: uppercase;
	}
	.security-note > span {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: #55c98b;
		box-shadow: 0 0 10px rgb(85 201 139 / 65%);
	}

	.section-divider {
		--divider-height: clamp(110px, 11vw, 190px);
		position: relative;
		z-index: 20;
		width: 100%;
		height: var(--divider-height);
		margin-block: calc(var(--divider-height) / -2);
		background: var(--black);
		clip-path: polygon(0 28%, 100% 0, 100% 72%, 0 100%);
		pointer-events: none;
	}

	.site-footer {
		position: relative;
		z-index: 1;
		min-height: clamp(310px, 38vh, 480px);
		padding: clamp(150px, 18vw, 240px) clamp(24px, 7vw, 120px) 64px;
		background-color: #383838;
		background-image: radial-gradient(circle, var(--black) 1.5px, transparent 1.6px);
		background-size: 24px 24px;
		color: var(--white);
	}

	.footer-content {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 32px;
		align-items: end;
		width: min(1180px, 100%);
		margin: 0 auto;
	}
	.footer-name {
		margin: 0;
		font: 950 clamp(2rem, 4vw, 4.2rem)/.9 var(--display);
		letter-spacing: -.045em;
		text-transform: uppercase;
	}
	.footer-location {
		justify-self: end;
		margin: 0;
		font-size: .76rem;
		font-weight: 900;
		letter-spacing: .14em;
		text-transform: uppercase;
	}

	@media (max-width: 920px) {
		.login-page { min-height: 900px; }
		.login-hero {
			grid-template-columns: 1fr;
			gap: 52px;
			align-content: center;
		}
		.heading-block { padding-top: 0; text-align: center; }
		h1 { max-width: none; font-size: clamp(4.7rem, 17vw, 9rem); }
		.login-card { width: min(560px, 100%); margin: 0 auto; }
		.blue-panel { top: 34%; left: 9%; width: 64%; }
	}

	@media (max-width: 600px) {
		.login-page {
			min-height: 820px;
			padding: 126px 21px 96px;
		}
		.login-hero { gap: 40px; }
		.eyebrow { margin-bottom: 14px; }
		h1 { font-size: clamp(3.8rem, 18vw, 6.4rem); line-height: .83; }
		.login-card { padding: 30px 24px; border-radius: 30px; }
		.lock-icon { width: 70px; margin-bottom: 24px; border-radius: 22px; }
		.lock-icon svg { width: 49px; height: 49px; }
		.login-button { padding: 18px 19px 18px 22px; }
		.blue-panel { top: 30%; right: 14px; left: 14px; width: auto; }
		.section-divider { --divider-height: 108px; }
		.site-footer { min-height: 380px; padding: 138px 24px 54px; }
		.footer-content { grid-template-columns: 1fr; gap: 28px; align-items: start; }
		.footer-location { justify-self: start; }
	}

	@media (prefers-reduced-motion: reduce) {
		.login-button { transition: none; }
	}
</style>
