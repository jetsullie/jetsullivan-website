---
import SiteMenu from "../components/common/SiteMenu.astro";
const pageTitle = "Brainstorm — Jet Sullivan";
---
<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="robots" content="noindex, nofollow, noarchive" />
	<link rel="icon" type="image/png" href="/brand-center-favicon.png" />
	<title>{pageTitle}</title>
</head>
<body>
	<SiteMenu showHomeButton brainstormActions />
	<main class="brainstorm-app">
		<h1>Brainstorm</h1>
		<output id="save-confirmation" class="save-confirmation" role="status" aria-live="polite">Brainstorm saved privately to your browser.</output>
		<div id="settings-backdrop" class="settings-backdrop" hidden>
			<section class="settings-panel" role="dialog" aria-modal="true" aria-labelledby="settings-title">
				<div class="settings-heading"><h2 id="settings-title">Settings</h2><button id="close-settings" type="button" aria-label="Close settings">×</button></div>
				<label class="setting-row"><span><strong>Dark mode</strong><small>Use a calm charcoal workspace.</small></span><input id="setting-dark" type="checkbox" role="switch" /></label>
				<label class="setting-row"><span><strong>Floating effects</strong><small>Let bubbles drift gently in place.</small></span><input id="setting-floating" type="checkbox" role="switch" checked /></label>
				<label class="setting-row"><span><strong>Bubble physics</strong><small>Enable collision, magnetic push, and tether movement.</small></span><input id="setting-physics" type="checkbox" role="switch" checked /></label>
				<label class="setting-row"><span><strong>Off-screen indicators</strong><small>Point toward thoughts outside the current view.</small></span><input id="setting-indicators" type="checkbox" role="switch" checked /></label>
				<label class="setting-row"><span><strong>Minimap</strong><small>Show your position on the full canvas.</small></span><input id="setting-minimap" type="checkbox" role="switch" checked /></label>
				<fieldset class="shortcut-settings">
					<legend>Keyboard shortcuts</legend>
					<p>Click a field, then press a letter or number. Duplicate shortcuts swap places.</p>
					<label class="shortcut-row" for="shortcut-hand"><span><strong>Hand tool</strong><small>Move bubbles and pan the canvas.</small></span><input id="shortcut-hand" type="text" value="H" maxlength="1" autocomplete="off" aria-label="Hand tool shortcut" /></label>
					<label class="shortcut-row" for="shortcut-link"><span><strong>Link tool</strong><small>Connect one bubble to another.</small></span><input id="shortcut-link" type="text" value="L" maxlength="1" autocomplete="off" aria-label="Link tool shortcut" /></label>
					<label class="shortcut-row" for="shortcut-new"><span><strong>New bubble</strong><small>Create a bubble in the center of the view.</small></span><input id="shortcut-new" type="text" value="N" maxlength="1" autocomplete="off" aria-label="New bubble shortcut" /></label>
					<small id="shortcut-status" class="shortcut-status" role="status" aria-live="polite"></small>
				</fieldset>
			</section>
		</div>
		<button id="tutorial-launch" class="tutorial-launch" type="button" aria-label="Start tutorial"><svg viewBox="0 0 28 28" aria-hidden="true"><circle cx="14" cy="14" r="11"/><path d="M14 13v7"/><circle cx="14" cy="8.5" r="1.5" class="info-dot"/></svg><small>Tutorial</small></button>
		<div id="tutorial-layer" class="tutorial-layer" hidden>
			<div class="tutorial-dimmers" aria-hidden="true"><i data-dimmer="top"></i><i data-dimmer="left"></i><i data-dimmer="right"></i><i data-dimmer="bottom"></i><span id="tutorial-spotlight"></span></div>
			<section id="tutorial-card" class="tutorial-card" role="dialog" aria-modal="false" aria-label="Brainstorm tutorial" aria-describedby="tutorial-copy">
				<p id="tutorial-copy"></p>
			</section>
			<button id="tutorial-skip" class="tutorial-skip" type="button">Skip</button>
		</div>
	<div class="board-stats" aria-live="polite"><div class="stat-line"><span><strong id="node-count">0</strong> bubbles</span><i aria-hidden="true"></i><span><strong id="link-count">0</strong> links</span></div><div class="zoom-controls" aria-label="Canvas zoom"><button id="reset-view" type="button" aria-label="Reset canvas view"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 8a8 8 0 1 0 1 7M19 4v4h-4"/></svg><small>Reset View</small></button><button id="zoom-out" type="button" aria-label="Zoom out"><span aria-hidden="true">−</span><small>Shrink</small></button><output id="zoom-value">100%</output><button id="zoom-in" type="button" aria-label="Zoom in"><span aria-hidden="true">+</span><small>Grow</small></button></div></div>
		<div id="offscreen-indicators" class="offscreen-indicators" aria-hidden="true"></div>
		<aside class="minimap" aria-label="Canvas minimap"><div id="minimap-dots" class="minimap-dots"></div><div id="minimap-view" class="minimap-view"></div></aside>
		<section id="board" class="board" aria-label="Connected thought board"><div id="canvas-boundary" class="canvas-boundary" aria-hidden="true"></div><svg id="connections" class="connections" aria-hidden="true"></svg><div id="nodes" class="nodes"></div><div id="empty-state" class="empty-state"><small>Open the tool dock to add a thought bubble.</small></div></section>
		<section id="tool-dock" class="tool-dock is-open" aria-label="Brainstorm tools">
			<button id="dock-toggle" class="dock-toggle" type="button" aria-expanded="true" aria-controls="tool-surface" aria-label="Close brainstorm tools"><span></span></button>
			<div id="tool-surface" class="tool-surface" aria-hidden="false">
				<div id="text-panel" class="editor-panel text-panel" hidden><label for="font-size">Size</label><select id="font-size"><option value="12">Small</option><option value="16" selected>Medium</option><option value="21">Large</option><option value="28">Huge</option></select><label for="text-color">Color</label><input id="text-color" type="color" value="#252525" /><button data-format="bold" type="button" aria-label="Bold"><strong>B</strong></button><button data-format="italic" type="button" aria-label="Italic"><em>I</em></button><button data-format="underline" type="button" aria-label="Underline"><u>U</u></button></div>
				<div id="color-panel" class="editor-panel color-picker-panel" hidden><label for="bubble-color">Color</label><input id="bubble-color" type="color" value="#ffffff" /><output id="color-value">#FFFFFF</output><span class="panel-divider"></span><label for="bubble-glow-color">Glow</label><input id="bubble-glow-color" type="color" value="#93e9f9" /><label for="bubble-glow-strength">Amount</label><input id="bubble-glow-strength" type="range" min="0" max="100" value="0" /><span hidden><output id="rgb-value"></output><input id="red" value="255" /><input id="green" value="255" /><input id="blue" value="255" /></span></div>
				<div id="connection-panel" class="editor-panel connection-panel" hidden><label for="link-length">Length</label><select id="link-length"><option value="small">Small</option><option value="medium" selected>Medium</option><option value="long">Long</option></select><label for="link-style">Line</label><select id="link-style"><option value="solid">Solid</option><option value="dotted">Dotted</option><option value="squiggle">Squiggle</option></select><label for="link-color">Color</label><input id="link-color" type="color" value="#252525" /><label for="link-glow-color">Glow</label><input id="link-glow-color" type="color" value="#93e9f9" /><label for="link-glow-strength">Amount</label><input id="link-glow-strength" type="range" min="0" max="100" value="0" /></div>
				<div id="shape-panel" class="shape-panel" hidden aria-label="Bubble shape"><button type="button" data-shape="rectangle" aria-label="Rounded rectangle"><span class="shape-swatch rectangle"></span></button><button type="button" data-shape="oval" aria-label="Oval"><span class="shape-swatch oval"></span></button><button type="button" data-shape="circle" aria-label="Circle"><span class="shape-swatch circle"></span></button><button type="button" data-shape="triangle" aria-label="Triangle"><span class="shape-swatch triangle"></span></button><button type="button" data-shape="star" aria-label="Star"><span class="shape-swatch star"></span></button></div>
				<div class="tool-row">
					<button id="hand-tool" class="tool-button is-active" type="button" aria-pressed="true" title="Move bubbles (H)" aria-keyshortcuts="H"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 11V6a1.5 1.5 0 0 1 3 0v4-6a1.5 1.5 0 0 1 3 0v6-5a1.5 1.5 0 0 1 3 0v6-3a1.5 1.5 0 0 1 3 0v6c0 4-3 7-7 7h-1c-2 0-3.5-.8-4.8-2.4L3.5 14a1.6 1.6 0 0 1 2.4-2.1L8 14"/></svg><small>Hand</small></button>
					<button id="add-node" class="tool-button" type="button" title="Add bubble (N)" aria-keyshortcuts="N"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><small>Add</small></button>
					<button id="connect-mode" class="tool-button" type="button" aria-pressed="false" title="Connect bubbles (L)" aria-keyshortcuts="L"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="17" r="3"/><circle cx="18" cy="7" r="3"/><path d="m8.5 15 7-6"/></svg><small>Link</small></button><span class="tool-divider"></span>
					<button id="text-tool" class="tool-button" type="button" title="Adjust bubble text formatting"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 6h7M12 6v13M8.5 19h7"/></svg><small>Text</small></button>
					<button id="color-tool" class="tool-button" type="button" title="Edit bubble color"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18 3 3 0 0 0 2.2-5c-1-1 .2-2 1.4-2H18a3 3 0 0 0 3-3c0-4.4-4-8-9-8Z"/><circle cx="7.5" cy="11" r=".7"/><circle cx="10" cy="7" r=".7"/><circle cx="15" cy="7.5" r=".7"/></svg><small>Color</small></button><button id="shape-tool" class="tool-button" type="button" title="Change bubble shape" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="12" rx="3"/></svg><small>Shape</small></button><span class="tool-divider"></span><button id="undo-action" class="tool-button" type="button" title="Undo (Cmd/Ctrl+Z)" aria-keyshortcuts="Meta+Z Control+Z"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 7-5 5 5 5M5 12h8a6 6 0 0 1 6 6"/></svg><small>Undo</small></button><button id="redo-action" class="tool-button" type="button" title="Redo (Cmd/Ctrl+Shift+Z)" aria-keyshortcuts="Meta+Shift+Z Control+Shift+Z"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 7 5 5-5 5m4-5h-8a6 6 0 0 0-6 6"/></svg><small>Redo</small></button><span class="tool-divider"></span><button id="delete-node" class="tool-button" type="button" title="Delete selected bubble (Delete/Backspace)" aria-keyshortcuts="Delete Backspace"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M9 7V4h6v3m2 0-1 13H8L7 7"/></svg><small>Delete</small></button><button id="clear-board" class="tool-button" type="button" title="Clear board"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 15 7-9 9 7-7 8H8l-4-3Z"/></svg><small>Clear</small></button><p id="board-status" role="status">Click a bubble to edit its text.</p>
				</div>
			</div>
		</section>
	</main>
</body>
</html>
<script>
	type BubbleShape = "rectangle" | "oval" | "circle" | "triangle" | "star";
	type Idea = { id: string; text: string; color: string; textColor?: string; glowColor?: string; glowStrength?: number; shape?: BubbleShape; x: number; y: number; anchorX?: number; anchorY?: number; vx: number; vy: number; momentumUntil?: number; fontSize?: number; bold?: boolean; italic?: boolean; underline?: boolean };
	type LinkLength = "small" | "medium" | "long"; type LinkStyle = "solid" | "dotted" | "squiggle";
	type Link = { from: string; to: string; length?: LinkLength; extraLength?: number; style?: LinkStyle; color?: string; glowColor?: string; glowStrength?: number };
	const board = document.querySelector<HTMLElement>("#board")!; const nodes = document.querySelector<HTMLElement>("#nodes")!; const connections = document.querySelector<SVGSVGElement>("#connections")!; const emptyState = document.querySelector<HTMLElement>("#empty-state")!; const status = document.querySelector<HTMLElement>("#board-status")!; const storageKey = "jet-brainstorm-board";
	type ShortcutAction = "hand" | "link" | "new";
	type ShortcutSettings = Record<ShortcutAction, string>;
	type ToggleSetting = "dark" | "floating" | "physics" | "indicators" | "minimap";
	type WorkspaceSettings = Record<ToggleSetting, boolean> & { shortcuts: ShortcutSettings };
	const settingsKey = "jet-brainstorm-settings";
	const defaultShortcuts: ShortcutSettings = { hand: "H", link: "L", new: "N" };
	let settings: WorkspaceSettings = { dark: false, floating: true, physics: true, indicators: true, minimap: true, shortcuts: { ...defaultShortcuts } };
	try { const storedSettings = JSON.parse(localStorage.getItem(settingsKey) || "{}"); settings = { ...settings, ...storedSettings, shortcuts: { ...defaultShortcuts, ...(storedSettings.shortcuts || {}) } }; } catch { localStorage.removeItem(settingsKey); }
	const applySettings = () => { document.body.classList.toggle("dark-mode", settings.dark); document.body.classList.toggle("no-floating", !settings.floating); document.body.classList.toggle("no-indicators", !settings.indicators); document.body.classList.toggle("no-minimap", !settings.minimap); };
	applySettings();
	let ideas: Idea[] = []; let links: Link[] = []; let selectedId: string | null = null; let editingId: string | null = null; let connectFrom: string | null = null; let linkMode = false; let dragging: { id: string; offsetX: number; offsetY: number; startX: number; startY: number; lastX: number; lastY: number; lastTime: number; moved: boolean } | null = null; let panning: { startX: number; startY: number; cameraX: number; cameraY: number; moved: boolean; resumeLink: boolean } | null = null; let handMode = true; let spawningId: string | null = null; const jiggleIds = new Set<string>(); const camera = { x: 0, y: 0, scale: 1 }; const world = { width: 4800, height: 3200 }; let suppressBoardClick = false; let suppressBubbleClickUntil = 0; let lastNavigationRender = 0;
	const creationDefaults: Idea = { id: "__defaults__", text: "New thought", color: "#FFFFFF", textColor: "#252525", glowColor: "#93E9F9", glowStrength: 0, shape: "rectangle", x: 0, y: 0, vx: 0, vy: 0, momentumUntil: 0, fontSize: 16, bold: false, italic: false, underline: false };
	const linkDefaults: Required<Omit<Link, "from" | "to">> = { length: "medium", extraLength: 0, style: "solid", color: "#252525", glowColor: "#93E9F9", glowStrength: 0 };
	let undoStack: string[] = []; let redoStack: string[] = []; let currentSnapshot = "";
	const radius = () => innerWidth < 600 ? 66 : 86; const getIdea = (id: string) => ideas.find((idea) => idea.id === id); const takeSnapshot = () => JSON.stringify({ ideas, links, defaults: creationDefaults, linkDefaults }); const save = () => { const nextSnapshot = takeSnapshot(); if (currentSnapshot && nextSnapshot !== currentSnapshot) undoStack.push(currentSnapshot); if (undoStack.length > 100) undoStack.shift(); currentSnapshot = nextSnapshot; redoStack = []; localStorage.setItem(storageKey, nextSnapshot); updateHistoryButtons(); }; const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value)); const announce = (message: string) => { status.textContent = message; };
	const getEditingTarget = () => selectedId ? getIdea(selectedId) || creationDefaults : creationDefaults;
	const unresolvedLinkSince = new Map<string, number>(); const expandingLinkKeys = new Set<string>(); const linkKey = (link: Link) => [link.from, link.to].sort().join("::");
	const segmentsCross = (a: Idea, b: Idea, c: Idea, d: Idea) => { const side = (p: Idea, q: Idea, r: Idea) => (q.x - p.x) * (r.y - p.y) - (q.y - p.y) * (r.x - p.x); const abC = side(a, b, c); const abD = side(a, b, d); const cdA = side(c, d, a); const cdB = side(c, d, b); return abC * abD < 0 && cdA * cdB < 0; };
	const countLinkCrossings = () => { let total = 0; for (let first = 0; first < links.length; first += 1) for (let second = first + 1; second < links.length; second += 1) { const one = links[first]; const two = links[second]; if (one.from === two.from || one.from === two.to || one.to === two.from || one.to === two.to) continue; const a = getIdea(one.from); const b = getIdea(one.to); const c = getIdea(two.from); const d = getIdea(two.to); if (a && b && c && d && segmentsCross(a, b, c, d)) total += 1; } return total; };
	let lastUntangleAt = 0;
	const optimizeConnectionLayout = (draggedId?: string) => { const baseline = countLinkCrossings(); if (!baseline) return false; const involved = new Set<string>(); for (let first = 0; first < links.length; first += 1) for (let second = first + 1; second < links.length; second += 1) { const one = links[first]; const two = links[second]; if (one.from === two.from || one.from === two.to || one.to === two.from || one.to === two.to) continue; const a = getIdea(one.from); const b = getIdea(one.to); const c = getIdea(two.from); const d = getIdea(two.to); if (a && b && c && d && segmentsCross(a, b, c, d)) [one.from, one.to, two.from, two.to].forEach((id) => involved.add(id)); } let best: { idea: Idea; x: number; y: number; score: number } | null = null; const directions = [[1,0],[.707,.707],[0,1],[-.707,.707],[-1,0],[-.707,-.707],[0,-1],[.707,-.707]]; const step = 44; for (const id of involved) { const idea = getIdea(id); if (!idea || idea.id === draggedId) continue; const originalX = idea.x; const originalY = idea.y; const metrics = getMetrics(idea); for (const [dx,dy] of directions) { idea.x = clamp(originalX + dx * step, metrics.halfWidth, world.width - metrics.halfWidth); idea.y = clamp(originalY + dy * step, metrics.halfHeight, world.height - metrics.halfHeight); const score = countLinkCrossings(); if (score < (best?.score ?? baseline)) best = { idea, x: idea.x, y: idea.y, score }; } idea.x = originalX; idea.y = originalY; } if (best) { best.idea.x = best.x; best.idea.y = best.y; best.idea.anchorX = best.x; best.idea.anchorY = best.y; return true; } const candidates = Array.from(involved, (id) => getIdea(id)).filter((idea): idea is Idea => Boolean(idea) && idea!.id !== draggedId); for (let first = 0; first < candidates.length; first += 1) for (let second = first + 1; second < candidates.length; second += 1) { const a = candidates[first]; const b = candidates[second]; const ax = a.x; const ay = a.y; const bx = b.x; const by = b.y; a.x = bx; a.y = by; b.x = ax; b.y = ay; const score = countLinkCrossings(); a.x = ax; a.y = ay; b.x = bx; b.y = by; if (score < baseline) { a.x = bx; a.y = by; b.x = ax; b.y = ay; a.anchorX = a.x; a.anchorY = a.y; b.anchorX = b.x; b.anchorY = b.y; return true; } } return false; };
	const getMetrics = (idea: Idea) => { const fontSize = idea.fontSize || 16; const shape = idea.shape || "rectangle"; const base = shape === "circle" ? [132,132] : shape === "triangle" ? [154,138] : shape === "star" ? [152,148] : [176,120]; let width = base[0]; const words = (idea.text || "Untitled thought").trim().split(/\s+/); const measure = (text: string) => text.length * fontSize * .58; width = Math.max(width, Math.min(360, Math.max(...words.map(measure)) + 42)); const countLines = () => { const available = Math.max(60, width - 38); let lines = 1; let lineWidth = 0; for (const word of words) { const wordWidth = measure(word); if (lineWidth && lineWidth + fontSize * .35 + wordWidth > available) { lines += 1; lineWidth = wordWidth; } else lineWidth += (lineWidth ? fontSize * .35 : 0) + wordWidth; } return lines; }; let lines = countLines(); while (lines > 5 && width < 360) { width = Math.min(360, width + 28); lines = countLines(); } let height = Math.max(base[1], lines * fontSize * 1.18 + 52); if (shape === "triangle" || shape === "star") { width = Math.max(width, height * 1.08); height *= 1.12; } if (shape === "circle") { const diameter = Math.max(width, height); width = diameter; height = diameter; } return { width, height, halfWidth: width / 2, halfHeight: height / 2 }; };
	const polygonBoundary = (vertices: Array<[number, number]>, nx: number, ny: number) => { let nearest = Infinity; const cross = (ax: number, ay: number, bx: number, by: number) => ax * by - ay * bx; for (let index = 0; index < vertices.length; index += 1) { const [x1,y1] = vertices[index]; const [x2,y2] = vertices[(index + 1) % vertices.length]; const sx = x2 - x1; const sy = y2 - y1; const denominator = cross(nx, ny, sx, sy); if (Math.abs(denominator) < .0001) continue; const distance = cross(x1, y1, sx, sy) / denominator; const segment = cross(x1, y1, nx, ny) / denominator; if (distance >= 0 && segment >= 0 && segment <= 1) nearest = Math.min(nearest, distance); } return Number.isFinite(nearest) ? nearest : 0; };
	const boundaryRadius = (idea: Idea, nx: number, ny: number) => { const metrics = getMetrics(idea); const shape = idea.shape || "rectangle"; if (shape === "circle" || shape === "oval") return 1 / Math.sqrt((nx / metrics.halfWidth) ** 2 + (ny / metrics.halfHeight) ** 2); if (shape === "rectangle") return Math.min(metrics.halfWidth / Math.max(Math.abs(nx), .0001), metrics.halfHeight / Math.max(Math.abs(ny), .0001)); const normalized = shape === "triangle" ? [[0,-1],[1,1],[-1,1]] as Array<[number,number]> : [[0,-1],[.23,-.36],[.92,-.36],[.38,.05],[.57,.89],[0,.47],[-.57,.89],[-.38,.05],[-.92,-.36],[-.23,-.36]] as Array<[number,number]>; return polygonBoundary(normalized.map(([x,y]) => [x * metrics.halfWidth, y * metrics.halfHeight]), nx, ny); };
	const constrainCamera = () => { const scaledWidth = world.width * camera.scale; const scaledHeight = world.height * camera.scale; camera.x = scaledWidth <= innerWidth ? (innerWidth - scaledWidth) / 2 : clamp(camera.x, innerWidth - scaledWidth, 0); camera.y = scaledHeight <= innerHeight ? (innerHeight - scaledHeight) / 2 : clamp(camera.y, innerHeight - scaledHeight, 0); };
	const centerCamera = () => { camera.scale = 1; camera.x = (innerWidth - world.width) / 2; camera.y = (innerHeight - world.height) / 2; };
	const applyCamera = () => { constrainCamera(); const transform = `translate(${camera.x}px, ${camera.y}px) scale(${camera.scale})`; nodes.style.transform = transform; connections.style.transform = transform; const boundary = document.querySelector<HTMLElement>("#canvas-boundary")!; boundary.style.transform = transform; [nodes, connections, boundary].forEach((layer) => { layer.style.width = `${world.width}px`; layer.style.height = `${world.height}px`; }); board.style.setProperty("--grid-scale", String(camera.scale)); board.style.setProperty("--grid-x", `${camera.x}px`); board.style.setProperty("--grid-y", `${camera.y}px`); (document.querySelector("#zoom-value") as HTMLOutputElement).value = `${Math.round(camera.scale * 100)}%`; renderNavigation(true); };
