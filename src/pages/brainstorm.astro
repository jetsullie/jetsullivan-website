	const renderLinks = () => { connections.replaceChildren(); connections.setAttribute("viewBox", "0 0 " + world.width + " " + world.height); for (const link of links) { const from = getIdea(link.from); const to = getIdea(link.to); if (!from || !to) continue; const style = link.style || "solid"; const element = document.createElementNS("http://www.w3.org/2000/svg", style === "squiggle" ? "path" : "line"); if (style === "squiggle") { const dx = to.x - from.x; const dy = to.y - from.y; const distance = Math.hypot(dx, dy) || 1; const px = -dy / distance * 14; const py = dx / distance * 14; element.setAttribute("d", `M${from.x} ${from.y} C${from.x + dx * .25 + px} ${from.y + dy * .25 + py},${from.x + dx * .4 - px} ${from.y + dy * .4 - py},${from.x + dx * .5} ${from.y + dy * .5} S${from.x + dx * .75 + px} ${from.y + dy * .75 + py},${to.x} ${to.y}`); } else { element.setAttribute("x1", String(from.x)); element.setAttribute("y1", String(from.y)); element.setAttribute("x2", String(to.x)); element.setAttribute("y2", String(to.y)); } element.classList.add("link-" + style); element.style.stroke = link.color || "#252525"; const glow = link.glowStrength || 0; if (glow) element.style.filter = `drop-shadow(0 0 ${2 + glow * .12}px ${link.glowColor || "#93E9F9"})`; connections.append(element); } };
