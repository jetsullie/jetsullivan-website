---
import SiteMenu from "../components/common/SiteMenu.astro";
import PageMotion from "../components/common/PageMotion.astro";

const pageTitle = "About Jet Sullivan";

const backgroundWindows = [
	{ x: 2, y: 16, w: 38, h: 31, symbol: "+", font: 8 },
	{ x: 8, y: 42, w: 44, h: 35, symbol: "○", font: 7 },
	{ x: 14, y: 8, w: 50, h: 39, symbol: "✦", font: 9 },
	{ x: 19, y: 72, w: 56, h: 42, symbol: "×", font: 10 },
	{ x: 25, y: 25, w: 62, h: 47, symbol: "◇", font: 8 },
	{ x: 31, y: 84, w: 68, h: 50, symbol: "≈", font: 11 },
	{ x: 37, y: 13, w: 74, h: 54, symbol: "▶", font: 9 },
	{ x: 43, y: 61, w: 80, h: 58, symbol: "⌁", font: 12 },
	{ x: 49, y: 34, w: 86, h: 61, symbol: "●", font: 7 },
	{ x: 55, y: 79, w: 92, h: 65, symbol: "↗", font: 11 },
	{ x: 61, y: 7, w: 98, h: 69, symbol: "□", font: 10 },
	{ x: 67, y: 48, w: 104, h: 73, symbol: "∞", font: 12 },
	{ x: 73, y: 86, w: 110, h: 77, symbol: "△", font: 9 },
	{ x: 79, y: 19, w: 46, h: 34, symbol: "•", font: 6 },
	{ x: 85, y: 57, w: 58, h: 43, symbol: "≡", font: 8 },
	{ x: 91, y: 31, w: 70, h: 51, symbol: "⌘", font: 10 },
	{ x: 4, y: 89, w: 82, h: 59, symbol: "◌", font: 12 },
	{ x: 21, y: 53, w: 94, h: 67, symbol: "✣", font: 11 },
	{ x: 70, y: 27, w: 106, h: 75, symbol: "↻", font: 12 },
	{ x: 88, y: 76, w: 118, h: 82, symbol: "⌂", font: 10 },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Learn more about Austin filmmaker and storyteller Jet Sullivan."
		/>
		<link rel="icon" type="image/png" href="/favicon-profile.png" />
		<title>{pageTitle}</title>
	</head>

	<body>
		<main class="about-page" data-motion-root>
			<div class="top-frame" data-motion-depth="counter" aria-hidden="true"></div>
			<div class="yellow-panel" data-motion-depth="counter" aria-hidden="true"></div>

			<div class="background-windows" data-motion-bounds>
				{
					backgroundWindows.map((item) => (
						<span
							class="mini-window"
							data-motion-float
							aria-hidden="true"
							style={`--x:${item.x}%; --y:${item.y}%; --w:${item.w}px; --h:${item.h}px; --symbol-size:${item.font}px;`}
						>
							<span class="mini-dots"><i></i><i></i><i></i></span>
							<span class="mini-symbol">{item.symbol}</span>
						</span>
					))
				}
				<span
					id="cake-easter-egg"
					class="mini-window interactive-window cake-window"
					data-motion-float
					aria-hidden="true"
				>
					<span class="mini-dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="cake-symbol" aria-hidden="true">🎂</span>
				</span>
				<span
					id="hookem-easter-egg"
					class="mini-window interactive-window hookem-window"
					data-motion-float
					aria-hidden="true"
				>
					<span class="mini-dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="interactive-symbol" aria-hidden="true">🤘</span>
				</span>
			</div>
			<a
				class="cake-hitbox"
				data-motion-follow="cake-easter-egg"
				href="https://www.youtube.com/@SpecialDessert"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Visit Special Dessert on YouTube"
			></a>
			<a
				class="hookem-hitbox"
				data-motion-follow="hookem-easter-egg"
				href="https://www.youtube.com/@HookeEmHangouts"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Visit Hook 'Em Hangouts on YouTube"
			></a>

			<SiteMenu showHomeButton />

			<section class="about-content" data-motion-depth="scene" aria-labelledby="about-heading">
				<p class="eyebrow">Filmmaker · Actor · Storyteller</p>
				<h1 id="about-heading">About Me</h1>

				<div class="story-window">
					<div id="about-biography" class="story-copy biography-content">
						<p>
							I am a Moody Honors student at The University of Texas, majoring
							in Radio-Television-Film. I am an actor, video editor,
							videographer, photographer, and director. I've worked on
							large-scale productions to smaller, independent projects. I
							discovered my passion for filmmaking through YouTube at the age
							of 11, and have since dedicated myself to honing my craft,
							ultimately guiding me to UT Austin to further follow my love for
							storytelling and the art of filmmaking.
						</p>
					</div>
				</div>
			</section>
		</main>

		<div class="section-divider footer-divider" aria-hidden="true"></div>

		<footer class="site-footer">
			<div class="footer-content">
				<p class="footer-name">Jet Sullivan</p>
				<span aria-hidden="true"></span>
				<p class="footer-location">Austin, Texas</p>
			</div>
		</footer>

		<PageMotion />
	</body>
</html>

<script>
	import {
		biographyDocumentFromText,
		biographyDocumentToText,
		normalizeBiographyDocument,
		renderBiographyDocument,
	} from "../lib/biography";

	const biographyElement = document.querySelector<HTMLElement>("#about-biography");

	if (biographyElement) {
		fetch("/api/content/about")
			.then((response) => (response.ok ? response.json() : null))
			.then((result) => {
				const biography = result?.content?.biography;
				const richDocument = normalizeBiographyDocument(
					result?.content?.biographyDocument,
				);
				if (richDocument && biographyDocumentToText(richDocument)) {
					renderBiographyDocument(biographyElement, richDocument, {
						linksOpenInNewTab: true,
					});
				} else if (typeof biography === "string" && biography.trim()) {
					renderBiographyDocument(
						biographyElement,
						biographyDocumentFromText(biography),
						{ linksOpenInNewTab: true },
					);
				}
			})
			.catch(() => {
				// Keep the built-in biography when Cloudflare storage is unavailable.
			});
	}

	const floatingWindows = Array.from(
		document.querySelectorAll<HTMLElement>("[data-motion-float]"),
	);
	const randomEmojiWindows = floatingWindows.filter(
		(windowTab) => !windowTab.classList.contains("interactive-window"),
	);

	if (randomEmojiWindows.length >= 4) {
		const emojiPool = ["💛", "💖", "💕", "❤️", "😊", "😄", "🙂", "🥰", "😁", "☺️"];
		const shuffledWindows = [...randomEmojiWindows].sort(() => Math.random() - 0.5);
		const shuffledEmoji = [...emojiPool].sort(() => Math.random() - 0.5);

		shuffledWindows.slice(0, 4).forEach((windowTab, index) => {
			const symbol = windowTab.querySelector<HTMLElement>(".mini-symbol");
			if (!symbol) return;
			symbol.textContent = shuffledEmoji[index];
			symbol.style.fontSize = "12px";
		});
	}

</script>

<style>
	:root {
		--yellow: #efda4a;
		--yellow-dark: #cc9504;
		--white: #ffffff;
		--black: #252525;
		--blue: #93e9f9;
		--pink: #fdbfbf;
		--mint: #7cf5b5;
		--font-body: "Myriad Pro", Myriad, Arial, sans-serif;
		--font-display: "Arial Black", "Myriad Pro", Arial, sans-serif;
		--about-footer-gap: clamp(36px, 4vh, 52px);
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		background: var(--black);
		color: var(--black);
		font-family: var(--font-body);
	}

	:global(body) {
		margin: 0;
		min-width: 320px;
		min-height: 100vh;
	}

	.about-page {
		position: relative;
		width: 100%;
		padding: clamp(105px, 11vh, 145px) clamp(28px, 6vw, 105px)
			var(--about-footer-gap);
		overflow: hidden;
		background: linear-gradient(
			180deg,
			var(--white) 0%,
			#fff4f6 32%,
			#fbd9df 68%,
			var(--pink) 100%
		);
	}

	.top-frame {
		position: absolute;
		z-index: 8;
		left: -3%;
		width: 106%;
		height: 9vw;
		min-height: 54px;
		background: var(--black);
		pointer-events: none;
	}

	.top-frame {
		top: -5vw;
		transform: rotate(-3deg);
	}

	.yellow-panel {
		position: absolute;
		z-index: 1;
		top: 23%;
		bottom: -3%;
		left: 50%;
		width: min(76vw, 1050px);
		border: 1px solid rgb(255 255 255 / 58%);
		border-radius: 24px;
		outline: 1px solid rgb(255 255 255 / 16%);
		outline-offset: -3px;
		background: rgb(255 235 239 / 68%);
		box-shadow: 0 8px 28px rgb(37 37 37 / 14%);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		transform: translateX(-50%);
	}

	.background-windows {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.mini-window {
		position: absolute;
		top: var(--y);
		left: var(--x);
		display: grid;
		width: var(--w);
		height: var(--h);
		border: 1px solid rgb(255 255 255 / 45%);
		border-radius: clamp(5px, 0.7vw, 14px);
		background: rgb(156 166 170 / 20%);
		color: rgb(37 37 37 / 25%);
		font: 900 var(--symbol-size) var(--font-display);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 34%),
			0 5px 14px rgb(37 37 37 / 5%);
		-webkit-backdrop-filter: blur(3px);
		backdrop-filter: blur(3px);
		place-items: center;
	}

	.mini-symbol {
		padding-top: 6px;
		line-height: 1;
	}

	.interactive-window {
		z-index: 31;
		top: 24%;
		right: 3%;
		left: auto;
		width: 36px;
		height: 32px;
		border-radius: 6px;
		color: inherit;
		font-size: 14px;
		pointer-events: auto;
		text-decoration: none;
		transition: background-color 200ms ease;
	}

	.hookem-window {
		z-index: 0;
		top: 64%;
		right: 8%;
		pointer-events: none;
	}

	.cake-window {
		z-index: 0;
		pointer-events: none;
	}

	.cake-hitbox,
	.hookem-hitbox {
		--motion-follow-x: -10px;
		--motion-follow-y: -10px;
		position: absolute;
		z-index: 31;
		width: 56px;
		height: 52px;
		border-radius: 12px;
	}

	.cake-hitbox {
		top: calc(24% - 10px);
		right: calc(3% - 10px);
	}

	.hookem-hitbox {
		top: calc(64% - 10px);
		right: calc(8% - 10px);
	}

	.cake-hitbox:focus-visible,
	.hookem-hitbox:focus-visible {
		outline: 3px solid var(--pink);
		outline-offset: 3px;
	}

	.interactive-window .mini-dots {
		top: 4px;
		left: 4px;
		gap: 2px;
	}

	.interactive-window .mini-dots i {
		width: 2px;
		height: 2px;
	}

	.about-page:has(.cake-hitbox:hover) .cake-window,
	.about-page:has(.cake-hitbox:focus-visible) .cake-window {
		background: rgb(76 220 140 / 48%);
	}

	.about-page:has(.hookem-hitbox:hover) .hookem-window,
	.about-page:has(.hookem-hitbox:focus-visible) .hookem-window {
		background: rgb(255 140 40 / 48%);
	}

	.interactive-window:focus-visible {
		outline: 3px solid var(--pink);
		outline-offset: 4px;
	}

	.cake-symbol,
	.interactive-symbol {
		padding-top: 5px;
	}

	.mini-dots,
	.window-dots {
		display: flex;
		gap: 6px;
	}

	.mini-dots {
		position: absolute;
		top: 7px;
		left: 8px;
		gap: 3px;
	}

	.mini-dots i,
	.window-dots i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--pink);
	}

	.mini-dots i {
		width: 4px;
		height: 4px;
	}

	.mini-dots i:nth-child(2),
	.window-dots i:nth-child(2) {
		background: var(--yellow);
	}

	.mini-dots i:nth-child(3),
	.window-dots i:nth-child(3) {
		background: var(--mint);
	}

	.window-dots i {
		border: 1px solid rgb(37 37 37 / 18%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 48%),
			0 1px 3px rgb(37 37 37 / 32%);
	}

	.home-window {
		position: absolute;
		z-index: 12;
		top: clamp(70px, 8vh, 105px);
		right: auto;
		left: clamp(28px, 5vw, 82px);
		display: grid;
		grid-template-columns: auto 1fr;
		grid-template-rows: auto 1fr;
		gap: 8px 12px;
		width: clamp(175px, 13vw, 220px);
		height: clamp(88px, 7vw, 112px);
		padding: 17px;
		border: 1px solid rgb(255 255 255 / 52%);
		border-radius: 28px;
		outline: 1px solid rgb(255 255 255 / 14%);
		outline-offset: -3px;
		background:
			linear-gradient(rgb(255 255 255 / 5%), rgb(255 255 255 / 1%)),
			rgb(37 37 37 / 82%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 48%),
			0 14px 34px rgb(37 37 37 / 12%);
		color: var(--white);
		font: 900 clamp(0.9rem, 1.2vw, 1.2rem) var(--font-display);
		text-decoration: none;
		text-transform: uppercase;
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		transition:
			transform 350ms cubic-bezier(0.34, 1.56, 0.64, 1),
			background-color 220ms ease;
	}

	.home-window .window-dots {
		grid-column: 1 / -1;
	}

	.home-window > span:last-child {
		align-self: center;
	}

	.home-window:hover {
		background:
			linear-gradient(rgb(255 255 255 / 7%), rgb(255 255 255 / 2%)),
			rgb(37 37 37 / 94%);
		transform: translateY(4px) scale(1.03);
	}

	.back-arrow {
		align-self: center;
		font: 900 2.4rem/1 var(--font-display);
	}

	.about-content {
		position: relative;
		z-index: 30;
		width: min(100%, 1280px);
		margin: 0 auto;
		padding-top: clamp(32px, 3vw, 64px);
		text-align: center;
	}

	.eyebrow {
		margin: 0 auto clamp(12px, 2vh, 24px);
		font-size: clamp(0.78rem, 1.1vw, 1rem);
		font-weight: 900;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font: 950 clamp(4rem, 13vw, 13rem) / 0.72 var(--font-display);
		letter-spacing: -0.035em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.story-window {
		position: relative;
		width: min(92%, 820px);
		margin: clamp(48px, 6vh, 84px) auto 0;
		padding: clamp(52px, 6vw, 76px) clamp(25px, 4vw, 54px)
			clamp(28px, 4vw, 48px);
		border: 1px solid rgb(255 255 255 / 58%);
		border-radius: 30px;
		outline: 1px solid rgb(255 255 255 / 16%);
		outline-offset: -3px;
		background: rgb(255 255 255 / 64%);
		box-shadow: 0 8px 28px rgb(37 37 37 / 14%);
		color: var(--black);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		animation: story-float 4.8s ease-in-out infinite;
		will-change: translate;
	}

	.story-copy {
		display: grid;
		gap: 1.1em;
		font-size: clamp(1.05rem, 1.6vw, 1.42rem);
		font-weight: 500;
		line-height: 1.45;
		overflow-wrap: anywhere;
		text-align: center;
	}

	.story-copy > :global(*) {
		margin: 0;
	}

	.story-copy :global(p) { font: inherit; }

	.story-copy :global(p),
	.story-copy :global(h2),
	.story-copy :global(h3),
	.story-copy :global(blockquote),
	.story-copy :global(li) {
		white-space: pre-wrap;
	}

	.story-copy :global(h2),
	.story-copy :global(h3) {
		font-family: "Arial Black", Arial, sans-serif;
		font-weight: 950;
		letter-spacing: -0.025em;
		line-height: 1.08;
		text-transform: none;
	}

	.story-copy :global(h2) { font-size: 1.7em; }
	.story-copy :global(h3) { font-size: 1.32em; }

	.story-copy :global(blockquote) {
		padding: 4px 0 4px 18px;
		border-left: 4px solid rgb(37 37 37 / 30%);
		font-style: italic;
	}

	.story-copy :global(ul),
	.story-copy :global(ol) {
		padding-left: 1.65em;
	}

	.story-copy :global(li + li) { margin-top: .38em; }

	.story-copy :global(a) {
		color: #26798a;
		font-weight: 800;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}

	.section-divider {
		--divider-height: clamp(110px, 11vw, 190px);
		position: relative;
		z-index: 20;
		width: 100%;
		height: var(--divider-height);
		margin-block: calc(var(--divider-height) / -2);
		background: var(--black);
		clip-path: polygon(0 28%, 100% 0, 100% 72%, 0 100%);
		pointer-events: none;
	}

	.footer-divider {
		margin-bottom: calc(var(--divider-height) / -2 - var(--about-footer-gap) - 70px);
		transform: translateY(calc(var(--divider-height) / 2 - var(--about-footer-gap) - 28% - 70px));
	}

	.site-footer {
		position: relative;
		z-index: 1;
		min-height: clamp(310px, 38vh, 480px);
		padding: clamp(150px, 18vw, 240px) clamp(24px, 7vw, 120px) 64px;
		background-color: #383838;
		background-image: radial-gradient(
			circle,
			var(--black) 1.5px,
			transparent 1.6px
		);
		background-size: 24px 24px;
		color: var(--white);
	}

	.footer-content {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 32px;
		align-items: end;
		width: min(1180px, 100%);
		height: 100%;
		margin: 0 auto;
	}

	.footer-name {
		margin: 0;
		font: 950 clamp(2rem, 4vw, 4.5rem) / 0.9 var(--font-display);
		letter-spacing: -0.06em;
		text-transform: uppercase;
	}

	.site-footer nav {
		display: flex;
		gap: clamp(18px, 3vw, 42px);
	}

	.site-footer a {
		color: inherit;
		font-weight: 900;
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}

	.footer-location {
		justify-self: end;
		margin: 0;
		font-weight: 800;
	}

	@keyframes story-float {
		0%,
		100% {
			translate: 0 0;
		}

		50% {
			translate: 0 -4px;
		}
	}

	@media (max-width: 820px) {
		:root {
			--about-footer-gap: 48px;
		}

		.about-page {
			padding: 128px 22px var(--about-footer-gap);
			overflow-y: auto;
		}

		.yellow-panel {
			top: 28%;
			left: 50%;
			width: calc(100% - 28px);
		}

		.home-window {
			top: 64px;
			right: auto;
			left: 22px;
			width: 142px;
			height: 78px;
			padding: 12px;
			border-radius: 22px;
		}

		.window-dots {
			gap: 4px;
		}

		.window-dots i {
			width: 7px;
			height: 7px;
		}

		.back-arrow {
			font-size: 1.8rem;
		}

		.home-window > span:last-child {
			font-size: 0.72rem;
		}

		.eyebrow {
			max-width: 52%;
			text-align: center;
		}

		h1 {
			font-size: clamp(3rem, 15vw, 6rem);
			text-align: center;
		}

		.story-window {
			z-index: 5;
			width: 100%;
			margin-top: 42px;
		}

	}

	@media (max-width: 600px) {
		.story-copy {
			font-size: 1rem;
		}
	}

	@media (max-width: 480px) {
		.eyebrow {
			max-width: 58%;
			font-size: 0.67rem;
		}

		.interactive-window,
		.cake-hitbox,
		.hookem-hitbox {
			width: 44px;
			height: 44px;
		}

		.cake-hitbox,
		.hookem-hitbox {
			--motion-follow-x: 0px;
			--motion-follow-y: 0px;
		}

		.cake-hitbox {
			top: 24%;
			right: 3%;
		}

		.hookem-hitbox {
			top: 64%;
			right: 8%;
		}

		.story-window {
			padding: 50px 22px 28px;
			border-radius: 24px;
		}

	}

	@media (max-width: 700px) {
		.section-divider {
			--divider-height: 108px;
		}

		.site-footer {
			min-height: 380px;
			padding: 138px 24px 54px;
		}

		.footer-content {
			grid-template-columns: 1fr;
			gap: 34px;
			align-content: end;
			align-items: start;
		}

		.site-footer nav {
			flex-wrap: wrap;
		}

		.footer-location {
