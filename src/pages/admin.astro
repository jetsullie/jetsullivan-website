---
import SiteMenu from "../components/common/SiteMenu.astro";
import PageMotion from "../components/common/PageMotion.astro";

const pageTitle = "Jet Sullivan — Admin";

const adminWindows = [
	[3, 17, 42, 34, "✦"], [10, 48, 52, 40, "×"], [17, 8, 46, 38, "○"],
	[23, 76, 62, 46, "△"], [30, 28, 70, 52, "+"], [37, 87, 58, 44, "◇"],
	[44, 12, 76, 56, "≈"], [51, 64, 84, 61, "□"], [58, 35, 66, 49, "§"],
	[65, 81, 94, 68, "∞"], [72, 7, 72, 53, "※"], [79, 50, 104, 74, "∴"],
	[86, 20, 48, 37, "✦"], [93, 60, 60, 45, "◌"], [6, 90, 82, 59, "×"],
	[20, 56, 90, 65, "○"], [69, 29, 106, 75, "△"], [89, 78, 116, 80, "+"],
	[40, 42, 54, 41, "◇"], [82, 91, 68, 50, "≈"],
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow, noarchive" />
		<link rel="icon" type="image/png" href="/favicon-profile.png" />
		<title>{pageTitle}</title>
	</head>
	<body data-motion-root data-motion-speed="1.35">
		<div class="admin-floaters" data-motion-bounds>
			{
				adminWindows.map((item) => (
					<button
						type="button"
						class="admin-mini-window"
						data-motion-float
						aria-label="Dismiss background symbol"
						style={`--x:${item[0]}%;--y:${item[1]}%;--w:${item[2]}px;--h:${item[3]}px;`}
					>
						<span class="admin-window-symbol" aria-hidden="true">{item[4]}</span>
					</button>
				))
			}
		</div>

		<main>
			<SiteMenu showHomeButton />
			<div class="admin-content" data-motion-depth="scene">
			<header>
				<div>
					<p class="eyebrow">Private owner dashboard</p>
					<h1>Admin</h1>
				</div>
				<a class="sign-out" href="/cdn-cgi/access/logout">Sign out</a>
			</header>

			<div class="notice">
				<strong>Authorized owner:</strong> jetsullivan1@gmail.com
			</div>

				<section aria-labelledby="about-editor-title">
					<h2 id="about-editor-title">About biography</h2>
					<form id="about-form">
					<label for="biography">Biography</label>
					<textarea id="biography" name="biography" maxlength="5000" required></textarea>
					<div class="actions">
						<button type="submit">Save biography</button>
						<output id="about-status" aria-live="polite"></output>
					</div>
					</form>
				</section>

				<section aria-labelledby="credits-editor-title">
					<h2 id="credits-editor-title">Film credits</h2>
					<p class="section-intro">
						Create a position category, choose its color, and list every film or
						project where you held that position. Film links are optional, and the
						order shown here is the order visitors will see.
					</p>
					<form id="credit-form">
						<input id="credit-id" type="hidden" />
						<div class="field-grid">
							<label class="field">
								<span>Position category</span>
								<input
									id="credit-position"
									type="text"
									maxlength="80"
									placeholder="Sound Mixer"
									autocomplete="off"
									required
								/>
							</label>

							<div class="field">
								<label for="credit-color">Category color</label>
								<div class="credit-color-control">
									<input id="credit-color" type="color" value="#F55C66" />
									<span class="credit-color-preview" aria-hidden="true"></span>
									<span id="credit-color-value">#F55C66</span>
								</div>
							</div>

							<fieldset class="credit-film-editor field-wide">
								<legend>Films for this position</legend>
								<p>
									Add the film names in display order. Each film can optionally open an
									external HTTPS link.
								</p>
								<div id="credit-film-rows" class="credit-film-rows"></div>
								<button
									id="credit-add-film"
									class="secondary-button credit-add-film"
									type="button"
								>
									+ Add another film
								</button>
							</fieldset>
						</div>

						<div class="actions">
							<button id="credit-submit" type="submit">Create category</button>
							<button id="credit-cancel" class="secondary-button" type="button" hidden>
								Cancel edit
							</button>
							<output id="credit-status" aria-live="polite"></output>
						</div>
					</form>

					<div id="credit-category-list" class="credit-category-admin-list"></div>
				</section>

				<section aria-labelledby="media-entry-editor-title">
				<h2 id="media-entry-editor-title">Site posts</h2>
				<p class="section-intro">
					Add a dated update to Featured, Interviews, Behind the Scenes, or
					Press, plus Acting, Film, and Video. Optional post attachments are
					stored privately and only appear through their published post. Use
					the star on an Interview, Behind the Scenes, or Press post to show
					that same post in Featured without creating it twice.
				</p>
				<form id="media-entry-form" enctype="multipart/form-data">
					<input id="entry-id" name="id" type="hidden" />
					<div class="field-grid">
						<label class="field">
							<span>Section</span>
							<select id="entry-section" name="section">
								<option value="featured">Featured</option>
								<option value="interviews">Interviews</option>
								<option value="behind-the-scenes">Behind the Scenes</option>
								<option value="press">Press</option>
								<option value="acting">Acting</option>
								<option value="film">Film</option>
								<option value="video">Video</option>
							</select>
						</label>

						<label class="field">
							<span>Date</span>
							<input id="entry-date" name="date" type="date" required />
						</label>

						<label class="field field-wide">
							<span>Title</span>
							<input
								id="entry-title"
								name="title"
								type="text"
								maxlength="120"
								autocomplete="off"
								required
							/>
						</label>

						<label class="field field-wide">
							<span>Short description</span>
							<textarea
								id="entry-description"
								class="compact-textarea"
								name="description"
								maxlength="800"
								required
							></textarea>
						</label>

						<label id="entry-link-field" class="field field-wide">
							<span id="entry-link-label">Link (optional)</span>
							<input
								id="entry-link"
								name="link"
								type="url"
								inputmode="url"
								placeholder="https://"
								maxlength="2048"
							/>
						</label>

						<div id="entry-image-fields" class="image-fields field-wide" hidden>
							<label class="field">
								<span>Behind-the-scenes photo</span>
								<input
									id="entry-image"
									name="image"
									type="file"
									accept="image/jpeg,image/png,image/webp,image/avif"
								/>
								<small>JPEG, PNG, WebP, or AVIF. Maximum 15 MB.</small>
							</label>
							<label class="field">
								<span>Photo description</span>
								<input
									id="entry-image-alt"
									name="imageAlt"
									type="text"
									maxlength="180"
									placeholder="Describe what is visible in the photo"
								/>
							</label>
						</div>

						<div
							id="entry-attachment-fields"
							class="image-fields field-wide"
							hidden
						>
							<label class="field">
								<span>Post attachment (optional)</span>
								<input
									id="entry-attachment"
									name="attachment"
									type="file"
									accept="image/jpeg,image/png,image/webp,image/avif,image/gif,video/mp4,video/webm,video/ogg,video/quicktime,application/pdf,audio/mpeg,audio/mp4,audio/ogg,audio/wav,text/plain,application/zip,.doc,.docx,.xls,.xlsx,.ppt,.pptx"
								/>
								<small>
									Images, videos, audio, PDFs, text, Office documents, or ZIP
									files. Maximum 100 MB.
								</small>
							</label>
							<div class="field">
								<label for="entry-attachment-alt">Attachment description</label>
								<input
									id="entry-attachment-alt"
									name="attachmentAlt"
									type="text"
									maxlength="180"
									placeholder="Describe an image or identify the attached file"
								/>
								<small id="entry-attachment-current"></small>
								<label class="checkbox-field">
									<input
										id="entry-remove-attachment"
										name="removeAttachment"
										type="checkbox"
										value="true"
									/>
									Remove the current attachment
								</label>
							</div>
						</div>
					</div>

					<p id="entry-guidance" class="form-guidance"></p>
					<div class="actions">
						<button id="entry-submit" type="submit">Publish post</button>
						<button id="entry-cancel" class="secondary-button" type="button" hidden>
							Cancel edit
						</button>
						<output id="media-entry-status" aria-live="polite"></output>
					</div>
				</form>

				<div id="media-entry-list" class="entry-list"></div>
			</section>

			<section aria-labelledby="media-editor-title">
				<h2 id="media-editor-title">Website media library</h2>
				<p class="section-intro">
					Every uploaded website file appears here, including files currently
					used by posts. Preview, rename, copy, or permanently delete them.
				</p>
				<form id="media-form">
					<label for="media-file">Upload a library file</label>
					<input
						id="media-file"
						name="file"
						type="file"
						accept="image/jpeg,image/png,image/webp,image/avif,image/gif,video/mp4,video/webm,video/ogg,video/quicktime,application/pdf,audio/mpeg,audio/mp4,audio/ogg,audio/wav,text/plain,application/zip,.doc,.docx,.xls,.xlsx,.ppt,.pptx"
						required
					/>
					<div class="actions">
						<button type="submit">Upload media</button>
						<button id="media-refresh" class="secondary-button" type="button">
							Refresh library
						</button>
						<output id="media-status" aria-live="polite"></output>
					</div>
				</form>
				<div id="media-list" class="media-list"></div>
			</section>
			</div>
		</main>

		<dialog id="delete-confirm-dialog" class="delete-confirm-dialog">
			<form method="dialog">
				<p class="dialog-eyebrow">Confirm deletion</p>
				<h2>Delete this post?</h2>
				<p id="delete-confirm-message"></p>
				<div class="dialog-actions">
					<button id="delete-confirm-cancel" class="secondary-button" value="cancel">
						Keep post
					</button>
					<button id="delete-confirm-submit" class="danger-button" value="confirm">
						Delete post
					</button>
				</div>
			</form>
		</dialog>

		<dialog id="credit-delete-dialog" class="delete-confirm-dialog">
			<form method="dialog">
				<p class="dialog-eyebrow">Confirm deletion</p>
				<h2>Delete this category?</h2>
				<p id="credit-delete-message" class="delete-confirm-message"></p>
				<div class="dialog-actions">
					<button class="secondary-button" value="cancel">Keep category</button>
					<button id="credit-delete-submit" class="danger-button" value="confirm">
						Delete category
					</button>
				</div>
			</form>
		</dialog>

		<dialog id="media-delete-dialog" class="delete-confirm-dialog">
			<form method="dialog">
				<p class="dialog-eyebrow">Permanent deletion</p>
				<h2>Delete this file?</h2>
				<p id="media-delete-message"></p>
				<div class="dialog-actions">
					<button class="secondary-button" value="cancel">Keep file</button>
					<button id="media-delete-submit" class="danger-button" value="confirm">
						Delete everywhere
					</button>
				</div>
			</form>
		</dialog>

		<div class="section-divider footer-divider" aria-hidden="true"></div>

		<footer class="site-footer">
			<div class="footer-content">
				<p class="footer-name">Admin Jet Sullivan</p>
				<span aria-hidden="true"></span>
				<p class="footer-location">Austin, Texas</p>
			</div>
		</footer>

		<PageMotion />
	</body>
</html>

<script>
	const biography = document.querySelector<HTMLTextAreaElement>("#biography");
	const aboutForm = document.querySelector<HTMLFormElement>("#about-form");
	const aboutStatus = document.querySelector<HTMLOutputElement>("#about-status");
	const creditForm = document.querySelector<HTMLFormElement>("#credit-form");
	const creditId = document.querySelector<HTMLInputElement>("#credit-id");
	const creditPosition =
		document.querySelector<HTMLInputElement>("#credit-position");
	const creditColor = document.querySelector<HTMLInputElement>("#credit-color");
	const creditColorValue =
		document.querySelector<HTMLElement>("#credit-color-value");
	const creditColorPreview =
		document.querySelector<HTMLElement>(".credit-color-preview");
	const creditFilmRows =
		document.querySelector<HTMLElement>("#credit-film-rows");
	const creditAddFilm =
		document.querySelector<HTMLButtonElement>("#credit-add-film");
	const creditSubmit =
		document.querySelector<HTMLButtonElement>("#credit-submit");
	const creditCancel =
		document.querySelector<HTMLButtonElement>("#credit-cancel");
	const creditStatus =
		document.querySelector<HTMLOutputElement>("#credit-status");
	const creditCategoryList =
		document.querySelector<HTMLElement>("#credit-category-list");
	const creditDeleteDialog =
		document.querySelector<HTMLDialogElement>("#credit-delete-dialog");
	const creditDeleteMessage =
		document.querySelector<HTMLElement>("#credit-delete-message");
	const creditDeleteSubmit =
		document.querySelector<HTMLButtonElement>("#credit-delete-submit");
	const mediaForm = document.querySelector<HTMLFormElement>("#media-form");
	const mediaStatus = document.querySelector<HTMLOutputElement>("#media-status");
	const mediaList = document.querySelector<HTMLElement>("#media-list");
	const mediaRefresh =
		document.querySelector<HTMLButtonElement>("#media-refresh");
	const mediaEntryForm =
		document.querySelector<HTMLFormElement>("#media-entry-form");
	const mediaEntryStatus =
		document.querySelector<HTMLOutputElement>("#media-entry-status");
	const mediaEntryList =
		document.querySelector<HTMLElement>("#media-entry-list");
	const entryId = document.querySelector<HTMLInputElement>("#entry-id");
	const entrySection =
		document.querySelector<HTMLSelectElement>("#entry-section");
	const entryDate = document.querySelector<HTMLInputElement>("#entry-date");
	const entryTitle = document.querySelector<HTMLInputElement>("#entry-title");
	const entryDescription =
		document.querySelector<HTMLTextAreaElement>("#entry-description");
	const entryLink = document.querySelector<HTMLInputElement>("#entry-link");
	const entryLinkField =
		document.querySelector<HTMLElement>("#entry-link-field");
	const entryLinkLabel =
		document.querySelector<HTMLElement>("#entry-link-label");
	const entryImageFields =
		document.querySelector<HTMLElement>("#entry-image-fields");
	const entryImage = document.querySelector<HTMLInputElement>("#entry-image");
	const entryImageAlt =
		document.querySelector<HTMLInputElement>("#entry-image-alt");
	const entryAttachmentFields =
		document.querySelector<HTMLElement>("#entry-attachment-fields");
	const entryAttachment =
		document.querySelector<HTMLInputElement>("#entry-attachment");
	const entryAttachmentAlt =
		document.querySelector<HTMLInputElement>("#entry-attachment-alt");
	const entryAttachmentCurrent =
		document.querySelector<HTMLElement>("#entry-attachment-current");
	const entryRemoveAttachment =
		document.querySelector<HTMLInputElement>("#entry-remove-attachment");
	const entryGuidance =
		document.querySelector<HTMLElement>("#entry-guidance");
	const entrySubmit =
		document.querySelector<HTMLButtonElement>("#entry-submit");
	const entryCancel =
		document.querySelector<HTMLButtonElement>("#entry-cancel");
	const deleteConfirmDialog =
		document.querySelector<HTMLDialogElement>("#delete-confirm-dialog");
	const deleteConfirmMessage =
		document.querySelector<HTMLElement>("#delete-confirm-message");
	const deleteConfirmSubmit =
		document.querySelector<HTMLButtonElement>("#delete-confirm-submit");
	const mediaDeleteDialog =
		document.querySelector<HTMLDialogElement>("#media-delete-dialog");
	const mediaDeleteMessage =
		document.querySelector<HTMLElement>("#media-delete-message");
	const mediaDeleteSubmit =
		document.querySelector<HTMLButtonElement>("#media-delete-submit");

	type MediaSection =
		| "featured"
		| "interviews"
		| "behind-the-scenes"
		| "press"
		| "acting"
		| "film"
		| "video";

	type MediaEntry = {
		id: string;
		section: MediaSection;
		category?: MediaSection;
		title: string;
		description: string;
		date: string;
		link?: string | null;
		imageUrl?: string | null;
		imageAlt?: string | null;
		attachmentUrl?: string | null;
		attachmentType?: string | null;
		attachmentName?: string | null;
		attachmentAlt?: string | null;
		featured?: boolean;
		createdAt?: string;
	};

	type MediaReference = {
		section: MediaSection;
		entryId: string;
		title: string;
		role: string;
	};

	type MediaItem = {
		key: string;
		name: string;
		url: string;
		size: number;
		uploaded?: string;
		contentType: string;
		managed: boolean;
		usedBy: MediaReference[];
	};

	type CreditFilm = {
		id?: string;
		name: string;
		link?: string | null;
	};

	type CreditCategory = {
		id: string;
		position: string;
		color: string;
		films: CreditFilm[];
		createdAt?: string;
		updatedAt?: string;
	};

	const mediaSections: Array<{
		value: MediaSection;
		label: string;
	}> = [
		{ value: "featured", label: "Featured" },
		{ value: "interviews", label: "Interviews" },
		{ value: "behind-the-scenes", label: "Behind the Scenes" },
		{ value: "press", label: "Press" },
		{ value: "acting", label: "Acting" },
		{ value: "film", label: "Film" },
		{ value: "video", label: "Video" },
	];

	let editingHasImage = false;
	let editingHasAttachment = false;
	let editingAttachmentName = "";
	let pendingDeleteEntry: MediaEntry | null = null;
	let pendingDeleteMedia: MediaItem | null = null;
	let creditCategories: CreditCategory[] = [];
	let pendingDeleteCredit: CreditCategory | null = null;
	let creditFilmRowSequence = 0;

	const readError = async (response: Response) => {
		const contentType = response.headers.get("Content-Type") || "";

		if (contentType.includes("application/json")) {
			try {
				const result = await response.json();
				if (typeof result.error === "string") return result.error;
			} catch {
				// Continue to the status-specific message below.
			}
		}

		const text = await response.text().catch(() => "");
		if (text && !text.trimStart().startsWith("<") && text.length < 240) {
			return text;
		}

		if (response.status === 404) {
			return "Admin API unavailable. Use Cloudflare Pages development or deploy the configured Cloudflare project; Astro dev does not run Pages Functions.";
		}
		if (response.status === 503) {
			return "Cloudflare Access or storage bindings are not configured yet.";
		}
		if (response.status === 403) {
			return "Access denied. Sign in as jetsullivan1@gmail.com.";
		}

		return `Request failed with HTTP ${response.status}.`;
	};

	const creditPalette = [
		"#F55C66",
		"#FFB05C",
		"#EFDA4A",
		"#7CF5B5",
		"#93E9F9",
		"#BFA6FF",
		"#FDBFBF",
	];
	const creditColorPattern = /^#[0-9A-F]{6}$/i;

	const normalizeCreditColor = (value: unknown) =>
		typeof value === "string" && creditColorPattern.test(value)
			? value.toUpperCase()
			: creditPalette[0];

	const safeCreditLink = (value: unknown) => {
		if (typeof value !== "string" || !value.trim()) return null;
		try {
			const url = new URL(value);
			return url.protocol === "https:" && !url.username && !url.password
				? url
				: null;
		} catch {
			return null;
		}
	};

	const syncCreditColor = () => {
		if (!creditColor) return;
		const color = normalizeCreditColor(creditColor.value);
		creditColor.value = color;
		if (creditColorValue) creditColorValue.textContent = color;
		creditColorPreview?.style.setProperty("--credit-preview-color", color);
	};

	const getCreditFilmRowElements = () =>
		creditFilmRows
			? Array.from(
					creditFilmRows.querySelectorAll<HTMLElement>(".credit-film-row"),
				)
			: [];

	const updateCreditFilmRowControls = () => {
		const rows = getCreditFilmRowElements();
		rows.forEach((row, index) => {
			const up = row.querySelector<HTMLButtonElement>("[data-credit-row-up]");
			const down = row.querySelector<HTMLButtonElement>("[data-credit-row-down]");
			const remove = row.querySelector<HTMLButtonElement>(
				"[data-credit-row-remove]",
			);
			if (up) up.disabled = index === 0;
			if (down) down.disabled = index === rows.length - 1;
			if (remove) remove.disabled = rows.length === 1;
		});
	};

	const createCreditFilmRow = (film: Partial<CreditFilm> = {}) => {
		if (!creditFilmRows) return;
		creditFilmRowSequence += 1;
		const sequence = creditFilmRowSequence;
		const row = document.createElement("div");
		const nameField = document.createElement("label");
		const nameLabel = document.createElement("span");
		const nameInput = document.createElement("input");
		const linkField = document.createElement("label");
		const linkLabel = document.createElement("span");
		const linkInput = document.createElement("input");
		const controls = document.createElement("div");
		const moveUp = document.createElement("button");
		const moveDown = document.createElement("button");
		const remove = document.createElement("button");
		const nameId = `credit-film-name-${sequence}`;
		const linkId = `credit-film-link-${sequence}`;

		row.className = "credit-film-row";
		row.dataset.creditFilmId = typeof film.id === "string" ? film.id : "";
		nameField.className = "field";
		nameField.htmlFor = nameId;
		nameLabel.textContent = "Film or project name";
		nameInput.id = nameId;
		nameInput.type = "text";
		nameInput.maxLength = 160;
		nameInput.autocomplete = "off";
		nameInput.required = true;
		nameInput.value = typeof film.name === "string" ? film.name : "";
		nameField.append(nameLabel, nameInput);

		linkField.className = "field";
		linkField.htmlFor = linkId;
		linkLabel.textContent = "HTTPS link (optional)";
		linkInput.id = linkId;
		linkInput.type = "url";
		linkInput.inputMode = "url";
		linkInput.maxLength = 2048;
		linkInput.placeholder = "https://";
		linkInput.value = typeof film.link === "string" ? film.link : "";
		linkField.append(linkLabel, linkInput);

		controls.className = "credit-film-row-actions";
		for (const button of [moveUp, moveDown, remove]) {
			button.type = "button";
			button.className = "secondary-button credit-film-row-button";
		}
		moveUp.textContent = "↑";
		moveUp.title = "Move film up";
		moveUp.setAttribute("aria-label", "Move this film up");
		moveUp.dataset.creditRowUp = "true";
		moveDown.textContent = "↓";
		moveDown.title = "Move film down";
		moveDown.setAttribute("aria-label", "Move this film down");
		moveDown.dataset.creditRowDown = "true";
		remove.textContent = "Remove";
		remove.setAttribute("aria-label", "Remove this film from the category");
		remove.dataset.creditRowRemove = "true";

		moveUp.addEventListener("click", () => {
			const previous = row.previousElementSibling;
			if (previous) creditFilmRows.insertBefore(row, previous);
			updateCreditFilmRowControls();
		});
		moveDown.addEventListener("click", () => {
			const next = row.nextElementSibling;
			if (next) next.after(row);
			updateCreditFilmRowControls();
		});
		remove.addEventListener("click", () => {
			row.remove();
			updateCreditFilmRowControls();
		});

		controls.append(moveUp, moveDown, remove);
		row.append(nameField, linkField, controls);
		creditFilmRows.append(row);
		updateCreditFilmRowControls();
	};

	const collectCreditFilms = (): CreditFilm[] => {
		const rows = getCreditFilmRowElements();
		if (!rows.length) throw new Error("Add at least one film to this category.");

		return rows.map((row, index) => {
			const name =
				row.querySelector<HTMLInputElement>('input[type="text"]')?.value.trim() ||
				"";
			const linkValue =
				row.querySelector<HTMLInputElement>('input[type="url"]')?.value.trim() ||
				"";
			if (!name) throw new Error(`Enter a name for film ${index + 1}.`);
			const link = linkValue ? safeCreditLink(linkValue) : null;
			if (linkValue && !link) {
				throw new Error(
					`Film ${index + 1} needs a valid HTTPS link without login details.`,
				);
			}
			return {
				...(row.dataset.creditFilmId
					? { id: row.dataset.creditFilmId }
					: {}),
				name,
				link: link?.href || null,
			};
		});
	};

	const resetCreditForm = () => {
		if (!creditForm) return;
		creditForm.reset();
		if (creditId) creditId.value = "";
		if (creditColor) {
			creditColor.value =
				creditPalette[creditCategories.length % creditPalette.length];
		}
		creditFilmRows?.replaceChildren();
		createCreditFilmRow();
		if (creditSubmit) creditSubmit.textContent = "Create category";
		if (creditCancel) creditCancel.hidden = true;
		syncCreditColor();
	};

	const startEditingCredit = (category: CreditCategory) => {
		if (
			!creditForm ||
			!creditId ||
			!creditPosition ||
			!creditColor ||
			!creditFilmRows
		) {
			return;
		}
		creditForm.reset();
		creditId.value = category.id;
		creditPosition.value = category.position;
		creditColor.value = normalizeCreditColor(category.color);
		creditFilmRows.replaceChildren();
		for (const film of category.films) createCreditFilmRow(film);
		if (!category.films.length) createCreditFilmRow();
		if (creditSubmit) creditSubmit.textContent = "Update category";
		if (creditCancel) creditCancel.hidden = false;
		if (creditStatus) {
			creditStatus.textContent = `Editing “${category.position}”.`;
		}
		syncCreditColor();
		creditForm.scrollIntoView({ behavior: "smooth", block: "center" });
		creditPosition.focus({ preventScroll: true });
	};

	const requestCreditDeletion = (category: CreditCategory) => {
		if (!creditDeleteDialog || !creditDeleteMessage) return;
		pendingDeleteCredit = category;
		creditDeleteDialog.returnValue = "";
		const count = category.films.length;
		creditDeleteMessage.textContent =
			`Delete “${category.position}” and its ${count} ${
				count === 1 ? "film credit" : "film credits"
			}? This cannot be undone.`;
		creditDeleteDialog.showModal();
	};

	const renderCreditCategories = (categories: CreditCategory[]) => {
		if (!creditCategoryList) return;
		creditCategoryList.replaceChildren();

		if (!categories.length) {
			const empty = document.createElement("p");
			empty.className = "entry-empty credit-category-empty";
			empty.textContent = "No film credit categories have been added yet.";
			creditCategoryList.append(empty);
			return;
		}

		categories.forEach((category, index) => {
			const card = document.createElement("article");
			const header = document.createElement("div");
			const headingWrap = document.createElement("div");
			const swatch = document.createElement("span");
			const heading = document.createElement("h3");
			const count = document.createElement("p");
			const films = document.createElement("ol");
			const actions = document.createElement("div");
			const moveUp = document.createElement("button");
			const moveDown = document.createElement("button");
			const edit = document.createElement("button");
			const remove = document.createElement("button");
			const color = normalizeCreditColor(category.color);

			card.className = "credit-admin-card";
			card.style.setProperty("--credit-color", color);
			header.className = "credit-admin-header";
			headingWrap.className = "credit-admin-heading";
			swatch.className = "credit-admin-swatch";
			swatch.setAttribute("aria-hidden", "true");
			heading.textContent = category.position;
			count.textContent = `${category.films.length} ${
				category.films.length === 1 ? "film" : "films"
			}`;
			headingWrap.append(swatch, heading);
			header.append(headingWrap, count);
			films.className = "credit-admin-films";

			for (const film of category.films) {
				const item = document.createElement("li");
				const link = safeCreditLink(film.link);
				if (link) {
					const anchor = document.createElement("a");
					anchor.href = link.href;
					anchor.target = "_blank";
					anchor.rel = "noopener noreferrer";
					anchor.textContent = `${film.name} ↗`;
					item.append(anchor);
				} else {
					item.textContent = film.name;
				}
				films.append(item);
			}

			actions.className = "credit-category-actions";
			for (const button of [moveUp, moveDown, edit, remove]) {
				button.type = "button";
			}
			moveUp.className = "secondary-button";
			moveUp.textContent = "Move up";
			moveUp.disabled = index === 0;
			moveUp.addEventListener("click", () => {
				void moveCreditCategory(index, -1);
			});
			moveDown.className = "secondary-button";
			moveDown.textContent = "Move down";
			moveDown.disabled = index === categories.length - 1;
			moveDown.addEventListener("click", () => {
				void moveCreditCategory(index, 1);
			});
			edit.className = "secondary-button";
			edit.textContent = "Edit";
			edit.addEventListener("click", () => startEditingCredit(category));
			remove.className = "danger-button";
			remove.textContent = "Delete";
			remove.addEventListener("click", () => requestCreditDeletion(category));
			actions.append(moveUp, moveDown, edit, remove);
			card.append(header, films, actions);
			creditCategoryList.append(card);
		});
	};

	const loadCredits = async (successMessage = "") => {
		if (!creditStatus) return;
		creditStatus.textContent = "Loading credits…";
		try {
			const response = await fetch("/admin/api/credits", {
				credentials: "same-origin",
			});
			if (!response.ok) throw new Error(await readError(response));
			const result = await response.json();
			creditCategories = Array.isArray(result.categories)
				? result.categories
				: [];
			renderCreditCategories(creditCategories);
			if (!creditId?.value && !creditPosition?.value.trim() && creditColor) {
				creditColor.value =
					creditPalette[creditCategories.length % creditPalette.length];
				syncCreditColor();
			}
			creditStatus.textContent = successMessage;
		} catch (error) {
			creditStatus.textContent =
				error instanceof Error ? error.message : "Could not load film credits.";
		}
	};

	const moveCreditCategory = async (index: number, direction: -1 | 1) => {
		const nextIndex = index + direction;
		if (
			!creditStatus ||
			index < 0 ||
			nextIndex < 0 ||
			nextIndex >= creditCategories.length
		) {
			return;
		}
		const reordered = [...creditCategories];
		[reordered[index], reordered[nextIndex]] = [
			reordered[nextIndex],
			reordered[index],
		];
		creditStatus.textContent = "Updating category order…";
		try {
			const response = await fetch("/admin/api/credits", {
				method: "PATCH",
				credentials: "same-origin",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({
					categoryIds: reordered.map((category) => category.id),
				}),
			});
			if (!response.ok) throw new Error(await readError(response));
			await loadCredits("Category order updated.");
		} catch (error) {
			creditStatus.textContent =
				error instanceof Error ? error.message : "Could not reorder categories.";
		}
	};

	const deleteCreditCategory = async (category: CreditCategory) => {
		if (creditStatus) creditStatus.textContent = "Deleting category…";
		if (creditDeleteSubmit) creditDeleteSubmit.disabled = true;
		try {
			const response = await fetch(
				`/admin/api/credits?id=${encodeURIComponent(category.id)}`,
				{ method: "DELETE", credentials: "same-origin" },
			);
			if (!response.ok) throw new Error(await readError(response));
			if (creditId?.value === category.id) resetCreditForm();
			await loadCredits("Credit category deleted.");
		} catch (error) {
			if (creditStatus) {
				creditStatus.textContent =
					error instanceof Error
						? error.message
						: "Could not delete credit category.";
			}
		} finally {
			if (creditDeleteSubmit) creditDeleteSubmit.disabled = false;
			pendingDeleteCredit = null;
		}
	};

	creditAddFilm?.addEventListener("click", () => {
		createCreditFilmRow();
		getCreditFilmRowElements()
			.at(-1)
			?.querySelector<HTMLInputElement>('input[type="text"]')
			?.focus();
	});
	creditColor?.addEventListener("input", syncCreditColor);
	creditCancel?.addEventListener("click", () => {
		resetCreditForm();
		if (creditStatus) creditStatus.textContent = "Edit cancelled.";
	});
	creditDeleteDialog?.addEventListener("close", () => {
		if (
			creditDeleteDialog.returnValue === "confirm" &&
			pendingDeleteCredit
		) {
			void deleteCreditCategory(pendingDeleteCredit);
		} else {
			pendingDeleteCredit = null;
		}
	});
	creditForm?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (
			!creditForm ||
			!creditId ||
			!creditPosition ||
			!creditColor ||
			!creditStatus
		) {
			return;
		}
		const isEditing = Boolean(creditId.value);
		creditStatus.textContent = isEditing
			? "Updating category…"
			: "Creating category…";
		if (creditSubmit) creditSubmit.disabled = true;
		if (creditCancel) creditCancel.disabled = true;

		try {
			const films = collectCreditFilms();
			const response = await fetch("/admin/api/credits", {
				method: isEditing ? "PUT" : "POST",
				credentials: "same-origin",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({
					...(isEditing ? { id: creditId.value } : {}),
					position: creditPosition.value.trim(),
					color: normalizeCreditColor(creditColor.value),
					films,
				}),
			});
			if (!response.ok) throw new Error(await readError(response));
			resetCreditForm();
			await loadCredits(
				isEditing ? "Credit category updated." : "Credit category created.",
			);
		} catch (error) {
			creditStatus.textContent =
				error instanceof Error ? error.message : "Could not save credit category.";
		} finally {
			if (creditSubmit) creditSubmit.disabled = false;
			if (creditCancel) creditCancel.disabled = false;
		}
	});

	const getLocalDate = () => {
		const now = new Date();
		const local = new Date(now.getTime() - now.getTimezoneOffset() * 60_000);
		return local.toISOString().slice(0, 10);
	};

	const formatDate = (value: string) => {
		const date = new Date(`${value}T12:00:00`);
		if (Number.isNaN(date.getTime())) return value;
		return new Intl.DateTimeFormat("en-US", {
			year: "numeric",
			month: "long",
			day: "numeric",
		}).format(date);
	};

	const getEntrySection = (entry: MediaEntry): MediaSection =>
		entry.section || entry.category || "featured";

	const getEntryEndpoint = (section: MediaSection) =>
		`/admin/api/media-entries/${encodeURIComponent(section)}`;

	const requestEntryDeletion = (entry: MediaEntry) => {
		if (!deleteConfirmDialog || !deleteConfirmMessage) return;
		pendingDeleteEntry = entry;
		deleteConfirmDialog.returnValue = "";
		deleteConfirmMessage.textContent =
			`Do you actually want to delete the post “${entry.title}”? This cannot be undone.`;
		deleteConfirmDialog.showModal();
	};

	const deleteEntry = async (entry: MediaEntry) => {
		const sectionValue = getEntrySection(entry);
		if (mediaEntryStatus) mediaEntryStatus.textContent = "Deleting…";
		if (deleteConfirmSubmit) deleteConfirmSubmit.disabled = true;

		try {
			const response = await fetch(
				`${getEntryEndpoint(sectionValue)}?id=${encodeURIComponent(entry.id)}`,
				{ method: "DELETE", credentials: "same-origin" },
			);
			if (!response.ok) throw new Error(await readError(response));
			if (entryId?.value === entry.id) resetMediaEntryForm();
			await loadMediaEntries("Entry deleted.");
		} catch (error) {
			const message =
				error instanceof Error ? error.message : "Could not delete entry.";
			if (mediaEntryStatus) mediaEntryStatus.textContent = message;
		} finally {
			if (deleteConfirmSubmit) deleteConfirmSubmit.disabled = false;
			pendingDeleteEntry = null;
		}
	};

	const syncEntryFields = () => {
		if (
			!entrySection ||
			!entryLink ||
			!entryLinkField ||
			!entryLinkLabel ||
			!entryImageFields ||
			!entryImage ||
			!entryImageAlt ||
			!entryAttachmentFields ||
			!entryAttachment ||
			!entryAttachmentAlt ||
			!entryAttachmentCurrent ||
			!entryRemoveAttachment ||
			!entryGuidance
		) {
			return;
		}

		const section = entrySection.value as MediaSection;
		const isBehindScenes = section === "behind-the-scenes";
		const isPortfolio =
			section === "acting" || section === "film" || section === "video";
		const needsLink = section === "interviews" || section === "press";

		entryLinkField.hidden = isBehindScenes;
		entryImageFields.hidden = !isBehindScenes;
		entryAttachmentFields.hidden = false;
		entryLink.required = needsLink;
		entryImage.required = false;
		entryImageAlt.required =
			isBehindScenes &&
			(editingHasImage || Boolean(entryImage.files?.length));
		entryAttachment.required = false;
		entryAttachmentAlt.required = false;
		entryAttachmentCurrent.textContent =
			editingHasAttachment
				? `Current attachment: ${editingAttachmentName || "uploaded file"}. It will remain unless replaced or removed.`
				: "";
		entryRemoveAttachment.parentElement?.toggleAttribute(
			"hidden",
			!editingHasAttachment,
		);

		if (isBehindScenes) {
			entryLink.value = "";
		} else {
			entryImage.value = "";
			entryImageAlt.value = "";
		}
		if (section === "interviews") {
			entryLinkLabel.textContent = "Interview video link";
			entryGuidance.textContent =
				"Add the secure link where visitors can watch the interview. You can also attach one optional media file.";
		} else if (section === "press") {
			entryLinkLabel.textContent = "Press article link";
			entryGuidance.textContent =
				"Add the secure link where visitors can read the article. You can also attach one optional media file.";
		} else if (section === "behind-the-scenes") {
			entryGuidance.textContent = editingHasImage
				? "The existing photo will stay unless replaced. You can also attach one optional media file."
				: "The primary photo and the general media attachment are both optional. Add a description for any photo you upload.";
		} else if (isPortfolio) {
			entryLinkLabel.textContent = `${section[0].toUpperCase()}${section.slice(1)} link (optional)`;
			entryGuidance.textContent = editingHasAttachment
				? "The current file will remain unless you choose a replacement or select Remove."
				: "Optionally attach one image, video, PDF, audio file, document, or ZIP file to this post.";
		} else {
			entryLinkLabel.textContent = "Featured work link (optional)";
			entryGuidance.textContent =
				"You can add a link and attach one optional image, video, PDF, audio file, document, or ZIP file.";
		}
	};

	const resetMediaEntryForm = () => {
		if (!mediaEntryForm) return;
		mediaEntryForm.reset();
		editingHasImage = false;
		editingHasAttachment = false;
		editingAttachmentName = "";
		if (entryId) entryId.value = "";
		if (entryDate) entryDate.value = getLocalDate();
		if (entrySection) entrySection.disabled = false;
		if (entrySubmit) entrySubmit.textContent = "Publish post";
		if (entryCancel) entryCancel.hidden = true;
		syncEntryFields();
	};

	const startEditingEntry = (entry: MediaEntry) => {
		if (
			!mediaEntryForm ||
			!entryId ||
			!entrySection ||
			!entryDate ||
			!entryTitle ||
			!entryDescription ||
			!entryLink ||
			!entryImageAlt ||
			!entryAttachmentAlt ||
			!entryRemoveAttachment
		) {
			return;
		}

		mediaEntryForm.reset();
		if (entryImage) entryImage.value = "";
		if (entryAttachment) entryAttachment.value = "";
		entryId.value = entry.id;
		entrySection.value = getEntrySection(entry);
		entrySection.disabled = true;
		entryDate.value = entry.date;
		entryTitle.value = entry.title;
		entryDescription.value = entry.description;
		entryLink.value = entry.link || "";
		entryImageAlt.value = entry.imageAlt || "";
		entryAttachmentAlt.value = entry.attachmentAlt || "";
		entryRemoveAttachment.checked = false;
		editingHasImage = Boolean(entry.imageUrl);
		editingHasAttachment = Boolean(entry.attachmentUrl);
		editingAttachmentName = entry.attachmentName || "";
		if (entrySubmit) entrySubmit.textContent = "Update post";
		if (entryCancel) entryCancel.hidden = false;
		if (mediaEntryStatus) {
			mediaEntryStatus.textContent = `Editing “${entry.title}”.`;
		}
		syncEntryFields();
		mediaEntryForm.scrollIntoView({ behavior: "smooth", block: "center" });
		entryTitle.focus({ preventScroll: true });
	};

	const renderMediaEntries = (entries: MediaEntry[]) => {
		if (!mediaEntryList) return;
		mediaEntryList.replaceChildren();

		for (const section of mediaSections) {
			const group = document.createElement("div");
			const heading = document.createElement("h3");
			const cards = document.createElement("div");
			const sectionEntries = entries
				.filter((entry) => getEntrySection(entry) === section.value)
				.sort((left, right) =>
					`${right.date}|${right.createdAt || ""}`.localeCompare(
						`${left.date}|${left.createdAt || ""}`,
					),
				);

			group.className = "entry-group";
			heading.className = "entry-group-heading";
			heading.textContent = `${section.label} (${sectionEntries.length})`;
			cards.className = "entry-admin-grid";
			group.append(heading, cards);

			if (!sectionEntries.length) {
				const empty = document.createElement("p");
				empty.className = "entry-empty";
				empty.textContent = `No ${section.label.toLowerCase()} updates yet.`;
				cards.append(empty);
			}

			for (const entry of sectionEntries) {
				const card = document.createElement("article");
				const header = document.createElement("div");
				const date = document.createElement("time");
				const title = document.createElement("h4");
				const description = document.createElement("p");
				const actions = document.createElement("div");
				const star = document.createElement("button");
				const edit = document.createElement("button");
				const remove = document.createElement("button");

				card.className = "entry-admin-card";
				header.className = "entry-card-header";
				date.dateTime = entry.date;
				date.textContent = formatDate(entry.date);
				title.textContent = entry.title;
				description.textContent = entry.description;
				actions.className = "entry-card-actions";

				if (entry.imageUrl) {
					const image = document.createElement("img");
					image.src = entry.imageUrl;
					image.alt = entry.imageAlt || entry.title;
					image.loading = "lazy";
					card.append(image);
				}
				if (entry.attachmentUrl) {
					const type = entry.attachmentType || "";
					if (type.startsWith("image/")) {
						const image = document.createElement("img");
						image.src = entry.attachmentUrl;
						image.alt = entry.attachmentAlt || entry.title;
						image.loading = "lazy";
						card.append(image);
					} else if (type.startsWith("video/")) {
						const video = document.createElement("video");
						video.src = entry.attachmentUrl;
						video.controls = true;
						video.preload = "metadata";
						video.playsInline = true;
						card.append(video);
					} else if (type.startsWith("audio/")) {
						const audio = document.createElement("audio");
						audio.src = entry.attachmentUrl;
						audio.controls = true;
						audio.preload = "metadata";
						card.append(audio);
					} else if (type === "application/pdf") {
						const frame = document.createElement("iframe");
						frame.src = entry.attachmentUrl;
						frame.title = `${entry.title} PDF preview`;
						frame.loading = "lazy";
						card.append(frame);
					}
				}

				header.append(date, title);
				card.append(header, description);

				if (entry.link) {
					const preview = document.createElement("a");
					preview.href = entry.link;
					preview.target = "_blank";
					preview.rel = "noopener noreferrer";
					preview.textContent = "Open link ↗";
					actions.append(preview);
				}
				if (entry.attachmentUrl) {
					const attachmentLink = document.createElement("a");
					attachmentLink.href = entry.attachmentUrl;
					attachmentLink.target = "_blank";
					attachmentLink.rel = "noopener noreferrer";
					attachmentLink.textContent = `Open ${entry.attachmentName || "attachment"} ↗`;
					actions.append(attachmentLink);
				}

				if (
					section.value === "interviews" ||
					section.value === "behind-the-scenes" ||
					section.value === "press"
				) {
					const isFeatured = entry.featured === true;
					star.type = "button";
					star.className = `secondary-button feature-star${
						isFeatured ? " is-featured" : ""
					}`;
					star.setAttribute("aria-pressed", String(isFeatured));
					star.textContent = isFeatured ? "★ In Featured" : "☆ Add to Featured";
					star.addEventListener("click", async () => {
						star.disabled = true;
						star.textContent = isFeatured ? "Removing…" : "Adding…";
						if (mediaEntryStatus) {
							mediaEntryStatus.textContent = isFeatured
								? `Removing “${entry.title}” from Featured…`
								: `Adding “${entry.title}” to Featured…`;
						}

						try {
							const response = await fetch(getEntryEndpoint(section.value), {
								method: "PATCH",
								credentials: "same-origin",
								headers: { "Content-Type": "application/json" },
								body: JSON.stringify({
									id: entry.id,
									featured: !isFeatured,
								}),
							});
							if (!response.ok) throw new Error(await readError(response));
							await loadMediaEntries(
								isFeatured
									? `“${entry.title}” removed from Featured.`
									: `“${entry.title}” added to Featured.`,
							);
						} catch (error) {
							star.disabled = false;
							star.textContent = isFeatured
								? "★ In Featured"
								: "☆ Add to Featured";
							if (mediaEntryStatus) {
								mediaEntryStatus.textContent =
									error instanceof Error
										? error.message
										: "Could not update Featured.";
							}
						}
					});
					actions.append(star);
				}

				edit.type = "button";
				edit.className = "secondary-button";
				edit.textContent = "Edit";
				edit.addEventListener("click", () => startEditingEntry(entry));

				remove.type = "button";
				remove.className = "danger-button";
				remove.textContent = "Delete";
				remove.addEventListener("click", () => requestEntryDeletion(entry));

				actions.append(edit, remove);
				card.append(actions);
				cards.append(card);
			}

			mediaEntryList.append(group);
		}
	};

	const loadMediaEntries = async (successMessage = "") => {
		if (!mediaEntryStatus) return;
		mediaEntryStatus.textContent = "Loading posts…";
		try {
			const results = await Promise.all(
				mediaSections.map(async (section) => {
					const response = await fetch(getEntryEndpoint(section.value), {
						credentials: "same-origin",
					});
					if (!response.ok) throw new Error(await readError(response));
					const result = await response.json();
					const entries = Array.isArray(result.entries) ? result.entries : [];
					return entries.map((entry: MediaEntry) => ({
						...entry,
						section: getEntrySection({ ...entry, section: section.value }),
					}));
				}),
			);
			renderMediaEntries(results.flat());
			mediaEntryStatus.textContent = successMessage;
		} catch (error) {
			mediaEntryStatus.textContent =
				error instanceof Error ? error.message : "Could not load posts.";
		}
	};

	entrySection?.addEventListener("change", syncEntryFields);
	entryImage?.addEventListener("change", syncEntryFields);
	entryAttachment?.addEventListener("change", () => {
		if (entryAttachment.files?.length && entryRemoveAttachment) {
			entryRemoveAttachment.checked = false;
		}
	});
	entryRemoveAttachment?.addEventListener("change", () => {
		if (entryRemoveAttachment.checked && entryAttachment) {
			entryAttachment.value = "";
		}
	});
	entryCancel?.addEventListener("click", () => {
		resetMediaEntryForm();
		if (mediaEntryStatus) mediaEntryStatus.textContent = "Edit cancelled.";
	});

	deleteConfirmDialog?.addEventListener("close", () => {
		if (deleteConfirmDialog.returnValue === "confirm" && pendingDeleteEntry) {
			void deleteEntry(pendingDeleteEntry);
		} else {
			pendingDeleteEntry = null;
		}
	});

	mediaEntryForm?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (
			!mediaEntryForm ||
			!mediaEntryStatus ||
			!entrySection ||
			!entryId
		) {
			return;
		}

		const section = entrySection.value as MediaSection;
		const isEditing = Boolean(entryId.value);
		mediaEntryStatus.textContent = isEditing ? "Updating…" : "Publishing…";
		if (entrySubmit) entrySubmit.disabled = true;
		if (entryCancel) entryCancel.disabled = true;

		try {
			const response = await fetch(getEntryEndpoint(section), {
				method: isEditing ? "PUT" : "POST",
				credentials: "same-origin",
				body: new FormData(mediaEntryForm),
			});
			if (!response.ok) throw new Error(await readError(response));
			resetMediaEntryForm();
			const successMessage = isEditing
				? "Post updated."
				: "Post published.";
			await loadMediaEntries(successMessage);
		} catch (error) {
			mediaEntryStatus.textContent =
				error instanceof Error ? error.message : "Could not save post.";
		} finally {
			if (entrySubmit) entrySubmit.disabled = false;
			if (entryCancel) entryCancel.disabled = false;
		}
	});

	const loadBiography = async () => {
		if (!biography || !aboutStatus) return;
		aboutStatus.textContent = "Loading…";
		try {
			const response = await fetch("/admin/api/content/about", {
				credentials: "same-origin",
			});
			if (!response.ok) throw new Error(await readError(response));
			const result = await response.json();
			biography.value = result.content?.biography || "";
			aboutStatus.textContent = result.content ? "Loaded." : "No saved biography yet.";
		} catch (error) {
			aboutStatus.textContent =
				error instanceof Error ? error.message : "Could not load biography.";
		}
	};

	aboutForm?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!biography || !aboutStatus) return;
		aboutStatus.textContent = "Saving…";
		try {
			const response = await fetch("/admin/api/content/about", {
				method: "PUT",
				credentials: "same-origin",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ biography: biography.value }),
			});
			if (!response.ok) throw new Error(await readError(response));
			aboutStatus.textContent = "Biography saved.";
		} catch (error) {
			aboutStatus.textContent =
				error instanceof Error ? error.message : "Could not save biography.";
		}
	});

	const formatFileSize = (bytes: number) => {
		if (!Number.isFinite(bytes) || bytes < 0) return "Unknown size";
		if (bytes < 1024) return `${bytes} B`;
		const units = ["KB", "MB", "GB"];
		let value = bytes / 1024;
		let unit = units[0];
		for (let index = 1; index < units.length && value >= 1024; index += 1) {
			value /= 1024;
			unit = units[index];
		}
		return `${value >= 10 ? value.toFixed(1) : value.toFixed(2)} ${unit}`;
	};

	const formatUploadDate = (value?: string) => {
		if (!value) return "Upload date unavailable";
		const date = new Date(value);
		if (Number.isNaN(date.getTime())) return "Upload date unavailable";
		return new Intl.DateTimeFormat("en-US", {
			dateStyle: "medium",
			timeStyle: "short",
		}).format(date);
	};

	const createMediaPreview = (item: MediaItem) => {
		const preview = document.createElement("div");
		preview.className = "media-preview";
		const type = item.contentType || "";

		if (type.startsWith("image/")) {
			const image = document.createElement("img");
			image.src = item.url;
			image.alt = `Preview of ${item.name}`;
			image.loading = "lazy";
			preview.append(image);
		} else if (type.startsWith("video/")) {
			const video = document.createElement("video");
			video.src = item.url;
			video.controls = true;
			video.preload = "metadata";
			video.playsInline = true;
			preview.append(video);
		} else if (type.startsWith("audio/")) {
			const audio = document.createElement("audio");
			audio.src = item.url;
			audio.controls = true;
			audio.preload = "metadata";
			preview.classList.add("media-preview-audio");
			preview.append(audio);
		} else if (type === "application/pdf") {
			const frame = document.createElement("iframe");
			frame.src = `${item.url}#view=FitH`;
			frame.title = `${item.name} PDF preview`;
			frame.loading = "lazy";
			preview.append(frame);
		} else {
			const symbol = document.createElement("span");
			symbol.className = "media-file-symbol";
			symbol.textContent = item.name.split(".").pop()?.toUpperCase() || "FILE";
			preview.append(symbol);
		}
		return preview;
	};

	const requestMediaDeletion = (item: MediaItem) => {
		if (!mediaDeleteDialog || !mediaDeleteMessage) return;
		pendingDeleteMedia = item;
		mediaDeleteDialog.returnValue = "";
		const usageWarning = item.usedBy.length
			? ` It is currently used by ${item.usedBy.length} ${item.usedBy.length === 1 ? "post" : "posts"}; deleting it will remove the file from those posts.`
			: "";
		mediaDeleteMessage.textContent =
			`Permanently delete “${item.name}” from the website?${usageWarning} This cannot be undone.`;
		mediaDeleteDialog.showModal();
	};

	const renderMedia = (items: MediaItem[]) => {
		if (!mediaList) return;
		mediaList.replaceChildren();
		if (!items.length) {
			const empty = document.createElement("p");
			empty.className = "media-library-empty";
			empty.textContent = "No uploaded website files yet.";
			mediaList.append(empty);
			return;
		}

		for (const item of items) {
			const card = document.createElement("article");
			const details = document.createElement("div");
			const nameForm = document.createElement("form");
			const nameInput = document.createElement("input");
			const saveName = document.createElement("button");
			const metadata = document.createElement("p");
			const key = document.createElement("p");
			const usage = document.createElement("div");
			const actions = document.createElement("div");
			const open = document.createElement("a");
			const copy = document.createElement("button");
			const remove = document.createElement("button");

			card.className = "media-library-card";
			details.className = "media-library-details";
			nameForm.className = "media-name-form";
			nameInput.type = "text";
			nameInput.value = item.name;
			nameInput.maxLength = 180;
			nameInput.required = true;
			nameInput.setAttribute("aria-label", `File name for ${item.name}`);
			saveName.type = "submit";
			saveName.className = "secondary-button";
			saveName.textContent = "Save name";
			metadata.className = "media-metadata";
			metadata.textContent = `${item.contentType} · ${formatFileSize(item.size)} · ${formatUploadDate(item.uploaded)}`;
			key.className = "media-storage-key";
			key.textContent = item.key;
			usage.className = "media-usage";
			actions.className = "media-library-actions";

			const status = document.createElement("strong");
			status.className = "media-status-badge";
			if (item.usedBy.length) {
				status.textContent = `Used by ${item.usedBy.length} ${item.usedBy.length === 1 ? "post" : "posts"}`;
				status.classList.add("is-assigned");
			} else if (item.managed) {
				status.textContent = "Stored orphan";
				status.classList.add("is-orphaned");
			} else {
				status.textContent = "Unassigned";
			}
			usage.append(status);
			for (const reference of item.usedBy) {
				const referenceLabel = document.createElement("span");
				const sectionLabel =
					mediaSections.find((section) => section.value === reference.section)
						?.label || reference.section;
				referenceLabel.textContent = `${sectionLabel}: ${reference.title} (${reference.role})`;
				usage.append(referenceLabel);
			}

			nameForm.addEventListener("submit", async (event) => {
				event.preventDefault();
				if (!mediaStatus) return;
				const name = nameInput.value.trim();
				if (!name || name === item.name) return;
				mediaStatus.textContent = `Renaming ${item.name}…`;
				saveName.disabled = true;
				try {
					const response = await fetch("/admin/api/media", {
						method: "PUT",
						credentials: "same-origin",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ key: item.key, name }),
					});
					if (!response.ok) throw new Error(await readError(response));
					await Promise.all([loadMedia(), loadMediaEntries("File renamed.")]);
				} catch (error) {
					mediaStatus.textContent =
						error instanceof Error ? error.message : "Could not rename file.";
				} finally {
					saveName.disabled = false;
				}
			});

			open.href = item.url;
			open.target = "_blank";
			open.rel = "noopener noreferrer";
			open.textContent = "Open file ↗";
			copy.type = "button";
			copy.className = "secondary-button";
			copy.textContent = "Copy URL";
			copy.addEventListener("click", async () => {
				try {
					await navigator.clipboard.writeText(
						new URL(item.url, window.location.origin).href,
					);
					copy.textContent = "Copied";
					window.setTimeout(() => { copy.textContent = "Copy URL"; }, 1400);
				} catch {
					if (mediaStatus) mediaStatus.textContent = "Could not copy the file URL.";
				}
			});
			remove.type = "button";
			remove.className = "danger-button";
			remove.textContent = "Delete permanently";
			remove.addEventListener("click", () => requestMediaDeletion(item));

			nameForm.append(nameInput, saveName);
			actions.append(open, copy, remove);
			details.append(nameForm, metadata, key, usage, actions);
			card.append(createMediaPreview(item), details);
			mediaList.append(card);
		}
	};

	const loadMedia = async () => {
		if (!mediaStatus) return;
		mediaStatus.textContent = "Loading media library…";
		try {
			const response = await fetch("/admin/api/media", {
				credentials: "same-origin",
			});
			if (!response.ok) throw new Error(await readError(response));
			const result = await response.json();
			const items = Array.isArray(result.media) ? result.media : [];
			renderMedia(items);
			mediaStatus.textContent = `${items.length} ${items.length === 1 ? "file" : "files"} stored.`;
		} catch (error) {
			mediaStatus.textContent =
				error instanceof Error ? error.message : "Could not load media.";
		}
	};

	mediaDeleteDialog?.addEventListener("close", async () => {
		if (
			mediaDeleteDialog.returnValue !== "confirm" ||
			!pendingDeleteMedia ||
			!mediaStatus
		) {
			pendingDeleteMedia = null;
			return;
		}

		const item = pendingDeleteMedia;
		pendingDeleteMedia = null;
		mediaDeleteSubmit?.setAttribute("disabled", "");
		mediaStatus.textContent = `Deleting ${item.name} everywhere…`;
		try {
			const response = await fetch(
				`/admin/api/media?key=${encodeURIComponent(item.key)}`,
				{ method: "DELETE", credentials: "same-origin" },
			);
			if (!response.ok) throw new Error(await readError(response));
			await Promise.all([loadMedia(), loadMediaEntries("File deleted.")]);
		} catch (error) {
			mediaStatus.textContent =
				error instanceof Error ? error.message : "Could not delete file.";
		} finally {
			mediaDeleteSubmit?.removeAttribute("disabled");
		}
	});

	mediaForm?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!mediaStatus || !mediaForm) return;
		mediaStatus.textContent = "Uploading…";
		try {
			const response = await fetch("/admin/api/media", {
				method: "POST",
				credentials: "same-origin",
				body: new FormData(mediaForm),
			});
			if (!response.ok) throw new Error(await readError(response));
			mediaForm.reset();
			mediaStatus.textContent = "Upload complete.";
			await loadMedia();
		} catch (error) {
			mediaStatus.textContent =
				error instanceof Error ? error.message : "Upload failed.";
		}
	});

	mediaRefresh?.addEventListener("click", () => {
		void loadMedia();
	});

	resetCreditForm();
	resetMediaEntryForm();
	void loadBiography();
	void loadCredits();
	void loadMediaEntries();
	void loadMedia();

	const adminSymbolPool = [
		"✦", "×", "○", "△", "+", "◇", "≈", "□", "§", "∞", "※", "∴",
		"◌", "≡", "⌁", "∷",
	];
	const reducedAdminMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	);
	const randomBetween = (minimum: number, maximum: number) =>
		minimum + Math.random() * (maximum - minimum);

	document
		.querySelectorAll<HTMLButtonElement>(".admin-mini-window")
		.forEach((windowButton) => {
			windowButton.addEventListener("click", () => {
				if (windowButton.dataset.falling === "true") return;
				windowButton.dataset.falling = "true";

				const bounds = windowButton.getBoundingClientRect();
				const fallingWindow = windowButton.cloneNode(true) as HTMLButtonElement;
				fallingWindow.classList.add("is-falling-copy");
				fallingWindow.removeAttribute("data-motion-float");
				fallingWindow.removeAttribute("style");
				fallingWindow.tabIndex = -1;
				fallingWindow.setAttribute("aria-hidden", "true");
				Object.assign(fallingWindow.style, {
					left: `${bounds.left}px`,
					top: `${bounds.top}px`,
					width: `${bounds.width}px`,
					height: `${bounds.height}px`,
				});
				document.body.append(fallingWindow);
				windowButton.classList.add("is-respawning");

				const finishRespawn = () => {
					fallingWindow.remove();
					const symbol = windowButton.querySelector<HTMLElement>(
						".admin-window-symbol",
					);
					const nextSymbol =
						adminSymbolPool[Math.floor(Math.random() * adminSymbolPool.length)];
					if (symbol) symbol.textContent = nextSymbol;
					windowButton.classList.remove("is-respawning");
					windowButton.classList.add("has-respawned");
					delete windowButton.dataset.falling;
					window.setTimeout(
						() => windowButton.classList.remove("has-respawned"),
						360,
					);
				};

				if (reducedAdminMotion.matches) {
					fallingWindow.animate(
						[
							{ opacity: 1, transform: "scale(1)" },
							{ opacity: 0, transform: "scale(.72)" },
						],
						{ duration: 240, easing: "ease-out", fill: "forwards" },
					).addEventListener("finish", finishRespawn, { once: true });
					return;
				}

				const horizontalVelocity = randomBetween(-65, 65);
				const verticalVelocity = randomBetween(20, 90);
				const gravity = randomBetween(920, 1180);
				const spinVelocity = randomBetween(-45, 45);
				const targetDrop = window.innerHeight - bounds.top + bounds.height * 2;
				const flightTime = Math.min(
					3,
					Math.max(
						1.5,
						(-verticalVelocity +
							Math.sqrt(verticalVelocity ** 2 + 2 * gravity * targetDrop)) /
							gravity,
					),
				);
				const keyframes: Keyframe[] = [];

				for (let frame = 0; frame <= 18; frame += 1) {
					const progress = frame / 18;
					const elapsed = progress * flightTime;
					const x = horizontalVelocity * elapsed;
					const y = verticalVelocity * elapsed + .5 * gravity * elapsed ** 2;
					keyframes.push({
						offset: progress,
						opacity: progress > .92 ? 1 - (progress - .92) / .08 : 1,
						transform: `translate(${x}px, ${y}px) rotate(${spinVelocity * elapsed}deg)`,
					});
				}

				fallingWindow
					.animate(keyframes, {
						duration: flightTime * 1000,
						easing: "linear",
						fill: "forwards",
					})
					.addEventListener("finish", finishRespawn, { once: true });
			});
		});
</script>

