		z-index: 2;
		width: min(1050px, calc(100% - clamp(60px, 15vw, 240px)));
		margin: 0 auto;
		padding: clamp(118px, 14vh, 170px) 0 var(--admin-footer-gap);
	}
	.admin-content { will-change: translate; }
	header {
