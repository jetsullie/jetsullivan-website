---
import Arrow from "../components/common/Arrow.astro";
import SiteMenu from "../components/common/SiteMenu.astro";
import HomeGlass from "../components/common/HomeGlass.astro";
import "../styles/socials.css";

const socialLinks = [
	{
		name: "Instagram",
		type: "@jetsullie",
		href: "https://www.instagram.com/jetsullie/?hl=en",
		className: "instagram",
		icon: "vertical-video",
		accent: "253 191 191",
	},
	{
		name: "TikTok",
		type: "@jetsullie",
		href: "https://www.tiktok.com/@jetsullie",
		className: "tiktok",
		icon: "vertical-video",
		accent: "147 233 249",
	},
	{
		name: "Facebook",
		type: "@jetsullie",
		href: "https://www.facebook.com/jetsullie/",
		className: "facebook",
		icon: "vertical-video",
		accent: "8 102 255",
	},
	{
		name: "IMDb",
		type: "Profile",
		href: "https://www.imdb.com/user/p.k3qpjpuypnjk7ykbwmg3ga7qau?ref_=tt_nv_profile",
		className: "imdb",
		icon: "film-frame",
		accent: "245 197 24",
	},
	{
		name: "LinkedIn",
		type: "Jet Sullivan",
		href: "https://www.linkedin.com/in/jetsullivan/",
		className: "linkedin",
		icon: "briefcase",
		accent: "10 102 194",
	},
	{
		name: "YouTube",
		type: "@jetsullie",
		href: "https://www.youtube.com/@JetSullie",
		className: "youtube",
		icon: "horizontal-video",
		accent: "255 0 0",
	},
];
---

<!doctype html>
<html lang="en">
 <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Find Jet Sullivan across social media." />
  <link rel="canonical" href="https://jetsullivan.com/socials/" />
  <link rel="icon" type="image/png" href="/brand-center-favicon.png" />
  <title>Jet Sullivan</title>
 </head>
 <body class="socials-page">
  <a class="social-skip" href="#social-heading">Skip to content</a>
  <header class="social-header">
   <SiteMenu showHomeButton />
   <a class="social-wordmark" href="/">JET SULLIVAN<span>ACTOR · FILMMAKER · CREATOR</span></a>
  </header>
  <main class="social-page" data-social-scene>
   <HomeGlass tone="blue" />
   <section class="hero" aria-labelledby="social-heading">
    <div class="social-heading">
     <p class="eyebrow">Check out Jet’s</p>
     <h1 id="social-heading" tabindex="-1" aria-label="Socials"><span class="hero-name-layer hero-name-base" aria-hidden="true">{Array.from('SOCIALS').map((letter,index) => <span class="hero-letter" data-letter-index={index}>{letter}</span>)}</span></h1>
    </div>
    <div class="social-grid">
     {socialLinks.map(link => (
      <a class={`social-tab ${link.className}`} href={link.href} style={`--social-accent: ${link.accent};`} target="_blank" rel="noopener noreferrer">
       <span class={`social-icon icon-${link.icon}`} aria-hidden="true">
        <svg viewBox="0 0 96 96" focusable="false">
         {link.className === 'instagram' && <defs><radialGradient id="social-instagram-color" cx="28%" cy="108%" r="122%"><stop offset="0%" stop-color="#ffd600" /><stop offset="28%" stop-color="#ff7a00" /><stop offset="52%" stop-color="#ff0169" /><stop offset="76%" stop-color="#d300c5" /><stop offset="100%" stop-color="#7638fa" /></radialGradient></defs>}
         {link.className === 'tiktok' && <defs><linearGradient id="social-tiktok-color"><stop offset="0%" stop-color="#25f4ee" /><stop offset="49.9%" stop-color="#25f4ee" /><stop offset="50%" stop-color="#fe2c55" /><stop offset="100%" stop-color="#fe2c55" /></linearGradient></defs>}
         {link.icon === 'vertical-video' && <>
          <rect x="27" y="10" width="42" height="76" rx="9" />
          <path class="icon-cutout" d="M42 34 60 48 42 62Z" />
         </>}
         {link.icon === 'horizontal-video' && <>
          <rect x="8" y="26" width="80" height="45" rx="9" />
          <path class="icon-cutout" d="M42 35 60 48.5 42 62Z" />
         </>}
         {link.icon === 'film-frame' && <path fill-rule="evenodd" d="M15 22h66a7 7 0 0 1 7 7v38a7 7 0 0 1-7 7H15a7 7 0 0 1-8-8V29a7 7 0 0 1 8-7Zm9 10h48v32H24Zm-11-3h6v7h-6Zm0 15h6v7h-6Zm0 15h6v7h-6Zm64-30h6v7h-6Zm0 15h6v7h-6Zm0 15h6v7h-6Z" />}
         {link.icon === 'briefcase' && <>
          <path fill-rule="evenodd" d="M21 34h15v-7a7 7 0 0 1 7-7h10a7 7 0 0 1 7 7v7h15a7 7 0 0 1 7 7v35a7 7 0 0 1-7 7H21a7 7 0 0 1-7-7V41a7 7 0 0 1 7-7Zm21 0h12v-7a2 2 0 0 0-2-2h-8a2 2 0 0 0-2 2Z" />
          <path class="briefcase-seam" d="M19 50H77" />
         </>}
        </svg>
       </span>
       <span class="social-copy"><strong>{link.name}</strong><small>{link.type}</small></span>
       <span class="social-arrow" aria-hidden="true"><Arrow /></span>
       <span class="sr-only"> (opens in a new tab)</span>
      </a>
     ))}
    </div>
   </section>
  </main>
  <footer class="site-footer">
   <div class="footer-content"><p class="footer-name">Jet Sullivan</p><p data-site-location="long">Austin, Texas</p></div>
  </footer>
 </body>
</html>
<script>
 import "../scripts/socials";
</script>
