---
import SiteMenu from "../components/common/SiteMenu.astro";
import PageMotion from "../components/PageMotion.astro";

const windows = [
	[3, 17, 42, 34, "▶"], [10, 48, 52, 40, "○"], [17, 8, 46, 38, "✦"],
	[23, 76, 62, 46, "×"], [30, 28, 70, 52, "◇"], [37, 87, 58, 44, "≈"],
	[44, 12, 76, 56, "□"], [51, 64, 84, 61, "⌁"], [58, 35, 66, 49, "●"],
	[65, 81, 94, 68, "↗"], [72, 7, 72, 53, "∞"], [79, 50, 104, 74, "△"],
	[86, 20, 48, 37, "•"], [93, 60, 60, 45, "≡"], [6, 90, 82, 59, "◌"],
	[20, 56, 90, 65, "✣"], [69, 29, 106, 75, "↻"], [89, 78, 116, 80, "⌂"],
	[40, 42, 54, 41, "♥"], [82, 91, 68, 50, "☺"],
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Media by Austin filmmaker Jet Sullivan." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Media — Jet Sullivan</title>
	</head>
	<body>
		<main class="page" data-motion-root>
			<div class="top-frame" data-motion-depth="counter" aria-hidden="true"></div>
			<div class="bottom-frame" data-motion-depth="counter" aria-hidden="true"></div>
			<div class="yellow-panel" data-motion-depth="counter" aria-hidden="true"></div>

			<div class="floaters" data-motion-bounds aria-hidden="true">
				{windows.map((item, index) => (
					<span
						class="mini-window"
						data-motion-float
						style={`--x:${item[0]}%;--y:${item[1]}%;--w:${item[2]}px;--h:${item[3]}px;--delay:-${index * 0.37}s;`}
					>
						<span class="mini-dots"><i></i><i></i><i></i></span>
						<span>{item[4]}</span>
					</span>
				))}
			</div>

			<SiteMenu showHomeButton />

			<section class="content" data-motion-depth="scene" aria-labelledby="media-heading">
				<p class="eyebrow">Watch · Listen · Explore</p>
				<h1 id="media-heading">Media</h1>
				<nav class="public-media" aria-label="Media collections">
					<a
						class="media-tab placeholder tab-featured"
						href="/media/featured/"
					>
						<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<span class="media-icon" aria-hidden="true">
							<svg viewBox="0 0 96 96" focusable="false">
								<path
									class="icon-fill"
									d="m48 12 10.8 22 24.2 3.5-17.5 17 4.1 24-21.6-11.4-21.6 11.4 4.1-24L13 37.5 37.2 34Z"
								/>
							</svg>
						</span>
						<strong>Featured</strong>
						<small>Explore featured work</small>
					</a>
					<a
						class="media-tab placeholder tab-interviews"
						href="/media/interviews/"
					>
						<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<span class="media-icon" aria-hidden="true">
							<svg viewBox="0 0 96 96" focusable="false">
								<circle class="icon-fill" cx="48" cy="31" r="15" />
								<path
									class="icon-fill"
									d="M20 79c1.7-19.1 12.2-29 28-29s26.3 9.9 28 29Z"
								/>
							</svg>
						</span>
						<strong>Interviews</strong>
						<small>Watch interviews</small>
					</a>
					<a
						class="media-tab placeholder tab-behind-scenes"
						href="/media/behind-the-scenes/"
					>
						<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<span class="media-icon" aria-hidden="true">
							<svg viewBox="0 0 96 96" focusable="false">
								<path d="M17 33h16l6-9h18l6 9h16v42H17Z" />
								<circle cx="48" cy="54" r="13" />
							</svg>
						</span>
						<strong>Behind the Scenes</strong>
						<small>See the process</small>
					</a>
					<a
						class="media-tab placeholder tab-press"
						href="/media/press/"
					>
						<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<span class="media-icon" aria-hidden="true">
							<svg viewBox="0 0 96 96" focusable="false">
								<rect x="17" y="18" width="62" height="60" rx="5" />
								<path d="M28 34h40M28 48h40M28 62h30" />
							</svg>
						</span>
						<strong>Press</strong>
						<small>Read the latest</small>
					</a>
				</nav>
			</section>

			<p class="location" data-motion-depth="deep">Austin, TX</p>
		</main>
		<PageMotion />
	</body>
</html>

<style>
	:root {
		--yellow: #efda4a;
		--white: #fff;
		--black: #252525;
		--pink: #fdbfbf;
		--mint: #7cf5b5;
		--display: "Arial Black", "Myriad Pro", Arial, sans-serif;
		--body: "Myriad Pro", Myriad, Arial, sans-serif;
	}

	:global(*) { box-sizing: border-box; }
	:global(html) { background: var(--black); color: var(--black); font-family: var(--body); }
	:global(body) { margin: 0; min-width: 320px; min-height: 100vh; }

	.page {
		position: relative;
		display: grid;
		width: 100%;
		min-height: 100svh;
		padding: clamp(90px, 10vh, 130px) clamp(28px, 6vw, 105px) clamp(80px, 8vh, 110px);
		overflow: hidden;
		background: linear-gradient(180deg, #fff 0%, #effcff 32%, #d4f7fd 68%, #c0f2fb 100%);
		isolation: isolate;
	}

	.top-frame, .bottom-frame {
		position: absolute;
		z-index: 8;
		left: -3%;
		width: 106%;
		height: 9vw;
		min-height: 54px;
		background: var(--black);
		pointer-events: none;
	}
	.top-frame { top: -5vw; transform: rotate(-3deg); }
	.bottom-frame { bottom: -5vw; transform: rotate(-3deg); }

	.yellow-panel {
		position: absolute;
		z-index: 1;
		top: 24%;
		bottom: -2%;
		left: 50%;
		width: min(76vw, 1050px);
		border: 1px solid rgb(255 255 255 / 48%);
		border-radius: 24px;
		background: linear-gradient(180deg, rgb(235 255 245 / 88%), rgb(124 245 181 / 82%) 42%, rgb(54 181 114 / 76%) 135%);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 52%), 0 12px 36px rgb(37 37 37 / 7%);
		backdrop-filter: blur(8px);
		transform: translateX(-50%);
	}

	.floaters { position: absolute; z-index: 0; inset: 0; overflow: hidden; pointer-events: none; }
	.mini-window {
		position: absolute;
		top: var(--y);
		left: var(--x);
		display: grid;
		width: var(--w);
		height: var(--h);
		border: 1px solid rgb(255 255 255 / 45%);
		border-radius: clamp(5px, .7vw, 14px);
		background: rgb(156 166 170 / 20%);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 34%), 0 5px 14px rgb(37 37 37 / 5%);
		color: rgb(37 37 37 / 25%);
		font: 900 .7rem var(--display);
		backdrop-filter: blur(3px);
		place-items: center;
	}
	.mini-dots { position: absolute; top: 6px; left: 7px; display: flex; gap: 3px; }
	.mini-dots i { width: 4px; height: 4px; border-radius: 50%; background: var(--pink); }
	.mini-dots i:nth-child(2), .dots i:nth-child(2) { background: var(--yellow); }
	.mini-dots i:nth-child(3), .dots i:nth-child(3) { background: var(--mint); }

	.home-window {
		position: absolute;
		z-index: 12;
		top: clamp(70px, 8vh, 105px);
		left: clamp(28px, 5vw, 82px);
		display: grid;
		grid-template: auto 1fr / auto 1fr;
		gap: 8px 12px;
		width: clamp(175px, 13vw, 220px);
		height: clamp(88px, 7vw, 112px);
		padding: 17px;
		border: 1px solid rgb(255 255 255 / 52%);
		border-radius: 28px;
		outline: 1px solid rgb(255 255 255 / 14%);
		outline-offset: -3px;
		background: linear-gradient(rgb(255 255 255 / 5%), rgb(255 255 255 / 1%)), rgb(37 37 37 / 82%);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 48%), 0 14px 34px rgb(37 37 37 / 12%);
		color: var(--white);
		font: 900 clamp(.9rem, 1.2vw, 1.2rem) var(--display);
		text-decoration: none;
		text-transform: uppercase;
		backdrop-filter: blur(10px);
		transition: transform 350ms cubic-bezier(.34, 1.56, .64, 1), background-color 220ms ease;
	}
	.home-window:hover { transform: translateY(4px) scale(1.03); background-color: rgb(37 37 37 / 94%); }
	.home-window .dots { grid-column: 1 / -1; }
	.home-window > span:last-child, .arrow { align-self: center; }
	.arrow { font: 900 2.4rem/1 var(--display); }

	.dots { display: flex; gap: 6px; }
	.dots i {
		width: 10px;
		height: 10px;
		border: 1px solid rgb(37 37 37 / 18%);
		border-radius: 50%;
		background: var(--pink);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 48%), 0 1px 3px rgb(37 37 37 / 32%);
	}

	.content { position: relative; z-index: 3; align-self: center; justify-self: center; width: min(100%, 1280px); }
	.eyebrow {
		margin: 0 0 clamp(12px, 2vh, 24px);
		font-size: clamp(.78rem, 1.1vw, 1rem);
		font-weight: 900;
		letter-spacing: .16em;
		text-transform: uppercase;
	}
	h1 {
		margin: 0;
		font: 950 clamp(5rem, 15vw, 15rem)/.72 var(--display);
		letter-spacing: -.035em;
		text-transform: uppercase;
	}
	.info-window {
		position: relative;
		width: min(88%, 690px);
		margin: clamp(48px, 6vh, 84px) auto 0;
		padding: clamp(52px, 6vw, 76px) clamp(25px, 4vw, 54px) clamp(28px, 4vw, 48px);
		border: 1px solid rgb(255 255 255 / 46%);
		border-radius: 30px;
		outline: 1px solid rgb(255 255 255 / 12%);
		outline-offset: -3px;
		background: rgb(37 37 37 / 82%);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 28%), 0 18px 45px rgb(37 37 37 / 15%);
		color: var(--white);
		backdrop-filter: blur(10px);
	}
	.info-window > .dots { position: absolute; top: 22px; left: 25px; }
	.info-window h2, .info-window p { margin: 0; }
	.info-window h2 { font: 900 clamp(1.45rem, 2.4vw, 2.2rem) var(--display); text-transform: uppercase; }
	.info-window p { margin-top: 1rem; font-size: clamp(1.05rem, 1.6vw, 1.42rem); font-weight: 600; line-height: 1.45; }
	.info-window .status { padding-top: .9rem; border-top: 1px solid rgb(255 255 255 / 20%); color: var(--yellow); }
	.location {
		position: absolute;
		z-index: 5;
		right: clamp(32px, 6vw, 110px);
		bottom: clamp(54px, 7vh, 92px);
		margin: 0;
		font: 950 clamp(1.3rem, 2.2vw, 2.6rem)/1 var(--display);
		letter-spacing: -.06em;
	}
	.public-media {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(16px, 2.2vw, 30px);
		width: min(92%, 980px);
		margin-top: clamp(52px, 7vh, 84px);
	}
	.public-media .media-tab {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: center;
		aspect-ratio: 1;
		overflow: hidden;
		border: 1px solid rgb(255 255 255 / 46%);
		border-radius: 26px;
		outline: 1px solid rgb(255 255 255 / 12%);
		outline-offset: -3px;
		background:
			linear-gradient(rgb(255 255 255 / 7%), rgb(255 255 255 / 2%)),
			rgb(37 37 37 / 78%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 34%),
			0 12px 30px rgb(37 37 37 / 10%);
		color: var(--white);
		text-decoration: none;
		backdrop-filter: blur(9px);
	}
	.media-tab {
		--tab-accent: 255 255 255;
		padding: 48px 20px 24px;
		animation: tab-float 4.8s ease-in-out infinite;
		transition:
			box-shadow 240ms ease,
			border-color 240ms ease,
			transform 480ms cubic-bezier(.34, 1.56, .64, 1);
		will-change: transform, translate;
	}
	.tab-featured {
		--tab-accent: 239 218 74;
		animation-delay: -.4s;
	}
	.tab-interviews {
		--tab-accent: 147 233 249;
		animation-delay: -1.5s;
	}
	.tab-behind-scenes {
		--tab-accent: 255 176 92;
		animation-delay: -2.7s;
	}
	.tab-press {
		--tab-accent: 255 255 255;
		animation-delay: -3.8s;
	}
	.public-media .media-tab:hover,
	.public-media .media-tab:focus-within {
		animation-play-state: paused;
		background:
			linear-gradient(
				rgb(255 255 255 / 9%),
				rgb(255 255 255 / 3%)
			),
			rgb(37 37 37 / 84%);
		transform: translateY(3px);
	}
	.public-media .media-tab:focus-visible {
		outline: 3px solid rgb(var(--tab-accent) / 92%);
		outline-offset: 5px;
	}
	.public-media .tab-featured:hover,
	.public-media .tab-featured:focus-within {
		border-color: rgb(239 218 74 / 62%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 34%),
			inset 0 0 22px rgb(239 218 74 / 10%),
			0 0 12px rgb(239 218 74 / 52%),
			0 0 34px rgb(239 218 74 / 86%);
	}
	.public-media .tab-interviews:hover,
	.public-media .tab-interviews:focus-within {
		border-color: rgb(147 233 249 / 62%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 34%),
			inset 0 0 22px rgb(147 233 249 / 10%),
			0 0 12px rgb(147 233 249 / 52%),
			0 0 34px rgb(147 233 249 / 86%);
	}
	.public-media .tab-behind-scenes:hover,
	.public-media .tab-behind-scenes:focus-within {
		border-color: rgb(255 176 92 / 62%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 34%),
			inset 0 0 22px rgb(255 176 92 / 10%),
			0 0 12px rgb(255 176 92 / 52%),
			0 0 34px rgb(255 176 92 / 86%);
	}
	.public-media .tab-press:hover,
	.public-media .tab-press:focus-within {
		border-color: rgb(255 255 255 / 62%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 34%),
			inset 0 0 22px rgb(255 255 255 / 10%),
			0 0 12px rgb(255 255 255 / 52%),
			0 0 34px rgb(255 255 255 / 86%);
	}
	.media-icon {
		display: grid;
		width: clamp(48px, 4.8vw, 68px);
		margin-bottom: clamp(8px, 1.1vw, 14px);
		color: rgb(255 255 255 / 34%);
		place-items: center;
		transition: color 220ms ease;
	}
	.media-tab:hover .media-icon,
	.media-tab:focus-within .media-icon {
		color: rgb(var(--tab-accent) / 96%);
	}
	.media-icon svg {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		overflow: visible;
		fill: none;
		stroke: currentColor;
		stroke-width: 6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.media-icon .icon-fill {
		fill: currentColor;
		stroke: none;
	}
	.tab-behind-scenes .media-icon svg {
		transform: translateY(10px);
	}
	.media-tab .dots {
		position: absolute;
		top: 17px;
		left: 17px;
		gap: 8px;
	}
	.media-tab .dots i {
		width: 13px;
		height: 13px;
	}
	.media-tab strong {
		font: 900 clamp(.9rem, 1.6vw, 1.35rem)/1.05 var(--display);
		text-transform: uppercase;
	}
	.media-tab small {
		margin-top: 9px;
		color: rgb(255 255 255 / 62%);
		font-weight: 700;
	}
	@keyframes tab-float {
		0%,
		100% { translate: 0 0; }
		50% { translate: 0 -4px; }
	}

	@media (max-width: 820px) {
		.page { display: block; min-height: 100svh; padding: 105px 24px 90px; overflow-y: auto; }
		.yellow-panel { top: 33%; width: calc(100% - 28px); }
		.home-window { top: 64px; left: 22px; width: 142px; height: 78px; padding: 12px; border-radius: 22px; }
		.home-window .dots { gap: 4px; }
		.dots i { width: 7px; height: 7px; }
		.arrow { font-size: 1.8rem; }
		.home-window > span:last-child { font-size: .72rem; }
		.content { padding-top: 94px; }
		.eyebrow { text-align: center; }
		h1 { font-size: clamp(3.5rem, 18vw, 7rem); text-align: center; }
		.info-window { width: 100%; margin-top: 42px; }
		.public-media { grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; }
		.media-tab .dots { gap: 4px; }
		.media-tab .dots i { width: 7px; height: 7px; }
		.location { right: 24px; bottom: 46px; font-size: 1.25rem; }
	}

	@media (max-width: 480px) {
		.page { padding-top: 92px; }
		.content { padding-top: 112px; }
		.eyebrow { max-width: 62%; font-size: .67rem; }
		.info-window { padding: 50px 22px 28px; border-radius: 24px; }
		.info-window p { font-size: 1rem; }
		.public-media { gap: 12px; }
		.public-media .media-tab { border-radius: 18px; }
		.media-tab { padding: 40px 10px 16px; }
		.media-icon { width: 40px; margin-bottom: 6px; }
		.media-tab strong { font-size: .82rem; }
		.media-tab small { margin-top: 6px; font-size: .72rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.home-window,
		.media-tab,
		.media-icon { transition: none; }
		.media-tab { animation: none; }
	}
</style>
