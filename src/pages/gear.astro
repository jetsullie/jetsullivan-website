---
import SiteMenu from "../components/common/SiteMenu.astro";
import PageMotion from "../components/common/PageMotion.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Explore the cameras, audio equipment, lighting, and production kits Jet Sullivan works with."
		/>
		<link rel="icon" type="image/png" href="/brand-center-favicon.png" />
		<title>Gear — Jet Sullivan</title>
	</head>

	<body>
		<a class="skip-link" href="#gear-list">Skip to gear</a>
		<main class="gear-page" data-motion-root>
			<div class="top-frame" data-motion-depth="counter" aria-hidden="true"></div>
			<div class="sky-circle" data-motion-depth="counter" aria-hidden="true"></div>

			<SiteMenu showHomeButton />

			<header class="gear-hero" data-motion-depth="scene">
				<p class="eyebrow">Behind the work</p>
				<h1>Gear</h1>
				<p class="hero-copy">
					A closer look at the equipment, kits, and tools I use to make things.
				</p>
			</header>
			<div class="section-divider hero-divider" aria-hidden="true"></div>

			<section class="gear-section" aria-labelledby="collection-title" >
				<div class="section-heading">
					<p class="section-number">01</p>
					<div><h2 id="collection-title">The collection</h2><p class="collection-intro">Browse by category. Open a card for a closer look.</p></div>
				</div>
				<div id="gear-list" class="gear-list" aria-live="polite" aria-busy="true">
					<div class="gear-message">
						<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<p>Loading the gear shelf…</p>
					</div>
				</div>
			</section>
		</main>

		<div class="section-divider" aria-hidden="true"></div>
		<footer class="site-footer">
			<div class="footer-content">
				<p>Jet Sullivan</p>
				<span aria-hidden="true"></span>
				<p data-site-location="long">Austin, Texas</p>
			</div>
		</footer>

		<PageMotion />
	</body>
</html>

<script>
	type GearItem = {
		id: string;
		name: string;
		category: string;
		rating: number;
		description: string;
		kitParts: string[];
		imageUrl?: string | null;
		imageAlt?: string | null;
	};

	const gearList = document.querySelector<HTMLElement>("#gear-list");

	const createDots = () => {
		const dots = document.createElement("span");
		dots.className = "window-dots";
		dots.setAttribute("aria-hidden", "true");
		dots.append(document.createElement("i"), document.createElement("i"), document.createElement("i"));
		return dots;
	};

	const renderMessage = (message: string) => {
		if (!gearList) return;
		const panel = document.createElement("div");
		const copy = document.createElement("p");
		panel.className = "gear-message";
		copy.textContent = message;
		panel.append(createDots(), copy);
		gearList.replaceChildren(panel);
		gearList.setAttribute("aria-busy", "false");
	};

	const createRating = (ratingValue: number) => {
		const rating = Math.max(0.5, Math.min(5, Number(ratingValue) || 0.5));
		const wrapper = document.createElement("div");
		const stars = document.createElement("span");
		const score = document.createElement("span");
		wrapper.className = "gear-rating";
		wrapper.setAttribute("aria-label", `Current condition: ${rating.toFixed(1)} out of 5`);
		stars.className = "rating-stars";
		stars.setAttribute("aria-hidden", "true");
		stars.style.setProperty("--rating", String(rating));
		stars.textContent = "★★★★★";
		score.textContent = `${rating.toFixed(1)} / 5`;
		const label = document.createElement("span");
		label.className = "condition-label";
		label.textContent = "Current condition";
		wrapper.append(label, stars, score);
		return wrapper;
	};

	const renderGear = (items: GearItem[]) => {
		if (!gearList) return;
		if (!items.length) {
			renderMessage("The gear shelf is ready. Check back soon for the first addition.");
			return;
		}

		const fragment = document.createDocumentFragment();
		const groups = new Map<string, { label: string; items: GearItem[] }>();
		for (const item of items) {
			const label = item.category?.trim() || "Gear";
			const key = label.toLocaleLowerCase();
			if (!groups.has(key)) groups.set(key, { label, items: [] });
			groups.get(key)!.items.push(item);
		}
		[...groups.values()].sort((a, b) => a.label.localeCompare(b.label)).forEach((group, groupIndex) => {
			const section = document.createElement("section");
			section.className = "gear-category";
			const categoryHeading = document.createElement("h3");
			categoryHeading.id = `gear-category-${groupIndex}`;
			categoryHeading.textContent = group.label;
			section.setAttribute("aria-labelledby", categoryHeading.id);
			const count = document.createElement("span");
			count.textContent = `${group.items.length} ${group.items.length === 1 ? "item" : "items"}`;
			categoryHeading.append(count);
			const grid = document.createElement("div");
			grid.className = "gear-grid";
			section.append(categoryHeading, grid);
			fragment.append(section);
		group.items.sort((a, b) => a.name.localeCompare(b.name)).forEach((item, index) => {
			const details = document.createElement("details");
			const summary = document.createElement("summary");
			const number = document.createElement("span");
			const heading = document.createElement("span");
			const name = document.createElement("strong");
			const category = document.createElement("small");
			const toggle = document.createElement("span");
			const body = document.createElement("div");
			const copy = document.createElement("div");
			const description = document.createElement("p");

			details.className = "gear-card";
			summary.className = "gear-summary";
			number.className = "gear-number";
			number.textContent = String(index + 1).padStart(2, "0");
			heading.className = "gear-title";
			name.textContent = item.name;
			category.textContent = item.category || "Gear";
			heading.append(name, category);
			toggle.className = "gear-toggle";
			toggle.setAttribute("aria-hidden", "true");
			const preview = document.createElement("span");
			preview.className = "gear-preview";
			if (item.imageUrl) {
				const thumbnail = document.createElement("img");
				thumbnail.src = item.imageUrl;
				thumbnail.alt = item.imageAlt || item.name;
				thumbnail.loading = "lazy";
				thumbnail.addEventListener("error", () => { thumbnail.remove(); preview.append(number); });
				preview.append(thumbnail);
			} else preview.append(number);
			category.textContent = "View details";
			summary.append(createDots(), preview, heading, toggle);

			body.className = "gear-body";
			copy.className = "gear-copy";
			description.className = "gear-description";
			description.textContent = item.description;
			copy.append(createRating(item.rating), description);

			if (Array.isArray(item.kitParts) && item.kitParts.length) {
				const partsHeading = document.createElement("h4");
				const parts = document.createElement("ul");
				partsHeading.textContent = "What’s in the kit";
				parts.className = "gear-parts";
				for (const part of item.kitParts) {
					const row = document.createElement("li");
					row.textContent = part;
					parts.append(row);
				}
				copy.append(partsHeading, parts);
			}

			body.append(copy);
			details.append(summary, body);
			grid.append(details);
			let animation: Animation | undefined;
			summary.addEventListener("click", (event) => {
				event.preventDefault();
				const closing = details.dataset.expanded === "true";
				details.dataset.expanded = String(!closing);
				const start = details.getBoundingClientRect().height;
				animation?.cancel();
				details.open = true;
				const borderHeight = details.offsetHeight - details.clientHeight;
				const end = closing ? summary.getBoundingClientRect().height + borderHeight : details.getBoundingClientRect().height;
				category.textContent = closing ? "View details" : "Close details";
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
					details.open = !closing;
					return;
				}
				animation = details.animate({ height: [`${start}px`, `${end}px`] }, {
					duration: 360, easing: "cubic-bezier(.22, 1, .36, 1)",
				});
				animation.onfinish = () => { details.open = !closing; animation = undefined; };
			});
		});

		});

		gearList.replaceChildren(fragment);
		gearList.setAttribute("aria-busy", "false");
	};

	if (gearList) {
		fetch("/api/gear")
			.then((response) => (response.ok ? response.json() : { items: [] }))
			.then((result) => renderGear(Array.isArray(result.items) ? result.items : []))
			.catch(() => renderMessage("The gear shelf is ready. Check back soon for the first addition."));
	}
</script>

<style is:global>
	:root {
		--jet-black: #252525;
		--grid-gray: #383838;
		--studio-white: #fff;
		--spotlight-yellow: #efda4a;
		--sky-blue: #93e9f9;
		--soft-pink: #fdbfbf;
		--fresh-mint: #7cf5b5;
		--display: "Arial Black", Arial, sans-serif;
		--body: "Myriad Pro", Myriad, Arial, sans-serif;
	}

	* { box-sizing: border-box; }
	html { overflow-x: clip; background: var(--jet-black); }
	body {
		margin: 0;
		min-width: 320px;
		background: var(--jet-black);
		color: var(--studio-white);
		font-family: var(--body);
	}
	.skip-link {
		position: fixed;
		z-index: 200;
		top: 10px;
		left: 50%;
		padding: 10px 16px;
		border-radius: 999px;
		background: var(--studio-white);
		color: var(--jet-black);
		font-weight: 900;
		transform: translate(-50%, -160%);
	}
	.skip-link:focus { transform: translate(-50%, 0); }
	.gear-page {
		position: relative;
		isolation: isolate;
		min-height: 100vh;
		padding: clamp(150px, 18vw, 230px) max(24px, 5vw) clamp(100px, 13vw, 180px);
		overflow: hidden;
		background-color: var(--grid-gray);
		background-image: radial-gradient(circle, var(--jet-black) 1.45px, transparent 1.6px);
		background-size: 24px 24px;
	}
	.top-frame {
		position: absolute;
		z-index: -1;
		top: -7vw;
		left: -3%;
		width: 106%;
		height: clamp(120px, 16vw, 250px);
		background: var(--jet-black);
		transform: rotate(-3deg);
	}
	.sky-circle {
		position: absolute;
		z-index: -1;
		top: clamp(90px, 8vw, 140px);
		right: -7vw;
		width: clamp(260px, 36vw, 580px);
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--sky-blue);
		box-shadow: 13px 13px 0 rgb(37 37 37 / 28%);
	}
	.window-dots i {
		display: block;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #8d9294;
	}
	.gear-hero,
	.gear-section {
		position: relative;
		z-index: 1;
		width: min(1160px, 100%);
		margin-inline: auto;
	}
	.eyebrow {
		margin: 0 0 12px;
		color: var(--spotlight-yellow);
		font: 900 clamp(1rem, 2vw, 1.35rem) / 1 var(--display);
		letter-spacing: .075em;
		text-transform: uppercase;
	}
	.gear-hero h1 {
		margin: 0;
		font: 900 clamp(5.8rem, 17vw, 13rem) / .78 var(--display);
		letter-spacing: -.07em;
		text-transform: uppercase;
		text-shadow: 8px 8px 0 rgb(37 37 37 / 42%);
	}
	.hero-copy {
		width: min(580px, 100%);
		margin: clamp(34px, 5vw, 62px) 0 0;
		font-size: clamp(1.1rem, 2.2vw, 1.45rem);
		font-weight: 750;
		line-height: 1.45;
		text-shadow: 3px 3px 0 rgb(37 37 37 / 40%);
	}
	.gear-section { margin-top: 0; }
	.section-heading {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: clamp(18px, 3vw, 42px);
		align-items: start;
		margin-bottom: clamp(38px, 6vw, 76px);
	}
	.section-number {
		margin: .09em 0 0;
		color: var(--sky-blue);
		font: 900 clamp(1.7rem, 4vw, 3.1rem) / 1 var(--display);
	}
	.section-heading h2 {
		margin: 0;
		font: 900 clamp(3.2rem, 9vw, 7.4rem) / .86 var(--display);
		letter-spacing: -.055em;
		text-transform: uppercase;
		text-shadow: 7px 7px 0 rgb(37 37 37 / 32%);
	}
	.collection-intro { margin: 22px 0 0; font-size: 1.1rem; line-height: 1.5; }
	.gear-list { display: grid; gap: clamp(48px, 7vw, 88px); }
	.gear-category h3 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 16px; margin: 0 0 24px; padding-bottom: 16px; border-bottom: 1px solid #ffffff40; font: 900 clamp(1.5rem, 3vw, 2.3rem)/1.2 var(--display); overflow-wrap: anywhere; }
	.gear-category h3 > span { color: var(--sky-blue); font: 700 .9rem/1.4 var(--body); }
	.gear-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; gap: 28px; }
	.gear-card, .gear-message { min-width: 0; border: 4px solid white; border-radius: 24px; background: white; color: var(--jet-black); box-shadow: 0 16px 32px #0003, 6px 6px 0 #25252580; overflow: clip; }
	.gear-card { transition: box-shadow 180ms ease; }
	.gear-card:hover { box-shadow: 0 20px 40px #0004, 6px 6px 0 var(--sky-blue); }
	.gear-summary { position: relative; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; gap: 14px; aspect-ratio: 1; padding: 18px; cursor: pointer; list-style: none; }
	.gear-summary::-webkit-details-marker { display: none; }
	.gear-summary:focus-visible { outline: 3px solid #252525; outline-offset: -5px; border-radius: 20px; }
	.gear-summary .window-dots { display: flex; gap: 5px; }
	.gear-preview { display: grid; min-width: 0; min-height: 0; place-items: center; overflow: hidden; border-radius: 12px; background: #f1f3f3; }
	.gear-preview img { width: 100%; height: 100%; min-height: 0; object-fit: contain; }
	.gear-number { color: #252525; font: 900 4rem/1 var(--display); }
	.gear-title { display: grid; gap: 7px; padding-right: 48px; }
	.gear-title strong { font: 900 clamp(1.05rem, 1.7vw, 1.4rem)/1.15 var(--display); overflow-wrap: anywhere; }
	.gear-title small { color: #555; font-size: .85rem; }
	.gear-summary .gear-toggle { position: absolute; right: 14px; bottom: 18px; width: 36px; height: 36px; }

	.condition-label { flex-basis: 100%; font-weight: 900; }
	.gear-rating { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; font-weight: 900; white-space: nowrap; }
	.rating-stars {
		position: relative;
		color: rgb(37 37 37 / 16%);
		font-size: 1.15rem;
		letter-spacing: .08em;
	}
	.rating-stars::before {
		position: absolute;
		inset: 0 auto 0 0;
		width: calc(var(--rating) / 5 * 100%);
		overflow: hidden;
		color: #cc9504;
		content: "★★★★★";
		white-space: nowrap;
	}
	.gear-toggle {
		position: relative;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--jet-black);
	}
	.gear-toggle::before,
	.gear-toggle::after {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 17px;
		height: 3px;
		border-radius: 3px;
		background: var(--studio-white);
		content: "";
		transform: translate(-50%, -50%);
		transition: transform 180ms ease;
	}
	.gear-toggle::after { transform: translate(-50%, -50%) rotate(90deg); }
	.gear-card[open] .gear-toggle::after { transform: translate(-50%, -50%) rotate(0); }
	.gear-card[open] .gear-preview { background: var(--sky-blue); }
	.gear-body { padding: 8px 20px 26px; }
	.gear-copy .gear-rating { margin-bottom: 20px; font-size: .85rem; }

	.gear-copy { min-width: 0; }
	.gear-description {
		margin: 0;
		font-size: 1rem;
		font-weight: 650;
		line-height: 1.55;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.gear-copy h4 {
		margin: 34px 0 14px;
		font: 900 clamp(1.4rem, 3vw, 2rem) / 1 var(--display);
		text-transform: uppercase;
	}
	.gear-parts {
		display: grid;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.gear-parts li {
		position: relative;
		padding: 13px 15px 13px 42px;
		border-radius: 13px;
		background: #f1f1f1;
		font-weight: 800;
		line-height: 1.35;
		overflow-wrap: anywhere;
	}
	.gear-parts li::before {
		position: absolute;
		top: 50%;
		left: 16px;
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: var(--fresh-mint);
		content: "";
		transform: translateY(-50%);
	}
	.gear-message { padding: clamp(42px, 7vw, 80px); text-align: center; }
	.gear-message .window-dots { display: flex; gap: 6px; justify-content: center; margin-bottom: 20px; }
	.gear-message p { margin: 0; font: 900 clamp(1.15rem, 3vw, 1.8rem) / 1.35 var(--display); }
	.section-divider {
		position: relative;
		height: clamp(55px, 7vw, 105px);
		margin-top: clamp(-48px, -4vw, -18px);
		background: var(--jet-black);
		transform: skewY(-2.5deg);
		transform-origin: left top;
	}
	.section-divider.hero-divider {
		height: 2px;
		margin: clamp(48px, 7vw, 88px) auto;
		width: min(1160px, 100%);
		background: #ffffff30;
		transform: none;
	}

	.site-footer { padding: 68px max(24px, 5vw) 50px; background: var(--jet-black); }
	.footer-content {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 24px;
		align-items: center;
		width: min(1160px, 100%);
		margin: auto;
		font-weight: 900;
		text-transform: uppercase;
	}
	.footer-content p { margin: 0; }
	.footer-content p:last-child { text-align: right; }
	.footer-content > span { width: 8px; height: 8px; border-radius: 50%; background: var(--sky-blue); }

	@media (max-width: 1000px) {
		.gear-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}

	@media (max-width: 760px) {
		.gear-page { padding-top: 150px; }
		.sky-circle { top: 140px; right: -105px; width: 330px; }
		.gear-hero h1 { font-size: clamp(5.3rem, 28vw, 8.5rem); }
		.footer-content { grid-template-columns: 1fr; text-align: center; }
		.footer-content p:last-child { text-align: center; }
		.footer-content > span { justify-self: center; }
	}

	@media (max-width: 580px) {
		.gear-grid { grid-template-columns: 1fr; }
	}

	@media (max-width: 480px) {
		.gear-page { padding-inline: 19px; }
		.gear-hero h1 { letter-spacing: -.09em; }
		.section-heading { gap: 13px; }
		.rating-stars { font-size: .82rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.gear-toggle::after { transition: none; }
	}
</style>
