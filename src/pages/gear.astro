---
import Arrow from "../components/common/Arrow.astro";
import SiteMenu from "../components/common/SiteMenu.astro";
import PageMotion from "../components/common/PageMotion.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Explore the cameras, audio equipment, lighting, and production kits Jet Sullivan works with."
		/>
		<link rel="icon" type="image/png" href="/brand-center-favicon.png" />
		<title>Gear — Jet Sullivan</title>
	</head>

	<body>
		<a class="skip-link" href="#gear-list">Skip to gear</a>
		<main class="gear-page" data-motion-root data-motion-speed="0.8">
			<SiteMenu showHomeButton />
			<header class="gear-hero">
				<div class="hero-inner">
					<div class="hero-text" data-motion-depth="scene">
						<p class="eyebrow">Behind the work</p>
						<h1>The<br />gear.</h1>
						<p class="hero-copy">The cameras, sound, and light behind the stories. Explore my equipment, what’s in each kit, and its current condition.</p>
						<a class="collection-link" href="#collection-title">Explore the collection <Arrow direction="down" /></a>
					</div>
					<figure class="hero-window" data-motion-depth="deep">
						<button class="featured-gear-link" id="featured-gear-link" type="button" disabled>
							<span class="hero-window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>Tools of the trade</span></span>
							<span class="hero-window-image"><img id="featured-gear-image" alt="" hidden /><span id="featured-gear-placeholder">Picture.<br />Sound.<br />Light.</span></span>
							<span class="featured-caption"><span id="featured-gear-name">Inside the kit</span><Arrow /></span>
						</button>
						<figcaption class="featured-controls" hidden>
							<span id="featured-position"></span>
							<button type="button" id="featured-pause" aria-label="Pause featured gear slideshow">Pause</button>
							<button type="button" id="featured-next" aria-label="Show next gear item"><Arrow direction="right" /></button>
						</figcaption>
					</figure>
				</div>
			</header>

			<section class="gear-section" aria-labelledby="collection-title">
				<div class="collection-heading">
					<div data-motion-depth="scene"><p class="eyebrow">Take a closer look</p><h2 id="collection-title" tabindex="-1">The collection</h2></div>
					<p data-motion-depth="counter">Choose a category, then open a card.<br />Every rating shows the gear’s current condition.</p>
				</div>
				<div id="gear-value-summary" class="gear-value-summary" aria-live="polite" hidden><span class="eyebrow">ESTIMATED USD COLLECTION VALUE</span><strong></strong><small></small></div>
				<div id="gear-list" class="gear-list" aria-live="polite" aria-busy="true">
					<div class="gear-message">
						<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<p>Loading the gear shelf…</p>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer" data-motion-root>
			<div class="footer-content" data-motion-depth="scene">
				<p>Jet Sullivan</p>
				<span aria-hidden="true"></span>
				<p data-site-location="long">Austin, Texas</p>
			</div>
		</footer>

		<dialog id="gear-detail" class="gear-dialog" aria-labelledby="gear-detail-title">
			<button class="gear-dialog-close" type="button" aria-label="Close gear details" autofocus><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
			<header class="gear-dialog-heading"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><p id="gear-detail-category" class="eyebrow"></p><h2 id="gear-detail-title"></h2></header>
			<div class="gear-dialog-layout"><div class="gear-dialog-image"></div><div class="gear-dialog-information"></div></div>
		</dialog>
		<PageMotion />
	</body>
</html>

<script>
	import { revealCollectionValue } from '../scripts/collection-value-roll';
	type GearItem = {
		id: string;
		name: string;
		category: string;
		rating: number;
		description: string;
		kitParts: string[];
		imageUrl?: string | null;
		imageAlt?: string | null;
	};

	const gearList = document.querySelector<HTMLElement>("#gear-list");
	const itemTargets = new Map<string, (trigger: HTMLElement) => void>();

	const createDots = () => {
		const dots = document.createElement("span");
		dots.className = "window-dots";
		dots.setAttribute("aria-hidden", "true");
		dots.append(document.createElement("i"), document.createElement("i"), document.createElement("i"));
		return dots;
	};

	const renderMessage = (message: string) => {
		if (!gearList) return;
		const panel = document.createElement("div");
		const copy = document.createElement("p");
		panel.className = "gear-message";
		copy.textContent = message;
		panel.append(createDots(), copy);
		gearList.replaceChildren(panel);
		gearList.setAttribute("aria-busy", "false");
	};

	const createRating = (ratingValue: number) => {
		const rating = Math.max(0.5, Math.min(5, Number(ratingValue) || 0.5));
		const wrapper = document.createElement("div");
		const stars = document.createElement("span");
		const score = document.createElement("span");
		wrapper.className = "gear-rating";
		wrapper.setAttribute("aria-label", `Current condition: ${rating.toFixed(1)} out of 5`);
		stars.className = "rating-stars";
		stars.setAttribute("aria-hidden", "true");
		stars.style.setProperty("--rating", String(rating));
		stars.textContent = "★★★★★";
		score.textContent = `${rating.toFixed(1)} / 5`;
		const label = document.createElement("span");
		label.className = "condition-label";
		label.textContent = "Current condition";
		wrapper.append(label, stars, score);
		return wrapper;
	};

	// Keep native summary keyboard behavior while animating categories.
	const animateDisclosure = (details: HTMLDetailsElement, summary: HTMLElement, updateLabel: (expanded: boolean) => void) => {
		let animation: Animation | undefined;
		let expanded = false;
		summary.addEventListener("click", (event) => {
			event.preventDefault();
			const start = details.getBoundingClientRect().height;
			animation?.cancel();
			expanded = !expanded;
			details.open = true;
			details.dataset.expanded = String(expanded);
			updateLabel(expanded);
			const border = details.offsetHeight - details.clientHeight;
			const end = expanded ? details.getBoundingClientRect().height : summary.getBoundingClientRect().height + border;
			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				details.open = expanded;
				return;
			}
			animation = details.animate({ height: [`${start}px`, `${end}px`] }, { duration: 360, easing: "cubic-bezier(.22, 1, .36, 1)" });
			animation.onfinish = () => { details.open = expanded; animation = undefined; };
		});
		return (next: boolean) => {
			animation?.cancel();
			expanded = next;
			details.open = next;
			details.dataset.expanded = String(next);
			updateLabel(next);
		};
	};

	const gearDialog = document.querySelector<HTMLDialogElement>('#gear-detail')!;
	const dialogTitle = gearDialog.querySelector<HTMLElement>('#gear-detail-title')!;
	let dialogOpener: HTMLElement | null = null;
	let closingDialog = false;
	let previousOverflow = '';
	const dialogMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	const openGearDialog = (item: GearItem, trigger: HTMLElement, body: HTMLElement, accent: string) => {
		if (gearDialog.open || closingDialog) return;
		dialogOpener = trigger;
		gearDialog.style.setProperty('--section-color', accent || '#fdbfbf');
		dialogTitle.textContent = item.name;
		gearDialog.querySelector('#gear-detail-category')!.textContent = item.category || 'Gear';
		const imageArea = gearDialog.querySelector('.gear-dialog-image')!;
		imageArea.replaceChildren();
		if (item.imageUrl) {
			const image = document.createElement('img');
			image.alt = item.imageAlt || item.name;
			image.src = item.imageUrl;
			image.addEventListener('error', () => { image.remove(); imageArea.textContent = item.name; });
			imageArea.append(image);
		} else imageArea.textContent = item.name;
		gearDialog.querySelector('.gear-dialog-information')!.replaceChildren(body.cloneNode(true));
		previousOverflow = document.documentElement.style.overflow;
		document.documentElement.style.overflow = 'hidden';
		gearDialog.showModal();
		gearDialog.scrollTop = 0;
	};
	const closeGearDialog = async () => {
		if (!gearDialog.open || closingDialog) return;
		closingDialog = true;
		if (!dialogMotion.matches) {
			await gearDialog.animate(
				[{ opacity: 1, transform: 'translateY(0) scale(1)' }, { opacity: 0, transform: 'translateY(12px) scale(.98)' }],
				{ duration: 160, easing: 'ease-in' },
			).finished.catch(() => {});
		}
		gearDialog.close();
		closingDialog = false;
	};
	gearDialog.querySelector('.gear-dialog-close')!.addEventListener('click', () => void closeGearDialog());
	gearDialog.addEventListener('cancel', event => { event.preventDefault(); void closeGearDialog(); });
	const outsideDialog = (event: MouseEvent) => {
		const rect = gearDialog.getBoundingClientRect();
		return event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom;
	};
	let backdropPress = false;
	gearDialog.addEventListener('pointerdown', event => { backdropPress = event.target === gearDialog && outsideDialog(event); });
	gearDialog.addEventListener('click', event => {
		if (backdropPress && event.target === gearDialog && outsideDialog(event)) void closeGearDialog();
		backdropPress = false;
	});
	gearDialog.addEventListener('close', () => {
		document.documentElement.style.overflow = previousOverflow;
		dialogOpener?.focus({ preventScroll: true });
	});

	const setupFeaturedGear = (items: GearItem[]) => {
		const slides = items.filter((item) => item.imageUrl);
		const link = document.querySelector<HTMLButtonElement>("#featured-gear-link")!;
		const image = document.querySelector<HTMLImageElement>("#featured-gear-image")!;
		const frame = document.querySelector<HTMLElement>(".hero-window")!;
		const caption = document.querySelector<HTMLElement>("#featured-gear-name")!;
		const pause = document.querySelector<HTMLButtonElement>("#featured-pause")!;
		const next = document.querySelector<HTMLButtonElement>("#featured-next")!;
		const position = document.querySelector<HTMLElement>("#featured-position")!;
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		let paused = reducedMotion.matches;
		let visible = true;
		let requested = Math.max(0, slides.findIndex((item) => /camera/i.test(item.category)));
		let current: GearItem | undefined;
		let generation = 0;
		const updatePause = () => {
			pause.textContent = paused ? "Play" : "Pause";
			pause.setAttribute("aria-label", `${paused ? "Play" : "Pause"} featured gear slideshow`);
		};
		const showSlide = (index: number) => {
			if (!slides.length) return;
			requested = (index + slides.length) % slides.length;
			const slideIndex = requested;
			const item = slides[slideIndex];
			const request = ++generation;
			const preload = new Image();
			preload.onload = () => {
				if (request !== generation) return;
				current = item;
				image.src = item.imageUrl!;
				image.alt = item.imageAlt || item.name;
				image.hidden = false;
				document.querySelector<HTMLElement>("#featured-gear-placeholder")!.hidden = true;
				caption.textContent = item.name;
				link.disabled = false;
				link.setAttribute("aria-label", `View ${item.name} in ${item.category}`);
				position.textContent = `${String(slideIndex + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
				if (!reducedMotion.matches) image.animate([{ opacity: .25 }, { opacity: 1 }], { duration: 350 });
			};
			preload.src = item.imageUrl!;
		};
		if (!slides.length) return;
		document.querySelector<HTMLElement>(".featured-controls")!.hidden = false;
		next.disabled = slides.length < 2;
		pause.disabled = slides.length < 2;
		updatePause();
		showSlide(requested);
		pause.addEventListener("click", () => { paused = !paused; updatePause(); });
		next.addEventListener("click", () => showSlide(requested + 1));
		link.addEventListener("click", () => {
			if (!current) return;
			const target = itemTargets.get(current.id);
			if (!target) return;
			target(link);
		});
		new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; }).observe(frame);
		reducedMotion.addEventListener("change", () => { paused = reducedMotion.matches; updatePause(); });
		const timer = window.setInterval(() => {
			if (!paused && visible && !document.hidden && !frame.matches(":hover, :focus-within")) showSlide(requested + 1);
		}, 6000);
		window.addEventListener("pagehide", () => clearInterval(timer), { once: true });
	};

	const renderGear = (items: GearItem[]) => {
		if (!gearList) return;
		if (!items.length) {
			renderMessage("The gear shelf is ready. Check back soon for the first addition.");
			return;
		}

		const fragment = document.createDocumentFragment();
		const groups = new Map<string, { label: string; items: GearItem[] }>();
		for (const item of items) {
			const label = item.category?.trim() || "Gear";
			const key = label.toLocaleLowerCase();
			if (!groups.has(key)) groups.set(key, { label, items: [] });
			groups.get(key)!.items.push(item);
		}
		[...groups.values()].sort((a, b) => a.label.localeCompare(b.label)).forEach((group, groupIndex) => {
			const section = document.createElement("details");
			section.className = "gear-category";
			const categorySummary = document.createElement("summary");
			categorySummary.className = "category-summary";
			categorySummary.dataset.motionDepth = "scene";
			const sectionNumber = document.createElement("span");
			sectionNumber.className = "category-number";
			sectionNumber.textContent = String(groupIndex + 1).padStart(2, "0");
			sectionNumber.setAttribute("aria-hidden", "true");
			const categoryHeading = document.createElement("h3");
			categoryHeading.id = `gear-category-${groupIndex}`;
			categoryHeading.textContent = group.label;
			section.setAttribute("aria-labelledby", categoryHeading.id);
			const count = document.createElement("span");
			count.textContent = `${group.items.length} ${group.items.length === 1 ? "item" : "items"} · Explore category`;
			count.className = "category-count";
			const categoryTitle = document.createElement("div");
			categoryTitle.className = "category-title";
			categoryTitle.append(categoryHeading, count);
			const categoryToggle = document.createElement("span");
			categoryToggle.className = "gear-toggle";
			categoryToggle.setAttribute("aria-hidden", "true");
			categorySummary.append(sectionNumber, categoryTitle, categoryToggle);
			const grid = document.createElement("div");
			grid.className = "gear-grid";
			grid.dataset.motionDepth = "counter";
			section.append(categorySummary, grid);
			animateDisclosure(section, categorySummary, (expanded) => {
				count.textContent = `${group.items.length} ${group.items.length === 1 ? "item" : "items"} · ${expanded ? "Close category" : "Explore category"}`;
			});
			fragment.append(section);
			group.items.sort((a, b) => a.name.localeCompare(b.name)).forEach((item, index) => {
				const details = document.createElement("article");
				const summary = document.createElement("button");
				summary.type = "button";
				summary.setAttribute("aria-haspopup", "dialog");
				summary.setAttribute("aria-controls", "gear-detail");
				const number = document.createElement("span");
				const heading = document.createElement("span");
				const name = document.createElement("strong");
				const category = document.createElement("small");
				const toggle = document.createElement("span");
				const body = document.createElement("div");
				const copy = document.createElement("div");
				const description = document.createElement("p");

				details.className = "gear-card";
				summary.className = "gear-summary";
				number.className = "gear-number";
				number.textContent = String(index + 1).padStart(2, "0");
				heading.className = "gear-title";
				name.textContent = item.name;
				category.textContent = item.category || "Gear";
				heading.append(name, category);
				toggle.className = "gear-toggle";
				toggle.setAttribute("aria-hidden", "true");
				const preview = document.createElement("span");
				preview.className = "gear-preview";
				if (item.imageUrl) {
					const thumbnail = document.createElement("img");
					thumbnail.src = item.imageUrl;
					thumbnail.alt = item.imageAlt || item.name;
					thumbnail.loading = "lazy";
					thumbnail.addEventListener("error", () => { thumbnail.remove(); preview.append(number); });
					preview.append(thumbnail);
				} else preview.append(number);
				category.textContent = "View details";
				summary.append(createDots(), preview, heading, toggle);

				body.className = "gear-body";
				copy.className = "gear-copy";
				description.className = "gear-description";
				description.textContent = item.description;
				copy.append(createRating(item.rating), description);

				if (Array.isArray(item.kitParts) && item.kitParts.length) {
					const partsHeading = document.createElement("h4");
					const parts = document.createElement("ul");
					partsHeading.textContent = "What’s in the kit";
					parts.className = "gear-parts";
					for (const part of item.kitParts) {
						const row = document.createElement("li");
						row.textContent = part;
						parts.append(row);
					}
					copy.append(partsHeading, parts);
				}

				body.append(copy);
				details.append(summary);
				grid.append(details);
				const openItem = (trigger: HTMLElement) => openGearDialog(item, trigger, body, getComputedStyle(section).getPropertyValue('--section-color').trim());
				summary.addEventListener('click', () => openItem(summary));
				itemTargets.set(item.id, openItem);
			});

		});

		gearList.replaceChildren(fragment);
		setupFeaturedGear(items);
		gearList.setAttribute("aria-busy", "false");
	};

  const renderGearValue = (summary?: { totalValue: number; valuedItemCount: number; itemCount: number; currency: string }) => {
    const panel = document.querySelector<HTMLElement>('#gear-value-summary');
    if (!panel || !summary || !Number.isFinite(summary.totalValue)) return;
    const amount = panel.querySelector<HTMLElement>('strong')!;
    const note = panel.querySelector<HTMLElement>('small')!;
    amount.textContent = summary.valuedItemCount
      ? new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(summary.totalValue)
      : 'Not yet estimated';
    note.textContent = summary.valuedItemCount < summary.itemCount
      ? `Based on ${summary.valuedItemCount} of ${summary.itemCount} items. Items without a value are excluded.`
      : 'Across the entire collection.';
    panel.hidden = false;
    if (summary.valuedItemCount) revealCollectionValue(amount);
  };

	if (gearList) {
		fetch("/api/gear")
			.then((response) => {
				if (!response.ok) throw new Error("Gear request failed");
				return response.json();
			})
			.then((result) => { renderGear(Array.isArray(result.items) ? result.items : []); renderGearValue(result.summary); })
			.catch(() => renderMessage("The collection couldn’t load. Please refresh to try again."));
	}
</script>

<style is:global>
.gear-value-summary { margin: 0; padding: clamp(28px, 4vw, 48px) var(--gutter) clamp(44px, 6vw, 72px); background: #ebe8e0; color: var(--jet-black); text-align: center; }
.gear-value-summary[hidden] { display: none; }
.gear-value-summary > .eyebrow { display: block; margin: 0 0 20px; }
.gear-value-summary > strong { display: block; margin: 0; font: 900 clamp(2.3rem, 6vw, 4.5rem)/.95 var(--display); letter-spacing: -.055em; overflow-wrap: anywhere; }
.gear-value-summary > small { display: block; max-width: 42ch; margin: 20px auto 0; font-size: .85rem; line-height: 1.5; }

	:root {
		--jet-black: #252525;
		--studio-white: #fff;
		--spotlight-yellow: #efda4a;
		--sky-blue: #93e9f9;
		--soft-pink: #fdbfbf;
		--fresh-mint: #7cf5b5;
		--display: "Arial Black", Arial, sans-serif;
		--body: "Myriad Pro", Myriad, Arial, sans-serif;
	}
	* { box-sizing: border-box; }
	html { background: var(--jet-black); scroll-behavior: smooth; }
	body { margin: 0; min-width: 320px; color: var(--jet-black); font-family: var(--body); }
	.gear-page { --gutter: clamp(24px, 7vw, 110px); overflow: clip; }
	.skip-link { position: fixed; z-index: 200; top: 10px; left: 50%; padding: 12px 20px; border-radius: 30px; background: white; color: #252525; transform: translate(-50%, -160%); }
	.skip-link:focus { transform: translate(-50%, 0); }
	.gear-hero { position: relative; isolation: isolate; overflow: hidden; padding: clamp(130px, 14vw, 180px) var(--gutter) clamp(80px, 9vw, 130px); background: radial-gradient(circle, #383838 1.5px, transparent 1.6px) 0 0 / 24px 24px, var(--jet-black); color: white; }
	.gear-hero::after { content: ""; position: absolute; z-index: -1; width: min(60vw, 840px); aspect-ratio: 1; right: -12%; bottom: -45%; border-radius: 50%; background: var(--spotlight-yellow); }
	.hero-inner { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(260px, .7fr); gap: clamp(40px, 7vw, 110px); align-items: center; max-width: 1180px; margin: auto; }
	.eyebrow { margin: 0 0 24px; font: 800 .8rem/1.4 var(--body); letter-spacing: .16em; text-transform: uppercase; }
	.hero-text > .eyebrow { color: var(--soft-pink); }
	.gear-hero h1 { margin: 0; font: 900 clamp(5rem, 11vw, 10.5rem)/.82 var(--display); text-transform: uppercase; letter-spacing: -.055em; }
	.hero-copy { max-width: 470px; margin: 30px 0; font-size: clamp(1.05rem, 1.5vw, 1.25rem); line-height: 1.65; }
	.collection-link { display: inline-flex; align-items: center; gap: 20px; padding: 16px 24px; border: 1px solid #ffffff94; border-radius: 999px; background: #ffffffd9; color: var(--jet-black); font-weight: 800; text-decoration: none; backdrop-filter: blur(12px); transition: background 180ms ease, transform 180ms ease; }
	.collection-link:hover { background: white; transform: translateY(-3px); }
	.collection-link .site-arrow { font-size: 1.25rem; }
	.collection-link:focus-visible { outline: 3px solid var(--sky-blue); outline-offset: 6px; }
	.hero-window { margin: 0; padding: 16px; border-radius: 24px; background: white; color: var(--jet-black); box-shadow: 12px 18px 0 #0003; transform: rotate(3deg); }
	.hero-window-bar, .featured-caption { display: flex; justify-content: space-between; align-items: center; gap: 16px; font-size: .7rem; font-weight: 800; }
	.hero-window-bar { padding: 0 2px 14px; letter-spacing: .07em; text-transform: uppercase; }
	.window-dots { display: flex; gap: 5px; }
	.window-dots i { width: 7px; height: 7px; border-radius: 50%; background: #8d9294; }
	.featured-gear-link { display: block; width: 100%; border: 0; padding: 0; background: white; color: inherit; font: inherit; text-align: left; cursor: pointer; border-radius: 12px; }
	.featured-gear-link:disabled { cursor: default; }
	.featured-gear-link:focus-visible, .featured-controls button:focus-visible { outline: 3px solid var(--jet-black); outline-offset: 4px; }
	.featured-controls { display: flex; align-items: center; gap: 12px; border-top: 1px solid #25252520; margin-top: 14px; padding-top: 12px; font-size: .75rem; }
