---
import Arrow from "../components/common/Arrow.astro";
import SiteMenu from "../components/common/SiteMenu.astro";
import PageMotion from "../components/common/PageMotion.astro";
import BrandPageTheme from "../components/common/BrandPageTheme.astro";

const backgroundWindows = [
	{ x: 2, y: 16, w: 38, h: 31, symbol: "+", font: 8 },
	{ x: 8, y: 42, w: 44, h: 35, symbol: "○", font: 7 },
	{ x: 14, y: 8, w: 50, h: 39, symbol: "✦", font: 9 },
	{ x: 19, y: 72, w: 56, h: 42, symbol: "×", font: 10 },
	{ x: 25, y: 25, w: 62, h: 47, symbol: "◇", font: 8 },
	{ x: 31, y: 84, w: 68, h: 50, symbol: "≈", font: 11 },
	{ x: 37, y: 13, w: 74, h: 54, symbol: "▶", font: 9 },
	{ x: 43, y: 61, w: 80, h: 58, symbol: "⌁", font: 12 },
	{ x: 49, y: 34, w: 86, h: 61, symbol: "●", font: 7 },
	{ x: 55, y: 79, w: 92, h: 65, symbol: "↗", font: 11 },
	{ x: 61, y: 7, w: 98, h: 69, symbol: "□", font: 10 },
	{ x: 67, y: 48, w: 104, h: 73, symbol: "∞", font: 12 },
	{ x: 73, y: 86, w: 110, h: 77, symbol: "△", font: 9 },
	{ x: 79, y: 19, w: 46, h: 34, symbol: "•", font: 6 },
	{ x: 85, y: 57, w: 58, h: 43, symbol: "≡", font: 8 },
	{ x: 91, y: 31, w: 70, h: 51, symbol: "⌘", font: 10 },
	{ x: 4, y: 89, w: 82, h: 59, symbol: "◌", font: 12 },
	{ x: 21, y: 53, w: 94, h: 67, symbol: "✣", font: 11 },
	{ x: 70, y: 27, w: 106, h: 75, symbol: "↻", font: 12 },
	{ x: 88, y: 76, w: 118, h: 82, symbol: "⌂", font: 10 },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Contact Austin actor and filmmaker Jet Sullivan for acting, film, videography, content, and creative collaborations."
		/>
		<link rel="icon" type="image/png" href="/brand-center-favicon.png" />
		<title>Contact Jet Sullivan</title>
	</head>

	<body class="brand-system">
		<BrandPageTheme />
		<main class="contact-page" data-motion-root>
			<div class="top-frame" data-motion-depth="counter" aria-hidden="true"></div>
			<div class="yellow-panel" data-motion-depth="counter" aria-hidden="true"></div>

			<div class="background-windows" data-motion-bounds aria-hidden="true">
				{
					backgroundWindows.map((item) => (
						<span
							class="mini-window"
							data-motion-float
							style={`--x:${item.x}%; --y:${item.y}%; --w:${item.w}px; --h:${item.h}px; --symbol-size:${item.font}px;`}
						>
							<span class="mini-dots"><i></i><i></i><i></i></span>
							<span class="mini-symbol">{item.symbol === "↗" ? <Arrow /> : item.symbol}</span>
						</span>
					))
				}
			</div>

			<SiteMenu showHomeButton />

			<section class="contact-content" data-motion-depth="scene" aria-labelledby="contact-heading">
				<p class="eyebrow">Actor · Filmmaker · Collaborator</p>
				<h1 id="contact-heading">Contact</h1>

				<div class="contact-grid">
					<article class="info-window">
						<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<div class="info-copy">
							<p class="window-label">Start a conversation</p>
							<h2>Let’s make something together.</h2>
							<p>
								For project inquiries, acting opportunities, production work, and
								creative collaborations, send me an email.
							</p>
							<a class="email-link" href="mailto:contact@jetsullivan.com">
								<span class="email-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="m4.5 7 7.5 6 7.5-6"></path></svg>
								</span>
								<span class="email-copy"><small>Email</small><strong>contact@jetsullivan.com</strong></span>
								<Arrow class="email-arrow" size="24px" />
							</a>
							<div class="copy-row">
								<button id="copy-email" type="button" data-email="contact@jetsullivan.com">
									<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg>
									<span>Copy email address</span>
								</button>
								<output id="copy-status" aria-live="polite"></output>
							</div>
						</div>
					</article>

					<aside class="details-window" aria-label="Ways to work with Jet">
						<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<p class="window-label">Reach out about</p>
						<ul>
							<li><i aria-hidden="true"></i>Acting &amp; casting</li>
							<li><i aria-hidden="true"></i>Film production</li>
							<li><i aria-hidden="true"></i>Videography &amp; editing</li>
							<li><i aria-hidden="true"></i>Creative collaborations</li>
						</ul>
						<div class="location-detail">
							<small>Based in</small>
							<strong data-site-location="long">Austin, Texas</strong>
						</div>
					</aside>
				</div>
			</section>
		</main>

		<div class="section-divider footer-divider" aria-hidden="true"></div>

		<footer class="site-footer">
			<div class="footer-content">
				<p class="footer-name">Jet Sullivan</p>
				<a class="footer-email" href="mailto:contact@jetsullivan.com">contact@jetsullivan.com</a>
				<p class="footer-location" data-site-location="long">Austin, Texas</p>
			</div>
		</footer>

		<PageMotion />
	</body>
</html>

<script>
	const copyEmailButton = document.querySelector<HTMLButtonElement>("#copy-email");
	const copyStatus = document.querySelector<HTMLOutputElement>("#copy-status");
	let copyStatusTimer: number | undefined;

	copyEmailButton?.addEventListener("click", async () => {
		const email = copyEmailButton.dataset.email;
		if (!email || !copyStatus) return;

		try {
			await navigator.clipboard.writeText(email);
			copyEmailButton.classList.add("is-copied");
			copyStatus.textContent = "Copied!";
			window.clearTimeout(copyStatusTimer);
			copyStatusTimer = window.setTimeout(() => {
				copyEmailButton.classList.remove("is-copied");
				copyStatus.textContent = "";
			}, 2200);
		} catch {
			copyStatus.textContent = "Copy unavailable — select the address above.";
		}
	});

	const floatingWindows = Array.from(
		document.querySelectorAll<HTMLElement>("[data-motion-float]"),
	);

	if (floatingWindows.length >= 4) {
		const emojiPool = ["💛", "💖", "💕", "❤️", "😊", "😄", "🙂", "🥰", "😁", "☺️"];
		const shuffledWindows = [...floatingWindows].sort(() => Math.random() - 0.5);
		const shuffledEmoji = [...emojiPool].sort(() => Math.random() - 0.5);

		shuffledWindows.slice(0, 4).forEach((windowTab, index) => {
			const symbol = windowTab.querySelector<HTMLElement>(".mini-symbol");
			if (!symbol) return;
			symbol.textContent = shuffledEmoji[index];
			symbol.style.fontSize = "12px";
		});
	}

</script>

<style>
	:root {
		--yellow: #efda4a;
		--yellow-dark: #cc9504;
		--white: #ffffff;
		--black: #252525;
		--blue: #93e9f9;
		--pink: #fdbfbf;
		--mint: #7cf5b5;
		--font-body: "Myriad Pro", Myriad, Arial, sans-serif;
		--font-display: "Arial Black", "Myriad Pro", Arial, sans-serif;
		--contact-footer-gap: clamp(36px, 4vh, 52px);
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		background: var(--black);
		color: var(--black);
		font-family: var(--font-body);
	}

	:global(body) {
		margin: 0;
		min-width: 320px;
		min-height: 100vh;
	}

	.contact-page {
		position: relative;
		width: 100%;
		min-height: 100vh;
		min-height: 100svh;
		padding: clamp(105px, 11vh, 145px) clamp(28px, 6vw, 105px)
			var(--contact-footer-gap);
		overflow: clip;
		background: linear-gradient(
			180deg,
			var(--white) 0%,
			#effcff 32%,
			#d4f7fd 68%,
			#c0f2fb 100%
		);
	}

	.top-frame {
		position: absolute;
		z-index: 8;
		left: -3%;
		width: 106%;
		height: 9vw;
		min-height: 54px;
		background: var(--black);
		pointer-events: none;
	}

	.top-frame {
		top: -5vw;
		transform: rotate(-3deg);
	}

	.yellow-panel {
		position: absolute;
		z-index: 1;
		top: 23%;
		bottom: -3%;
		left: 50%;
		width: min(76vw, 1050px);
		border: 1px solid rgb(255 255 255 / 58%);
		border-radius: 24px;
		outline: 1px solid rgb(255 255 255 / 16%);
		outline-offset: -3px;
		background: rgb(226 248 252 / 68%);
		box-shadow: 0 8px 28px rgb(37 37 37 / 14%);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		transform: translateX(-50%);
	}

	.background-windows {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.mini-window {
		position: absolute;
		top: var(--y);
		left: var(--x);
		display: grid;
		width: var(--w);
		height: var(--h);
		border: 1px solid rgb(255 255 255 / 45%);
		border-radius: clamp(5px, 0.7vw, 14px);
		background: rgb(156 166 170 / 20%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 34%),
			0 5px 14px rgb(37 37 37 / 5%);
		color: rgb(37 37 37 / 25%);
		font: 900 var(--symbol-size) var(--font-display);
		-webkit-backdrop-filter: blur(3px);
		backdrop-filter: blur(3px);
		place-items: center;
	}

	.mini-symbol {
		padding-top: 6px;
		line-height: 1;
	}

	.mini-dots,
	.window-dots {
		display: flex;
		gap: 6px;
	}

	.mini-dots {
		position: absolute;
		top: 7px;
		left: 8px;
		gap: 3px;
	}

	.mini-dots i,
	.window-dots i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--pink);
	}

	.mini-dots i {
		width: 4px;
		height: 4px;
	}

	.mini-dots i:nth-child(2),
	.window-dots i:nth-child(2) {
		background: var(--yellow);
	}

	.mini-dots i:nth-child(3),
	.window-dots i:nth-child(3) {
		background: var(--mint);
	}

	.window-dots i {
		border: 1px solid rgb(37 37 37 / 18%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 48%),
			0 1px 3px rgb(37 37 37 / 32%);
	}

	.home-window {
		position: absolute;
		z-index: 12;
		top: clamp(70px, 8vh, 105px);
		left: clamp(28px, 5vw, 82px);
		display: grid;
		grid-template-columns: auto 1fr;
		grid-template-rows: auto 1fr;
		gap: 8px 12px;
		width: clamp(175px, 13vw, 220px);
		height: clamp(88px, 7vw, 112px);
		padding: 17px;
		border: 1px solid rgb(255 255 255 / 52%);
		border-radius: 28px;
		outline: 1px solid rgb(255 255 255 / 14%);
		outline-offset: -3px;
		background:
			linear-gradient(rgb(255 255 255 / 5%), rgb(255 255 255 / 1%)),
			rgb(37 37 37 / 82%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 48%),
			0 14px 34px rgb(37 37 37 / 12%);
		color: var(--white);
		font: 900 clamp(0.9rem, 1.2vw, 1.2rem) var(--font-display);
		text-decoration: none;
		text-transform: uppercase;
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		transition:
			transform 350ms cubic-bezier(0.34, 1.56, 0.64, 1),
			background-color 220ms ease;
	}

	.home-window .window-dots {
		grid-column: 1 / -1;
	}

	.home-window > span:last-child,
	.back-arrow {
		align-self: center;
	}

	.back-arrow {
		font: 900 2.4rem/1 var(--font-display);
	}

	.home-window:hover {
		background:
			linear-gradient(rgb(255 255 255 / 7%), rgb(255 255 255 / 2%)),
			rgb(37 37 37 / 94%);
		transform: translateY(4px) scale(1.03);
	}

	.contact-content {
		position: relative;
		z-index: 30;
		width: min(100%, 1280px);
		margin: 0 auto;
		padding-top: clamp(32px, 3vw, 64px);
		text-align: center;
	}

	.eyebrow {
		margin: 0 auto clamp(12px, 2vh, 24px);
		font-size: clamp(0.78rem, 1.1vw, 1rem);
		font-weight: 900;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font: 950 clamp(4rem, 13vw, 13rem) / 0.72 var(--font-display);
		letter-spacing: -0.035em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(240px, 310px);
		gap: clamp(16px, 2vw, 28px);
		align-items: stretch;
		width: min(94%, 1040px);
		margin: clamp(48px, 6vh, 84px) auto 0;
		text-align: left;
	}

	.info-window,
	.details-window {
		position: relative;
		border: 1px solid rgb(255 255 255 / 58%);
		border-radius: 30px;
		outline: 1px solid rgb(255 255 255 / 16%);
		outline-offset: -3px;
		background: rgb(255 255 255 / 64%);
		box-shadow: 0 8px 28px rgb(37 37 37 / 14%);
		color: var(--black);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		animation: contact-float 4.8s ease-in-out infinite;
		will-change: translate;
	}

	.info-window {
		padding: clamp(52px, 6vw, 76px) clamp(25px, 4vw, 54px)
			clamp(28px, 4vw, 48px);
	}

	.details-window {
		padding: 58px clamp(22px, 2.5vw, 32px) 30px;
		animation-delay: -2.4s;
	}

	.info-window > .window-dots,
	.details-window > .window-dots {
		position: absolute;
		top: 22px;
		left: 25px;
	}

	.info-copy {
		display: grid;
		gap: clamp(14px, 1.7vw, 20px);
	}

	.info-copy h2,
	.info-copy p,
	.details-window p {
		margin: 0;
	}

	.info-copy h2 {
		max-width: 14ch;
		font: 900 clamp(1.6rem, 2.8vw, 2.6rem) / 1.02 var(--font-display);
		letter-spacing: -0.035em;
		text-transform: uppercase;
	}

	.info-copy > p:not(.window-label) {
		max-width: 48ch;
		font-size: clamp(1.05rem, 1.6vw, 1.42rem);
		font-weight: 500;
		line-height: 1.45;
	}

	.window-label {
		color: #26798a;
		font-size: 0.72rem;
		font-weight: 950;
		letter-spacing: 0.15em;
		line-height: 1;
		text-transform: uppercase;
	}

	.email-link {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: 16px;
		align-items: center;
		margin-top: 4px;
		padding: clamp(16px, 2vw, 22px);
		border: 1px solid rgb(255 255 255 / 18%);
		border-radius: 22px;
		outline: 1px solid rgb(255 255 255 / 8%);
		outline-offset: -3px;
		background: rgb(37 37 37 / 94%);
		box-shadow: 0 12px 28px rgb(37 37 37 / 18%);
		color: var(--white);
		text-decoration: none;
		transition:
			transform 260ms cubic-bezier(0.34, 1.4, 0.64, 1),
			background-color 180ms ease,
			box-shadow 180ms ease;
	}

	.email-link:hover {
		background: var(--black);
		box-shadow: 0 15px 34px rgb(37 37 37 / 24%);
		transform: translateY(-3px);
	}

	.email-link:focus-visible,
	#copy-email:focus-visible,
	.footer-email:focus-visible {
		outline: 3px solid var(--yellow);
		outline-offset: 4px;
	}

	.email-icon {
		display: grid;
		width: 48px;
		height: 48px;
		border-radius: 15px;
		background: var(--yellow);
		color: var(--black);
		place-items: center;
	}

	.email-icon svg {
		width: 25px;
		height: 25px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
	}

	.email-copy {
		display: grid;
		gap: 5px;
		min-width: 0;
	}

	.email-copy small {
		color: rgb(255 255 255 / 62%);
		font-size: 0.62rem;
		font-weight: 900;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.email-copy strong {
		font: 900 clamp(1rem, 1.8vw, 1.45rem) / 1.05 var(--font-display);
		letter-spacing: -0.035em;
		overflow-wrap: anywhere;
	}

	.email-arrow {
		width: 24px;
		height: 24px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2.2;
		transition: transform 220ms ease;
	}

	.email-link:hover .email-arrow {
		transform: translate(3px, -3px);
	}

	.copy-row {
		display: flex;
		gap: 12px;
		align-items: center;
		min-height: 38px;
	}

	#copy-email {
		display: inline-flex;
		gap: 8px;
		align-items: center;
		padding: 10px 15px;
		border: 1px solid rgb(37 37 37 / 12%);
		border-radius: 999px;
		background: rgb(255 255 255 / 70%);
		color: var(--black);
		font: 900 0.72rem / 1 var(--font-body);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		cursor: pointer;
		transition: background-color 180ms ease, transform 180ms ease;
	}

	#copy-email:hover,
	#copy-email.is-copied {
		background: var(--mint);
		transform: translateY(-2px);
	}

	#copy-email svg {
		width: 16px;
		height: 16px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
	}

	#copy-status {
		color: #26798a;
		font-size: 0.72rem;
		font-weight: 900;
	}

	.details-window ul {
		display: grid;
		gap: 15px;
		margin: 23px 0 28px;
		padding: 0;
		list-style: none;
	}

	.details-window li {
		display: grid;
		grid-template-columns: 10px 1fr;
		gap: 10px;
		align-items: baseline;
		font-size: 0.92rem;
		font-weight: 800;
		line-height: 1.25;
	}

	.details-window li > i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--pink);
		box-shadow: 0 0 0 3px rgb(253 191 191 / 24%);
	}

	.details-window li:nth-child(2) > i { background: var(--yellow); box-shadow: 0 0 0 3px rgb(239 218 74 / 24%); }
	.details-window li:nth-child(3) > i { background: var(--mint); box-shadow: 0 0 0 3px rgb(124 245 181 / 24%); }
	.details-window li:nth-child(4) > i { background: var(--blue); box-shadow: 0 0 0 3px rgb(147 233 249 / 24%); }

	.location-detail {
		display: grid;
		gap: 5px;
		padding-top: 22px;
		border-top: 1px solid rgb(37 37 37 / 14%);
	}

	.location-detail small {
		color: #5f6566;
		font-size: 0.62rem;
		font-weight: 900;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.location-detail strong {
		font: 900 1.05rem / 1.1 var(--font-display);
		text-transform: uppercase;
	}

	@keyframes contact-float {
		0%,
		100% {
			translate: 0 0;
		}

		50% {
			translate: 0 -4px;
		}
	}

	.section-divider {
		--divider-height: clamp(110px, 11vw, 190px);
		position: relative;
		z-index: 20;
		width: 100%;
		height: var(--divider-height);
		margin-block: calc(var(--divider-height) / -2);
		background: var(--black);
		clip-path: polygon(0 28%, 100% 0, 100% 72%, 0 100%);
		pointer-events: none;
	}

	.footer-divider {
		margin-bottom: calc(
			var(--divider-height) / -2 - var(--contact-footer-gap) - 70px
		);
		transform: translateY(
			calc(
				var(--divider-height) / 2 - var(--contact-footer-gap) - 28% - 70px
			)
		);
	}

	.site-footer {
		position: relative;
		z-index: 1;
		min-height: clamp(310px, 38vh, 480px);
		padding: clamp(150px, 18vw, 240px) clamp(24px, 7vw, 120px) 64px;
		background-color: #383838;
		background-image: radial-gradient(
			circle,
			var(--black) 1.5px,
			transparent 1.6px
		);
		background-size: 24px 24px;
		color: var(--white);
	}

	.footer-content {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 32px;
		align-items: end;
		width: min(1180px, 100%);
		height: 100%;
		margin: 0 auto;
