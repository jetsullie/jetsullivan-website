---
import SiteMenu from "../components/common/SiteMenu.astro";
import PageMotion from "../components/common/PageMotion.astro";

const backgroundWindows = [
	{ x: 2, y: 16, w: 38, h: 31, symbol: "+", font: 8 },
	{ x: 8, y: 42, w: 44, h: 35, symbol: "○", font: 7 },
	{ x: 14, y: 8, w: 50, h: 39, symbol: "✦", font: 9 },
	{ x: 19, y: 72, w: 56, h: 42, symbol: "×", font: 10 },
	{ x: 25, y: 25, w: 62, h: 47, symbol: "◇", font: 8 },
	{ x: 31, y: 84, w: 68, h: 50, symbol: "≈", font: 11 },
	{ x: 37, y: 13, w: 74, h: 54, symbol: "▶", font: 9 },
	{ x: 43, y: 61, w: 80, h: 58, symbol: "⌁", font: 12 },
	{ x: 49, y: 34, w: 86, h: 61, symbol: "●", font: 7 },
	{ x: 55, y: 79, w: 92, h: 65, symbol: "↗", font: 11 },
	{ x: 61, y: 7, w: 98, h: 69, symbol: "□", font: 10 },
	{ x: 67, y: 48, w: 104, h: 73, symbol: "∞", font: 12 },
	{ x: 73, y: 86, w: 110, h: 77, symbol: "△", font: 9 },
	{ x: 79, y: 19, w: 46, h: 34, symbol: "•", font: 6 },
	{ x: 85, y: 57, w: 58, h: 43, symbol: "≡", font: 8 },
	{ x: 91, y: 31, w: 70, h: 51, symbol: "⌘", font: 10 },
	{ x: 4, y: 89, w: 82, h: 59, symbol: "◌", font: 12 },
	{ x: 21, y: 53, w: 94, h: 67, symbol: "✣", font: 11 },
	{ x: 70, y: 27, w: 106, h: 75, symbol: "↻", font: 12 },
	{ x: 88, y: 76, w: 118, h: 82, symbol: "⌂", font: 10 },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Contact Austin filmmaker and storyteller Jet Sullivan."
		/>
		<link rel="icon" type="image/png" href="/favicon-profile.png" />
		<title>Contact Jet Sullivan</title>
	</head>

	<body>
		<main class="contact-page" data-motion-root>
			<div class="top-frame" data-motion-depth="counter" aria-hidden="true"></div>
			<div class="yellow-panel" data-motion-depth="counter" aria-hidden="true"></div>

			<div class="background-windows" data-motion-bounds aria-hidden="true">
				{
					backgroundWindows.map((item) => (
						<span
							class="mini-window"
							data-motion-float
							style={`--x:${item.x}%; --y:${item.y}%; --w:${item.w}px; --h:${item.h}px; --symbol-size:${item.font}px;`}
						>
							<span class="mini-dots"><i></i><i></i><i></i></span>
							<span class="mini-symbol">{item.symbol}</span>
						</span>
					))
				}
			</div>

			<SiteMenu showHomeButton />

			<section class="contact-content" data-motion-depth="scene" aria-labelledby="contact-heading">
				<p class="eyebrow">Let’s make something memorable</p>
				<h1 id="contact-heading">Contact</h1>

				<div class="info-window">
					<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<div class="info-copy">
						<h2>Let’s work together.</h2>
						<p>
							For films, acting, creative collaborations, and other project
							inquiries, get in touch with Jet.
						</p>
						<p class="coming-soon">Contact information coming soon.</p>
					</div>
				</div>
			</section>
		</main>

		<div class="section-divider footer-divider" aria-hidden="true"></div>

		<footer class="site-footer">
			<div class="footer-content">
				<p class="footer-name">Jet Sullivan</p>
				<span aria-hidden="true"></span>
				<p class="footer-location">Austin, Texas</p>
			</div>
		</footer>

		<PageMotion />
	</body>
</html>

<script>
	const floatingWindows = Array.from(
		document.querySelectorAll<HTMLElement>("[data-motion-float]"),
	);

	if (floatingWindows.length >= 4) {
		const emojiPool = ["💛", "💖", "💕", "❤️", "😊", "😄", "🙂", "🥰", "😁", "☺️"];
		const shuffledWindows = [...floatingWindows].sort(() => Math.random() - 0.5);
		const shuffledEmoji = [...emojiPool].sort(() => Math.random() - 0.5);

		shuffledWindows.slice(0, 4).forEach((windowTab, index) => {
			const symbol = windowTab.querySelector<HTMLElement>(".mini-symbol");
			if (!symbol) return;
			symbol.textContent = shuffledEmoji[index];
			symbol.style.fontSize = "12px";
		});
	}

</script>

<style>
	:root {
		--yellow: #efda4a;
		--yellow-dark: #cc9504;
		--white: #ffffff;
		--black: #252525;
		--pink: #fdbfbf;
		--mint: #7cf5b5;
		--font-body: "Myriad Pro", Myriad, Arial, sans-serif;
		--font-display: "Arial Black", "Myriad Pro", Arial, sans-serif;
		--contact-footer-gap: clamp(36px, 4vh, 52px);
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		background: var(--black);
		color: var(--black);
		font-family: var(--font-body);
	}

	:global(body) {
		margin: 0;
		min-width: 320px;
		min-height: 100vh;
	}

	.contact-page {
		position: relative;
		width: 100%;
		padding: clamp(105px, 11vh, 145px) clamp(28px, 6vw, 105px)
			var(--contact-footer-gap);
		overflow: hidden;
		background: linear-gradient(
			180deg,
			var(--white) 0%,
			#effcff 32%,
			#d4f7fd 68%,
			#c0f2fb 100%
		);
	}

	.top-frame {
		position: absolute;
		z-index: 8;
		left: -3%;
		width: 106%;
		height: 9vw;
		min-height: 54px;
		background: var(--black);
		pointer-events: none;
	}

	.top-frame {
		top: -5vw;
		transform: rotate(-3deg);
	}

	.yellow-panel {
		position: absolute;
		z-index: 1;
		top: 23%;
		bottom: -3%;
		left: 4%;
		width: 52%;
		border: 1px solid rgb(255 255 255 / 58%);
		border-radius: 24px;
		outline: 1px solid rgb(255 255 255 / 16%);
		outline-offset: -3px;
		background: rgb(226 248 252 / 68%);
		box-shadow: 0 8px 28px rgb(37 37 37 / 14%);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
	}

	.background-windows {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.mini-window {
		position: absolute;
		top: var(--y);
		left: var(--x);
		display: grid;
		width: var(--w);
		height: var(--h);
		border: 1px solid rgb(255 255 255 / 45%);
		border-radius: clamp(5px, 0.7vw, 14px);
		background: rgb(156 166 170 / 20%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 34%),
			0 5px 14px rgb(37 37 37 / 5%);
		color: rgb(37 37 37 / 25%);
		font: 900 var(--symbol-size) var(--font-display);
		-webkit-backdrop-filter: blur(3px);
		backdrop-filter: blur(3px);
		place-items: center;
	}

	.mini-symbol {
		padding-top: 6px;
		line-height: 1;
	}

	.mini-dots,
	.window-dots {
		display: flex;
		gap: 6px;
	}

	.mini-dots {
		position: absolute;
		top: 7px;
		left: 8px;
		gap: 3px;
	}

	.mini-dots i,
	.window-dots i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--pink);
	}

	.mini-dots i {
		width: 4px;
		height: 4px;
	}

	.mini-dots i:nth-child(2),
	.window-dots i:nth-child(2) {
		background: var(--yellow);
	}

	.mini-dots i:nth-child(3),
	.window-dots i:nth-child(3) {
		background: var(--mint);
	}

	.window-dots i {
		border: 1px solid rgb(37 37 37 / 18%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 48%),
			0 1px 3px rgb(37 37 37 / 32%);
	}

	.home-window {
		position: absolute;
		z-index: 12;
		top: clamp(70px, 8vh, 105px);
		left: clamp(28px, 5vw, 82px);
		display: grid;
		grid-template-columns: auto 1fr;
		grid-template-rows: auto 1fr;
		gap: 8px 12px;
		width: clamp(175px, 13vw, 220px);
		height: clamp(88px, 7vw, 112px);
		padding: 17px;
		border: 1px solid rgb(255 255 255 / 52%);
		border-radius: 28px;
		outline: 1px solid rgb(255 255 255 / 14%);
		outline-offset: -3px;
		background:
			linear-gradient(rgb(255 255 255 / 5%), rgb(255 255 255 / 1%)),
			rgb(37 37 37 / 82%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 48%),
			0 14px 34px rgb(37 37 37 / 12%);
		color: var(--white);
		font: 900 clamp(0.9rem, 1.2vw, 1.2rem) var(--font-display);
		text-decoration: none;
		text-transform: uppercase;
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		transition:
			transform 350ms cubic-bezier(0.34, 1.56, 0.64, 1),
			background-color 220ms ease;
	}

	.home-window .window-dots {
		grid-column: 1 / -1;
	}

	.home-window > span:last-child,
	.back-arrow {
		align-self: center;
	}

	.back-arrow {
		font: 900 2.4rem/1 var(--font-display);
	}

	.home-window:hover {
		background:
			linear-gradient(rgb(255 255 255 / 7%), rgb(255 255 255 / 2%)),
			rgb(37 37 37 / 94%);
		transform: translateY(4px) scale(1.03);
	}

	.contact-content {
		position: relative;
		z-index: 30;
		width: min(100%, 1280px);
		margin: 0 auto;
	}

	.eyebrow {
		margin: 0 0 clamp(12px, 2vh, 24px);
		font-size: clamp(0.78rem, 1.1vw, 1rem);
		font-weight: 900;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font: 950 clamp(5rem, 15vw, 15rem) / 0.72 var(--font-display);
		letter-spacing: -0.035em;
		text-transform: uppercase;
	}

	.info-window {
		position: relative;
		width: min(88%, 690px);
		margin: clamp(48px, 6vh, 84px) 0 0;
		padding: clamp(52px, 6vw, 76px) clamp(25px, 4vw, 54px)
			clamp(28px, 4vw, 48px);
		border: 1px solid rgb(255 255 255 / 58%);
		border-radius: 30px;
		outline: 1px solid rgb(255 255 255 / 16%);
		outline-offset: -3px;
		background: rgb(255 255 255 / 64%);
		box-shadow: 0 8px 28px rgb(37 37 37 / 14%);
		color: var(--black);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		animation: contact-float 4.8s ease-in-out infinite;
	}

	.info-window > .window-dots {
		position: absolute;
		top: 22px;
		left: 25px;
	}

	.info-copy {
		display: grid;
		gap: 1rem;
	}

	.info-copy h2,
	.info-copy p {
		margin: 0;
	}

	.info-copy h2 {
		font: 900 clamp(1.45rem, 2.4vw, 2.2rem) var(--font-display);
		text-transform: uppercase;
	}

	.info-copy p {
		font-size: clamp(1.05rem, 1.6vw, 1.42rem);
		font-weight: 600;
		line-height: 1.45;
	}

	.coming-soon {
		padding-top: 0.9rem;
		border-top: 1px solid rgb(37 37 37 / 14%);
		color: #26798a;
	}

	@keyframes contact-float {
		0%,
		100% {
			translate: 0 0;
		}

		50% {
			translate: 0 -4px;
		}
	}

	.section-divider {
		--divider-height: clamp(110px, 11vw, 190px);
		position: relative;
		z-index: 20;
		width: 100%;
		height: var(--divider-height);
		margin-block: calc(var(--divider-height) / -2);
		background: var(--black);
		clip-path: polygon(0 28%, 100% 0, 100% 72%, 0 100%);
		pointer-events: none;
	}

	.footer-divider {
		margin-bottom: calc(
			var(--divider-height) / -2 - var(--contact-footer-gap) - 70px
		);
		transform: translateY(
			calc(
				var(--divider-height) / 2 - var(--contact-footer-gap) - 28% - 70px
			)
		);
	}

	.site-footer {
		position: relative;
		z-index: 1;
		min-height: clamp(310px, 38vh, 480px);
		padding: clamp(150px, 18vw, 240px) clamp(24px, 7vw, 120px) 64px;
		background-color: #383838;
		background-image: radial-gradient(
			circle,
			var(--black) 1.5px,
			transparent 1.6px
		);
		background-size: 24px 24px;
		color: var(--white);
	}

	.footer-content {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 32px;
		align-items: end;
		width: min(1180px, 100%);
		height: 100%;
		margin: 0 auto;
	}

	.footer-name {
		margin: 0;
		font: 950 clamp(2rem, 4vw, 4.5rem) / 0.9 var(--font-display);
		letter-spacing: -0.06em;
		text-transform: uppercase;
	}

	.site-footer nav {
		display: flex;
		gap: clamp(18px, 3vw, 42px);
	}

	.site-footer a {
		color: inherit;
		font-weight: 900;
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}

	.footer-location {
		justify-self: end;
		margin: 0;
		font-weight: 800;
	}

	@media (max-width: 820px) {
		:root {
			--contact-footer-gap: 48px;
		}

		.contact-page {
			display: block;
			min-height: 100svh;
			padding: 128px 22px var(--contact-footer-gap);
			overflow-y: auto;
		}

		.yellow-panel {
			top: 28%;
			left: 14px;
			width: calc(100% - 28px);
		}

		.home-window {
			top: 64px;
			left: 22px;
			width: 142px;
			height: 78px;
			padding: 12px;
			border-radius: 22px;
		}

		.window-dots {
			gap: 4px;
		}

		.window-dots i {
			width: 7px;
			height: 7px;
		}

		.back-arrow {
			font-size: 1.8rem;
		}

		.home-window > span:last-child {
			font-size: 0.72rem;
		}

		.contact-content {
			padding-top: 0;
		}

		.eyebrow {
			text-align: center;
		}

		h1 {
			font-size: clamp(3.8rem, 19vw, 7.5rem);
			text-align: center;
		}

		.info-window {
			width: 100%;
			margin-top: 42px;
		}

	}

	@media (max-width: 480px) {
		.contact-page {
			padding-top: 128px;
		}

		.contact-content {
			padding-top: 0;
		}

		.eyebrow {
			max-width: 62%;
			font-size: 0.67rem;
		}

		.info-window {
			padding: 50px 22px 28px;
			border-radius: 24px;
		}

		.info-copy p {
			font-size: 1rem;
		}
	}

	@media (max-width: 700px) {
		.section-divider {
			--divider-height: 108px;
		}

		.site-footer {
			min-height: 380px;
			padding: 138px 24px 54px;
		}

		.footer-content {
			grid-template-columns: 1fr;
			gap: 34px;
			align-content: end;
			align-items: start;
		}

		.site-footer nav {
			flex-wrap: wrap;
		}

		.footer-location {
			justify-self: start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-window,
		.info-window {
			animation: none;
			transition: none;
		}
	}
</style>
