---
import SiteMenu from "../components/common/SiteMenu.astro";
import PageMotion from "../components/common/PageMotion.astro";

const backgroundWindows = [
	{ x: 2, y: 16, w: 38, h: 31, symbol: "+", font: 8 },
	{ x: 8, y: 42, w: 44, h: 35, symbol: "○", font: 7 },
	{ x: 14, y: 8, w: 50, h: 39, symbol: "✦", font: 9 },
	{ x: 19, y: 72, w: 56, h: 42, symbol: "×", font: 10 },
	{ x: 25, y: 25, w: 62, h: 47, symbol: "◇", font: 8 },
	{ x: 31, y: 84, w: 68, h: 50, symbol: "≈", font: 11 },
	{ x: 37, y: 13, w: 74, h: 54, symbol: "▶", font: 9 },
	{ x: 43, y: 61, w: 80, h: 58, symbol: "⌁", font: 12 },
	{ x: 49, y: 34, w: 86, h: 61, symbol: "●", font: 7 },
	{ x: 55, y: 79, w: 92, h: 65, symbol: "↗", font: 11 },
	{ x: 61, y: 7, w: 98, h: 69, symbol: "□", font: 10 },
	{ x: 67, y: 48, w: 104, h: 73, symbol: "∞", font: 12 },
	{ x: 73, y: 86, w: 110, h: 77, symbol: "△", font: 9 },
	{ x: 79, y: 19, w: 46, h: 34, symbol: "•", font: 6 },
	{ x: 85, y: 57, w: 58, h: 43, symbol: "≡", font: 8 },
	{ x: 91, y: 31, w: 70, h: 51, symbol: "⌘", font: 10 },
	{ x: 4, y: 89, w: 82, h: 59, symbol: "◌", font: 12 },
	{ x: 21, y: 53, w: 94, h: 67, symbol: "✣", font: 11 },
	{ x: 70, y: 27, w: 106, h: 75, symbol: "↻", font: 12 },
	{ x: 88, y: 76, w: 118, h: 82, symbol: "⌂", font: 10 },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Contact Austin filmmaker and storyteller Jet Sullivan."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Contact Jet Sullivan</title>
	</head>

	<body>
		<main class="contact-page" data-motion-root>
			<div class="top-frame" data-motion-depth="counter" aria-hidden="true"></div>
			<div class="bottom-frame" data-motion-depth="counter" aria-hidden="true"></div>
			<div class="yellow-panel" data-motion-depth="counter" aria-hidden="true"></div>

			<div class="background-windows" data-motion-bounds aria-hidden="true">
				{
					backgroundWindows.map((item) => (
						<span
							class="mini-window"
							data-motion-float
							style={`--x:${item.x}%; --y:${item.y}%; --w:${item.w}px; --h:${item.h}px; --symbol-size:${item.font}px;`}
						>
							<span class="mini-dots"><i></i><i></i><i></i></span>
							<span class="mini-symbol">{item.symbol}</span>
						</span>
					))
				}
			</div>

			<SiteMenu showHomeButton />

			<section class="contact-content" data-motion-depth="scene" aria-labelledby="contact-heading">
				<p class="eyebrow">Let’s make something memorable</p>
				<h1 id="contact-heading">Contact</h1>

				<div class="info-window">
					<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<div class="info-copy">
						<h2>Let’s work together.</h2>
						<p>
							For films, acting, creative collaborations, and other project
							inquiries, get in touch with Jet.
						</p>
						<p class="coming-soon">Contact information coming soon.</p>
					</div>
				</div>
			</section>

			<p class="location" data-motion-depth="deep">Austin, TX</p>
		</main>
		<PageMotion />
	</body>
</html>

<script>
	const floatingWindows = Array.from(
		document.querySelectorAll<HTMLElement>("[data-motion-float]"),
	);

	if (floatingWindows.length >= 4) {
		const emojiPool = ["💛", "💖", "💕", "❤️", "😊", "😄", "🙂", "🥰", "😁", "☺️"];
		const shuffledWindows = [...floatingWindows].sort(() => Math.random() - 0.5);
		const shuffledEmoji = [...emojiPool].sort(() => Math.random() - 0.5);

		shuffledWindows.slice(0, 4).forEach((windowTab, index) => {
			const symbol = windowTab.querySelector<HTMLElement>(".mini-symbol");
			if (!symbol) return;
			symbol.textContent = shuffledEmoji[index];
			symbol.style.fontSize = "12px";
		});
	}

</script>

<style>
	:root {
		--yellow: #efda4a;
		--yellow-dark: #cc9504;
		--white: #ffffff;
		--black: #252525;
		--pink: #fdbfbf;
		--mint: #7cf5b5;
		--font-body: "Myriad Pro", Myriad, Arial, sans-serif;
		--font-display: "Arial Black", "Myriad Pro", Arial, sans-serif;
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		background: var(--black);
		color: var(--black);
		font-family: var(--font-body);
	}

	:global(body) {
		margin: 0;
		min-width: 320px;
		min-height: 100vh;
	}

	.contact-page {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		width: 100%;
		min-height: 100svh;
		padding: clamp(90px, 10vh, 130px) clamp(28px, 6vw, 105px)
			clamp(80px, 8vh, 110px);
		overflow: hidden;
		background: linear-gradient(
			180deg,
			var(--white) 0%,
			#effcff 32%,
			#d4f7fd 68%,
			#c0f2fb 100%
		);
		isolation: isolate;
	}

	.top-frame,
	.bottom-frame {
		position: absolute;
		z-index: 8;
		left: -3%;
		width: 106%;
		height: 9vw;
		min-height: 54px;
		background: var(--black);
		pointer-events: none;
	}

	.top-frame {
		top: -5vw;
		transform: rotate(-3deg);
	}

	.bottom-frame {
		bottom: -5vw;
		transform: rotate(-3deg);
	}

	.yellow-panel {
		position: absolute;
		z-index: 1;
		top: 24%;
		bottom: -2%;
		left: 50%;
		width: min(76vw, 1050px);
		border: 1px solid rgb(255 255 255 / 48%);
		border-radius: 24px;
		background: linear-gradient(
			180deg,
			rgb(235 252 255 / 88%) 0%,
			rgb(147 233 249 / 82%) 42%,
			rgb(75 183 215 / 76%) 135%
		);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 52%),
			0 12px 36px rgb(37 37 37 / 7%);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
		transform: translateX(-50%);
	}

	.background-windows {
		position: absolute;
		z-index: 0;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.mini-window {
		position: absolute;
		top: var(--y);
		left: var(--x);
		display: grid;
		width: var(--w);
		height: var(--h);
		border: 1px solid rgb(255 255 255 / 45%);
		border-radius: clamp(5px, 0.7vw, 14px);
		background: rgb(156 166 170 / 20%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 34%),
			0 5px 14px rgb(37 37 37 / 5%);
		color: rgb(37 37 37 / 25%);
		font: 900 var(--symbol-size) var(--font-display);
		-webkit-backdrop-filter: blur(3px);
		backdrop-filter: blur(3px);
		place-items: center;
	}

	.mini-symbol {
		padding-top: 6px;
		line-height: 1;
	}

	.mini-dots,
	.window-dots {
		display: flex;
		gap: 6px;
	}

	.mini-dots {
		position: absolute;
		top: 7px;
		left: 8px;
		gap: 3px;
	}

	.mini-dots i,
	.window-dots i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--pink);
	}

	.mini-dots i {
		width: 4px;
		height: 4px;
	}

	.mini-dots i:nth-child(2),
	.window-dots i:nth-child(2) {
		background: var(--yellow);
	}

	.mini-dots i:nth-child(3),
	.window-dots i:nth-child(3) {
		background: var(--mint);
	}

	.window-dots i {
		border: 1px solid rgb(37 37 37 / 18%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 48%),
			0 1px 3px rgb(37 37 37 / 32%);
	}

	.home-window {
		position: absolute;
		z-index: 12;
		top: clamp(70px, 8vh, 105px);
		left: clamp(28px, 5vw, 82px);
		display: grid;
		grid-template-columns: auto 1fr;
		grid-template-rows: auto 1fr;
		gap: 8px 12px;
		width: clamp(175px, 13vw, 220px);
		height: clamp(88px, 7vw, 112px);
		padding: 17px;
		border: 1px solid rgb(255 255 255 / 52%);
		border-radius: 28px;
		outline: 1px solid rgb(255 255 255 / 14%);
		outline-offset: -3px;
		background:
			linear-gradient(rgb(255 255 255 / 5%), rgb(255 255 255 / 1%)),
			rgb(37 37 37 / 82%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 48%),
			0 14px 34px rgb(37 37 37 / 12%);
		color: var(--white);
		font: 900 clamp(0.9rem, 1.2vw, 1.2rem) var(--font-display);
		text-decoration: none;
		text-transform: uppercase;
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		transition:
			transform 350ms cubic-bezier(0.34, 1.56, 0.64, 1),
			background-color 220ms ease;
	}

	.home-window .window-dots {
		grid-column: 1 / -1;
	}

	.home-window > span:last-child,
	.back-arrow {
		align-self: center;
	}

	.back-arrow {
		font: 900 2.4rem/1 var(--font-display);
	}

	.home-window:hover {
		background:
			linear-gradient(rgb(255 255 255 / 7%), rgb(255 255 255 / 2%)),
			rgb(37 37 37 / 94%);
		transform: translateY(4px) scale(1.03);
	}

	.contact-content {
		position: relative;
		z-index: 3;
		align-self: center;
		justify-self: center;
		width: min(100%, 1100px);
	}

	.eyebrow {
		margin: 0 auto clamp(12px, 2vh, 24px);
		font-size: clamp(0.78rem, 1.1vw, 1rem);
		font-weight: 900;
		letter-spacing: 0.16em;
		text-align: center;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font: 950 clamp(4.5rem, 12vw, 12rem) / 0.78 var(--font-display);
		letter-spacing: -0.02em;
		text-align: center;
		text-transform: uppercase;
	}

	.info-window {
		position: relative;
		width: min(88%, 690px);
		margin: clamp(48px, 6vh, 84px) auto 0;
		padding: clamp(52px, 6vw, 76px) clamp(25px, 4vw, 54px)
			clamp(28px, 4vw, 48px);
		border: 1px solid rgb(255 255 255 / 46%);
		border-radius: 30px;
		outline: 1px solid rgb(255 255 255 / 12%);
		outline-offset: -3px;
		background: rgb(37 37 37 / 82%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 28%),
			0 18px 45px rgb(37 37 37 / 15%);
		color: var(--white);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
	}

	.info-window > .window-dots {
		position: absolute;
		top: 22px;
		left: 25px;
	}

	.info-copy {
		display: grid;
		gap: 1rem;
	}

	.info-copy h2,
	.info-copy p {
		margin: 0;
	}

	.info-copy h2 {
		font: 900 clamp(1.45rem, 2.4vw, 2.2rem) var(--font-display);
		text-transform: uppercase;
	}

	.info-copy p {
		font-size: clamp(1.05rem, 1.6vw, 1.42rem);
		font-weight: 600;
		line-height: 1.45;
	}

	.coming-soon {
		padding-top: 0.9rem;
		border-top: 1px solid rgb(255 255 255 / 20%);
		color: var(--yellow);
	}

	.location {
		position: absolute;
		z-index: 5;
		right: clamp(32px, 6vw, 110px);
		bottom: clamp(54px, 7vh, 92px);
		margin: 0;
		font: 950 clamp(1.3rem, 2.2vw, 2.6rem) / 1 var(--font-display);
		letter-spacing: -0.06em;
	}

	@media (max-width: 820px) {
		.contact-page {
			display: block;
			min-height: 100svh;
			padding: 105px 24px 90px;
			overflow-y: auto;
		}

		.yellow-panel {
			top: 33%;
			width: calc(100% - 28px);
		}

		.home-window {
			top: 64px;
			left: 22px;
			width: 142px;
			height: 78px;
			padding: 12px;
			border-radius: 22px;
		}

		.window-dots {
			gap: 4px;
		}

		.window-dots i {
			width: 7px;
			height: 7px;
		}

		.back-arrow {
			font-size: 1.8rem;
		}

		.home-window > span:last-child {
			font-size: 0.72rem;
		}

		.contact-content {
			padding-top: 94px;
		}

		h1 {
			font-size: clamp(3.5rem, 18vw, 7rem);
		}

		.info-window {
			width: 100%;
			margin-top: 42px;
		}

		.location {
			right: 24px;
			bottom: 46px;
			font-size: 1.25rem;
		}
	}

	@media (max-width: 480px) {
		.contact-page {
			padding-top: 92px;
		}

		.contact-content {
			padding-top: 112px;
		}

		.eyebrow {
			max-width: 62%;
			font-size: 0.67rem;
		}

		.info-window {
			padding: 50px 22px 28px;
			border-radius: 24px;
		}

		.info-copy p {
			font-size: 1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-window {
			transition: none;
		}
	}
</style>
