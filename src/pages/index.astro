		isolation: isolate;
		place-items: center;
		background-position: center calc(50% + var(--scroll-bg));
		background-size: 120% 120%;
	}

	.section-divider {
		--divider-height: clamp(110px, 11vw, 190px);
		position: relative;
		z-index: 20;
		width: 100%;
		height: var(--divider-height);
		margin-block: calc(var(--divider-height) / -2);
		background: var(--black);
		clip-path: polygon(0 28%, 100% 0, 100% 72%, 0 100%);
		pointer-events: none;
	}

	.section-divider.hero-divider {
		--hero-divider-base-height: clamp(192.5px, 19.25vw, 332.5px);
		--divider-height: calc(var(--hero-divider-base-height) + 96px);
		--divider-slant: clamp(53px, 5.4vw, 93px);
		clip-path: polygon(
			0 var(--divider-slant),
			100% 0,
			100% calc(100% - var(--divider-slant)),
			0 100%
		);
		transform: translateY(calc(48px - var(--hero-boundary-lift)));
	}

	.section-divider.hero-divider::after {
		--secondary-divider-height: clamp(72px, 7.5vw, 128px);
		position: absolute;
		inset: 0;
		background-color: #383838;
		background-image: radial-gradient(
			circle,
			var(--black) 1.5px,
			transparent 1.6px
		);
		background-size: 24px 24px;
		clip-path: polygon(
			0 calc(100% - var(--secondary-divider-height)),
			100% calc(100% - var(--secondary-divider-height) - var(--divider-slant)),
			100% calc(100% - var(--divider-slant)),
			0 100%
		);
		content: "";
	}

	.footer-divider {
		left: -8%;
		width: 116%;
		margin-bottom: calc(var(--divider-height) / -2 + 48px);
		transform: translateY(48px);
	}

	.home-section::before,
	.home-section::after {
		position: absolute;
		z-index: -1;
		border: 1px solid rgb(255 255 255 / 42%);
		background: rgb(255 255 255 / 14%);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 38%);
		content: "";
		will-change: transform;
	}

	.home-section::before {
		top: 8%;
		right: -8%;
		width: min(48vw, 700px);
		aspect-ratio: 1.35;
		border-radius: 54px;
		transform:
			translate3d(
				var(--far-a-x, 0px),
				calc(var(--far-a-y, 0px) + var(--scroll-far)),
				0
			)
			rotate(-7deg);
	}

	.home-section::after {
		bottom: -16%;
		left: -10%;
		width: min(44vw, 620px);
		aspect-ratio: 1;
		border-radius: 50%;
		transform:
			translate3d(
				var(--deep-x, 0px),
				calc(var(--deep-y, 0px) + var(--scroll-near)),
				0
			)
			rotate(-7deg);
	}

	.about-section {
		z-index: 10;
		margin-top: calc(-2px - var(--hero-boundary-lift));
		padding-top: clamp(190px, 22vh, 280px);
		background-color: #fbd9dc;
		background-image: linear-gradient(145deg, #fff7f8 0%, #fbd9dc 48%, #e9a9b0 100%);
	}

	.media-section {
		background-color: #baf4d6;
		background-image: linear-gradient(145deg, #f4fff9 0%, #baf4d6 50%, #65d69d 100%);
	}

	.contact-section {
		background-color: #c2f2fa;
		background-image: linear-gradient(145deg, #f3fdff 0%, #c2f2fa 48%, #7ed9e9 100%);
	}

	.section-content {
		width: min(1180px, 100%);
	}

	.home-section .section-content[data-motion-depth] {
		translate:
			var(--scene-x)
			calc(var(--scene-y) + var(--scroll-content));
	}

	.section-kicker {
		margin: 0 0 12px;
		font: 900 clamp(0.8rem, 1vw, 1rem) / 1 var(--font-display);
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.home-section h2 {
		max-width: 950px;
		margin: 0 0 clamp(42px, 8vh, 88px);
		font: 950 clamp(3.5rem, 9vw, 9rem) / 0.83 var(--font-display);
		letter-spacing: -0.075em;
		text-transform: uppercase;
	}

	.section-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(250px, 360px);
		gap: clamp(28px, 6vw, 90px);
		align-items: center;
	}

	.section-layout-reverse {
		grid-template-columns: minmax(250px, 360px) minmax(0, 1fr);
	}

	.section-layout-reverse .glass-panel {
		grid-column: 2;
	}

	.section-layout-reverse .section-tab {
		grid-column: 1;
		grid-row: 1;
	}

	.glass-panel {
		padding: clamp(28px, 4vw, 58px);
		border: 1px solid rgb(255 255 255 / 64%);
		border-radius: clamp(26px, 3vw, 42px);
		outline: 1px solid rgb(255 255 255 / 16%);
		outline-offset: -3px;
		background: rgb(255 255 255 / 56%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 48%),
			0 18px 48px rgb(37 37 37 / 12%);
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(14px);
	}

	.glass-panel p {
		max-width: 720px;
		margin: 0;
		font-size: clamp(1.15rem, 2vw, 1.75rem);
		font-weight: 700;
		line-height: 1.45;
	}

	.section-tab {
		--tab-glow: 255 255 255;
		--tab-idle-y: 0px;
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		width: 100%;
		aspect-ratio: 1;
		padding: clamp(24px, 3vw, 38px);
		border: 1px solid rgb(255 255 255 / 58%);
		border-radius: clamp(30px, 4vw, 52px);
		outline: 1px solid rgb(255 255 255 / 16%);
		outline-offset: -3px;
		background:
			linear-gradient(rgb(255 255 255 / 8%), rgb(255 255 255 / 2%)),
			var(--black);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 50%),
			0 20px 52px rgb(37 37 37 / 16%);
		color: #bfc4c5;
		text-decoration: none;
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(14px);
		animation: section-tab-idle 4.8s ease-in-out infinite;
		transition:
			color 220ms ease,
			transform 260ms cubic-bezier(0.34, 1.4, 0.64, 1),
			box-shadow 220ms ease;
	}

	.section-tab[data-motion-depth] {
		translate:
			var(--motion-layer-x, 0px)
			calc(var(--motion-layer-y, 0px) + var(--tab-idle-y));
	}

	.section-tab:hover {
		background:
			linear-gradient(rgb(var(--tab-glow) / 14%), rgb(var(--tab-glow) / 5%)),
			var(--black);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 58%),
			0 20px 42px rgb(37 37 37 / 16%),
			0 0 34px rgb(var(--tab-glow) / 78%),
			0 0 68px rgb(var(--tab-glow) / 28%);
		color: rgb(var(--tab-glow));
		transform: translateY(-7px) rotate(1deg);
	}

	.section-tab:focus-visible {
		color: rgb(var(--tab-glow));
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 58%),
			0 20px 42px rgb(37 37 37 / 16%),
			0 0 34px rgb(var(--tab-glow) / 78%);
	}

	.section-tab .window-dots {
		position: absolute;
		top: clamp(22px, 3vw, 34px);
		left: clamp(22px, 3vw, 34px);
	}

	.about-tab {
		--tab-glow: 253 191 191;
		animation-delay: -0.8s;
	}

	.media-tab {
		--tab-glow: 124 245 181;
		animation-delay: -2.35s;
	}

	.media-tab:hover {
		transform: translateY(-7px) rotate(-1deg);
	}

	.contact-tab {
		--tab-glow: 147 233 249;
		animation-delay: -3.7s;
	}

	@property --tab-idle-y {
		syntax: "<length>";
		inherits: false;
		initial-value: 0px;
	}

	@keyframes section-tab-idle {
		0%,
		100% {
			--tab-idle-y: 0px;
		}

		50% {
			--tab-idle-y: -4px;
		}
