---
import SiteMenu from "../components/common/SiteMenu.astro";
import PageMotion from "../components/common/PageMotion.astro";

const name = "Jet Sullivan";

const backgroundWindows = [
	{ x: 2, y: 16, w: 38, h: 31, symbol: "+", font: 8, depth: "a" },
	{ x: 8, y: 42, w: 44, h: 35, symbol: "○", font: 7, depth: "c" },
	{ x: 14, y: 8, w: 50, h: 39, symbol: "✦", font: 9, depth: "b" },
	{ x: 19, y: 72, w: 56, h: 42, symbol: "×", font: 10, depth: "a" },
	{ x: 25, y: 25, w: 62, h: 47, symbol: "◇", font: 8, depth: "c" },
	{ x: 31, y: 84, w: 68, h: 50, symbol: "≈", font: 11, depth: "b" },
	{ x: 37, y: 13, w: 74, h: 54, symbol: "▶", font: 9, depth: "a" },
	{ x: 43, y: 61, w: 80, h: 58, symbol: "⌁", font: 12, depth: "c" },
	{ x: 49, y: 34, w: 86, h: 61, symbol: "●", font: 7, depth: "b" },
	{ x: 55, y: 79, w: 92, h: 65, symbol: "↗", font: 11, depth: "a" },
	{ x: 61, y: 7, w: 98, h: 69, symbol: "□", font: 10, depth: "c" },
	{ x: 67, y: 48, w: 104, h: 73, symbol: "∞", font: 12, depth: "b" },
	{ x: 73, y: 86, w: 110, h: 77, symbol: "△", font: 9, depth: "a" },
	{ x: 79, y: 19, w: 46, h: 34, symbol: "•", font: 6, depth: "c" },
	{ x: 85, y: 57, w: 58, h: 43, symbol: "≡", font: 8, depth: "b" },
	{ x: 91, y: 31, w: 70, h: 51, symbol: "⌘", font: 10, depth: "a" },
	{ x: 4, y: 89, w: 82, h: 59, symbol: "◌", font: 12, depth: "c" },
	{ x: 21, y: 53, w: 94, h: 67, symbol: "✣", font: 11, depth: "b" },
	{ x: 70, y: 27, w: 106, h: 75, symbol: "↻", font: 12, depth: "a" },
	{ x: 88, y: 76, w: 118, h: 82, symbol: "⌂", font: 10, depth: "c" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Jet Sullivan is an Austin-based director, filmmaker, and storyteller."
		/>
		<link rel="icon" type="image/png" href="/favicon-profile.png" />
		<title>{name} — Director & Filmmaker</title>
		<script is:inline>
			window.addEventListener("load", () => {
				document.body?.classList.remove("home-layout-pending");
			}, { once: true });
		</script>
		<noscript><style>body.home-layout-pending { visibility: visible !important; }</style></noscript>
	</head>

	<body class="home-layout-pending">
		<SiteMenu />

		<form class="search-bar" action="/" method="get" role="search">
			<button
				class="search-toggle"
				type="button"
				aria-expanded="false"
				aria-label="Open site search"
			>
				<span class="magnifier" aria-hidden="true"></span>
			</button>
			<input
				class="search-input"
				type="search"
				name="q"
				placeholder="Where do you want to go?"
				aria-label="Search the site"
				autocomplete="off"
				spellcheck="false"
				role="combobox"
				aria-autocomplete="list"
				aria-controls="site-search-suggestions"
				aria-expanded="false"
				aria-hidden="true"
				tabindex="-1"
			/>
			<button
				class="search-close"
				type="button"
				aria-label="Close site search"
				aria-hidden="true"
				tabindex="-1"
			>
				<span aria-hidden="true"></span>
			</button>
			<button
				class="visually-hidden"
				type="submit"
				aria-hidden="true"
				tabindex="-1"
			>Search</button>
			<div
				id="site-search-suggestions"
				class="search-suggestions"
				role="listbox"
				aria-label="Suggested pages"
				hidden
			></div>
			<p class="visually-hidden" data-search-status role="status" aria-live="polite"></p>
		</form>

		<main class="canvas" data-motion-root>
			<div class="top-frame" data-motion-depth="counter" aria-hidden="true"></div>

			<div class="background-windows" data-motion-bounds aria-hidden="true">
				{
					backgroundWindows.map((item) => (
						<div
							class={`background-window depth-${item.depth}`}
							data-motion-float
							data-motion-depth={`far-${item.depth}`}
							style={`--x:${item.x}%; --y:${item.y}%; --w:${item.w}px; --h:${item.h}px; --symbol-size:${item.font}px;`}
						>
							<span class="mini-dots"><i></i><i></i><i></i></span>
							<span class="mini-symbol">{item.symbol}</span>
						</div>
					))
				}
			</div>

			<header class="masthead"></header>

			<section class="hero" data-motion-depth="scene" aria-labelledby="page-title">
				<div class="name-block">
					<h1 id="page-title">
						<span class="name-word">Jet</span>
						<span class="surname-line">
							<span class="name-word">Sullivan</span>
						</span>
					</h1>
				</div>

				<div class="location">
					<span class="location-box" aria-hidden="true">
						<span class="selection-cursor"></span>
					</span>
					<span class="location-name">Austin, TX</span>
					<span class="location-roles">Actor · Filmmaker · Videographer · Content Creator</span>
				</div>

			</section>

			<div class="portrait-emoji-layer" aria-hidden="true"></div>

			<img
				class="portrait"
				data-motion-depth="deep"
				data-portrait-trigger
				src="/jet-portrait.jpg"
				alt="Jet Sullivan"
				aria-label="Release camera emojis from Jet's portrait"
				draggable="false"
				role="button"
				tabindex="0"
				width="605"
				height="1816"
			/>

		</main>

		<div class="work-grid-stage hero-work-grid-stage">
			<nav class="work-grid" aria-label="Explore Jet Sullivan's work">
				<a class="work-card card-media" href="/socials/">
					<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="work-card-icon social-icon" aria-hidden="true">
						<svg viewBox="0 0 96 96" focusable="false">
							<path d="M33 12a16 16 0 1 1 0 32 16 16 0 0 1 0-32ZM6 78c1.5-20 11.1-31 27-31s25.5 11 27 31ZM67 18a13 13 0 1 1 0 26 13 13 0 0 1 0-26ZM45 78c1.3-19 9.4-30 22-30s20.7 11 22 30Z"></path>
						</svg>
					</span>
					<span class="work-card-label">Socials</span>
				</a>
				<a class="work-card card-directing" href="/acting/">
					<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="work-card-icon acting-icon" aria-hidden="true">
						<svg viewBox="0 0 96 96" focusable="false">
							<defs>
								<mask id="acting-eye-cutouts" maskUnits="userSpaceOnUse" x="0" y="0" width="96" height="96">
									<rect width="96" height="96" fill="white"></rect>
									<path d="M28 45Q36 39 43 45" fill="none" stroke="black" stroke-width="6" stroke-linecap="round"></path>
									<circle cx="61" cy="43" r="7" fill="black"></circle>
								</mask>
							</defs>
							<path
								mask="url(#acting-eye-cutouts)"
								d="M16 21Q48 10 80 21L77 57Q73 80 48 89Q23 80 19 57Z"
							></path>
						</svg>
					</span>
					<span class="work-card-label">Acting</span>
				</a>
				<a class="work-card card-film" href="/film/">
					<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="work-card-icon slate-icon" aria-hidden="true">
						<svg viewBox="0 0 96 96" focusable="false">
							<defs>
								<mask id="slate-cutouts" maskUnits="userSpaceOnUse" x="0" y="0" width="96" height="96">
									<rect width="96" height="96" fill="white"></rect>
									<path
										d="M28 32.3 35.7 30.3 38.5 40.9 30.8 42.9ZM45.3 27.7 52.9 25.7 55.7 36.3 48.1 38.3ZM62.5 23.1 70.2 21.1 73 31.7 65.3 33.8Z"
										fill="black"
									></path>
									<rect x="28" y="55" width="40" height="5" rx="2.5" fill="black"></rect>
									<rect x="28" y="67" width="27" height="5" rx="2.5" fill="black"></rect>
								</mask>
							</defs>
							<path
								mask="url(#slate-cutouts)"
								d="M16 31 80 14l5 19-64 17ZM21 47h64v34a7 7 0 0 1-7 7H28a7 7 0 0 1-7-7Z"
							></path>
						</svg>
					</span>
					<span class="work-card-label">Film</span>
				</a>
				<a class="work-card card-video" href="/video/">
					<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="work-card-icon camera-icon" aria-hidden="true">
						<svg viewBox="0 0 96 96" focusable="false">
							<rect x="9" y="27" width="58" height="44" rx="9"></rect>
							<path d="M67 40 88 29v38L67 56Z"></path>
						</svg>
					</span>
					<span class="work-card-label">Video</span>
				</a>
			</nav>
		</div>

		<div class="section-divider hero-divider" aria-hidden="true"></div>

		<section
			class="home-section about-section"
			aria-labelledby="about-heading"
			data-motion-root
			data-scroll-section
		>
			<div class="section-content" data-motion-depth="scene">
				<p class="section-kicker">About</p>
				<h2 id="about-heading">Who is Jet?</h2>
				<div class="section-layout">
					<div class="glass-panel" data-motion-depth="counter">
						<p>
							Jet Sullivan is a Texas filmmaker, actor, and storyteller based in Austin.
							He creates character-driven work with a sharp visual point of view and a
							love for the people and places that make every story feel real.
						</p>
					</div>
					<a class="section-tab about-tab" href="/about/" data-motion-depth="deep">
						<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<span class="about-paper-icon" aria-hidden="true">
							<span class="paper-back"></span>
							<span class="paper-front">
								<span class="paper-title"><span>About</span><span>Me</span></span>
								<span class="paper-copy"><i></i><i></i><i></i><i></i><i></i></span>
							</span>
						</span>
						<span class="section-tab-action">Meet Jet <span aria-hidden="true">↗</span></span>
					</a>
				</div>
			</div>
		</section>

		<section
			class="home-section media-section"
			aria-labelledby="media-heading"
			data-motion-root
			data-scroll-section
		>
			<div class="section-content" data-motion-depth="scene">
				<p class="section-kicker">Updates</p>
				<h2 id="media-heading">News and Media</h2>
				<div class="section-layout section-layout-reverse">
					<div class="glass-panel" data-motion-depth="counter">
						<p>
							See what’s new with Jet—from featured projects and interviews to press
							coverage and moments from behind the scenes.
						</p>
					</div>
					<a class="section-tab media-tab" href="/media/" data-motion-depth="deep">
						<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<span class="newspaper-icon" aria-hidden="true">
							<span class="newspaper-fold"></span>
							<span class="newspaper-page">
								<span class="newspaper-name">News</span>
								<span class="newspaper-rule"></span>
								<span class="newspaper-story">
									<span class="newspaper-photo"></span>
									<span class="newspaper-lines"><i></i><i></i><i></i><i></i></span>
								</span>
							</span>
						</span>
						<span class="section-tab-action">View Media <span aria-hidden="true">↗</span></span>
					</a>
				</div>
			</div>
		</section>

		<section
			class="home-section contact-section"
			aria-labelledby="contact-heading"
			data-motion-root
			data-scroll-section
		>
			<div class="section-content" data-motion-depth="scene">
				<p class="section-kicker">Say Hello</p>
				<h2 id="contact-heading">Contact Jet?</h2>
				<div class="section-layout">
					<div class="glass-panel" data-motion-depth="counter">
						<p>
							Have a project, role, collaboration, or story in mind? Reach out to Jet
							and start the conversation.
						</p>
					</div>
					<a class="section-tab contact-tab" href="/contact/" data-motion-depth="deep">
						<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<span class="contact-plane" aria-hidden="true"></span>
						<span class="section-tab-action">Contact Jet <span aria-hidden="true">↗</span></span>
					</a>
				</div>
			</div>
		</section>

		<div class="section-divider footer-divider" aria-hidden="true"></div>

		<footer class="site-footer">
			<div class="footer-content">
				<p class="footer-name">Jet Sullivan</p>
				<span aria-hidden="true"></span>
				<p class="footer-location">Austin, Texas</p>
			</div>
		</footer>

		<PageMotion />
	</body>
</html>

<style>
	:root {
		--yellow: #efda4a;
		--yellow-dark: #cc9504;
		--white: #ffffff;
		--black: #252525;
		--blue: #93e9f9;
		--pink: #fdbfbf;
		--mint: #7cf5b5;
		--font-body: "Myriad Pro", Myriad, Arial, sans-serif;
		--font-display: "Arial Black", "Myriad Pro", Arial, sans-serif;
		--hero-boundary-lift: calc(clamp(120px, 22vh, 210px) - 72px);
		--home-gutter: clamp(42px, 7vw, 120px);
		--home-section-gutter: clamp(42px, 9vw, 150px);
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		background: var(--black);
		color: var(--black);
		font-family: var(--font-body);
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		min-width: 320px;
		min-height: 100vh;
		overflow-x: clip;
	}

	:global(body.home-layout-pending) {
		visibility: hidden;
	}

	:global(a) {
		color: inherit;
	}

	.canvas {
		--scene-x: 0px;
		--scene-y: 0px;
		--deep-x: 0px;
		--deep-y: 0px;
		--counter-x: 0px;
		--counter-y: 0px;
		--far-a-x: 0px;
		--far-a-y: 0px;
		--far-b-x: 0px;
		--far-b-y: 0px;
		--far-c-x: 0px;
		--far-c-y: 0px;
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: 10vh minmax(0, 68vh) minmax(48px, 7vh);
		gap: 2vh;
		width: 100%;
		height: 100svh;
		min-height: 0;
		padding: 7vh var(--home-gutter) 2vh;
		overflow: hidden;
		background: linear-gradient(
			180deg,
			var(--white) 0%,
			#effcff 32%,
			#d4f7fd 68%,
			#c0f2fb 100%
		);
		isolation: isolate;
	}

	.canvas::before {
		position: absolute;
		z-index: 0;
		top: 21%;
		bottom: -3%;
		left: 4%;
		width: 47%;
		border: 1px solid rgb(255 255 255 / 48%);
		border-radius: 24px;
			background: linear-gradient(
				180deg,
				rgb(255 253 205 / 42%) 0%,
				rgb(255 239 101 / 68%) 38%,
				rgb(239 207 32 / 94%) 100%
			);
			box-shadow:
				inset 0 1px 0 rgb(255 255 255 / 52%),
				0 12px 36px rgb(37 37 37 / 7%),
				0 0 42px rgb(239 218 74 / 22%);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
		content: "";
		translate: var(--counter-x) var(--counter-y);
	}

	.top-frame {
		position: absolute;
		z-index: 0;
		left: -3%;
		width: 106%;
		height: 9vw;
		min-height: 54px;
		background: var(--black);
		pointer-events: none;
		translate: var(--counter-x) var(--counter-y);
		top: -5vw;
		transform: rotate(-3deg);
	}

	.background-windows {
		position: absolute;
		z-index: -1;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.background-window {
		--drift-x: 0px;
		--drift-y: 0px;
		position: absolute;
		top: var(--y);
		left: var(--x);
		display: grid;
		width: var(--w);
		height: var(--h);
		border: 1px solid rgb(255 255 255 / 44%);
		border-radius: clamp(5px, 0.7vw, 14px);
		background: rgb(156 166 170 / 20%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 25%),
			0 5px 14px rgb(37 37 37 / 5%);
		color: rgb(37 37 37 / 28%);
		-webkit-backdrop-filter: blur(3px);
		backdrop-filter: blur(3px);
		place-items: center;
	}

	.background-window.depth-a {
		translate:
			calc(var(--far-a-x) + var(--drift-x))
			calc(var(--far-a-y) + var(--drift-y));
	}

	.background-window.depth-b {
		translate:
			calc(var(--far-b-x) + var(--drift-x))
			calc(var(--far-b-y) + var(--drift-y));
	}

	.background-window.depth-c {
		translate:
			calc(var(--far-c-x) + var(--drift-x))
			calc(var(--far-c-y) + var(--drift-y));
	}

	.mini-dots {
		position: absolute;
		top: 6px;
		left: 7px;
		display: flex;
		gap: 3px;
	}

	.mini-dots i {
		width: clamp(3px, 0.25vw, 5px);
		height: clamp(3px, 0.25vw, 5px);
		border-radius: 50%;
		background: rgb(253 191 191 / 58%);
	}

	.mini-dots i:nth-child(2) {
		background: rgb(239 218 74 / 58%);
	}

	.mini-dots i:nth-child(3) {
		background: rgb(124 245 181 / 58%);
	}

	.mini-symbol {
		padding-top: 6px;
		font-family: var(--font-display);
		font-size: var(--symbol-size);
		line-height: 1;
	}

	.masthead {
		position: relative;
		z-index: 8;
		display: flex;
		align-items: flex-start;
		justify-content: flex-end;
		min-height: 0;
		pointer-events: none;
	}

	.location {
		position: absolute;
		z-index: 9;
		top: 3%;
		right: 49%;
		bottom: auto;
		font-size: clamp(1.8rem, 3.1vw, 3.7rem);
		font-weight: 950;
		letter-spacing: -0.07em;
		line-height: 1;
		text-decoration: none;
		transform: translateX(96px);
	}

	.location-name {
		position: relative;
		z-index: 1;
		display: block;
		white-space: nowrap;
	}

	.location-roles {
		position: absolute;
		z-index: 1;
		top: calc(100% + clamp(8px, 0.8vw, 13px) + 12px);
		right: -140px;
		font-size: clamp(0.64rem, 0.95vw, 1rem);
		font-weight: 900;
		letter-spacing: 0.01em;
		line-height: 1;
		clip-path: inset(0 100% 100% 0);
		text-align: right;
		white-space: nowrap;
	}

	.name-block {
		position: relative;
	}

	.location-box {
		position: absolute;
		z-index: 0;
		top: -18px;
		left: -0.9em;
		width: 2.05em;
		height: 90px;
		border: 3px dashed var(--black);
	}

	.selection-cursor {
		position: absolute;
		top: 100%;
		left: 100%;
		width: 38px;
		height: 44px;
		background: var(--black);
		clip-path: polygon(0 0, 100% 58%, 58% 69%, 38% 100%);
		cursor: grab;
		pointer-events: auto;
		touch-action: none;
	}

	.selection-cursor:active {
		cursor: grabbing;
	}

	.window {
		display: flex;
		border-radius: 30px;
		background: var(--black);
		color: var(--white);
		text-decoration: none;
	}

	.window,
	.work-card,
	.play-window {
		border: 1px solid rgb(255 255 255 / 46%);
		outline: 1px solid rgb(255 255 255 / 12%);
		outline-offset: -3px;
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
	}

	.window-dots {
		display: flex;
		gap: 8px;
	}

	.window-dots i {
		width: 13px;
		height: 13px;
		border: 1px solid rgb(37 37 37 / 18%);
		border-radius: 50%;
		background: var(--pink);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 48%),
			0 1px 3px rgb(37 37 37 / 32%);
	}

	.window-dots i:nth-child(2) {
		background: var(--yellow);
	}

	.window-dots i:nth-child(3) {
		background: var(--mint);
	}

	.contact-window {
		--tab-scale: 1;
		position: absolute;
		z-index: 12;
		top: calc(-20% - 3px);
		right: -55px;
		left: auto;
		width: 132px;
		height: 132px;
		padding: 17px;
		border-radius: 27px;
		background: rgb(147 233 249 / 82%);
		transform: scale(var(--tab-scale));
		transform-origin: top left;
	}

	.contact-window .window-dots {
		position: absolute;
		z-index: 2;
		top: 17px;
		left: 17px;
	}

	.contact-plane {
		position: absolute;
		z-index: 1;
		top: 53%;
		left: 50%;
		width: 58px;
