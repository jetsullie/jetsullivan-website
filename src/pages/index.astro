	.search-bar {
		position: fixed;
		z-index: 99;
		top: clamp(18px, 3vh, 32px);
		left: calc(clamp(18px, 3vw, 48px) + 76px);
		display: flex;
		align-items: center;
		width: 64px;
		min-width: 64px;
		height: 64px;
		min-height: 64px;
		margin: 0;
		padding: 0;
		border: 1px solid rgb(255 255 255 / 58%);
		border-radius: 999px;
		outline: 1px solid rgb(255 255 255 / 16%);
		outline-offset: -3px;
		background: rgb(255 255 255 / 64%);
		box-shadow: 0 8px 28px rgb(37 37 37 / 14%);
		overflow: hidden;
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		transition:
			width 420ms cubic-bezier(0.34, 1.35, 0.64, 1),
			background-color 180ms ease,
			box-shadow 240ms ease,
			transform 280ms cubic-bezier(0.34, 1.4, 0.64, 1);
	}

	.search-bar:not(.is-closing):not(.suppress-hover):hover,
	.search-bar.is-open:focus-within {
		background: rgb(255 255 255 / 78%);
		box-shadow:
			0 8px 28px rgb(37 37 37 / 14%),
			0 0 18px rgb(255 255 255 / 38%);
		transform: translateY(3px);
	}

	.search-bar.is-open {
		width: min(50vw, 690px);
		overflow: visible;
		animation: search-open-glow 2.8s ease-in-out infinite;
	}

	.search-bar:not(.is-open) {
		transition-duration: 300ms;
	}

	.search-bar.is-closing {
		background: rgb(255 255 255 / 64%);
		box-shadow: 0 8px 28px rgb(37 37 37 / 14%);
	}

	.search-bar.is-closing::after {
		position: absolute;
		z-index: 0;
		top: 50%;
		left: 31px;
		width: 46px;
		height: 46px;
		border: 2px solid rgb(147 233 249 / 48%);
		border-radius: 50%;
		box-shadow: 0 0 12px rgb(147 233 249 / 24%);
		content: "";
		pointer-events: none;
		transform: translate(-50%, -50%) scale(0.12);
		animation: search-close-ripple 390ms ease-out forwards;
	}

	.search-toggle {
		position: relative;
		z-index: 1;
		display: grid;
		flex: 0 0 62px;
		height: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: pointer;
		place-items: center;
	}

	.search-input {
		width: 0;
		min-width: 0;
		padding: 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--black);
		font: 700 1rem var(--font-body);
		opacity: 0;
		transform: translateX(-12px);
		transition:
			width 280ms ease,
			opacity 160ms ease 60ms,
			transform 320ms cubic-bezier(0.34, 1.4, 0.64, 1);
	}

	.search-input::placeholder {
		color: rgb(37 37 37 / 55%);
	}

	.search-input::-webkit-search-cancel-button {
		display: none;
	}

	.search-bar.is-open .search-input {
		width: calc(100% - 136px);
		opacity: 1;
		transform: translateX(0);
	}

	.search-close {
		position: relative;
		display: grid;
		flex: 0 0 62px;
		height: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: pointer;
		opacity: 0;
		pointer-events: none;
		place-items: center;
		transform: translateX(15px) scale(0.65);
		transition:
			opacity 150ms ease,
			transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.search-bar.is-open .search-close {
		opacity: 1;
		pointer-events: auto;
		transform: translateX(15px) scale(1);
	}

	.search-suggestions {
		position: absolute;
		top: calc(100% + 4px);
		left: -16px;
		display: grid;
		width: calc(100% + 32px);
		max-height: min(430px, calc(100dvh - 102px));
		margin: 0;
		padding: 12px 16px 24px;
		gap: 8px;
		overflow-x: hidden;
		overflow-y: auto;
		border: 0;
		outline: 0;
		background: transparent;
		box-shadow: none;
		scrollbar-color: rgb(255 255 255 / 34%) transparent;
		scrollbar-width: thin;
	}

	.search-suggestions[hidden] {
		display: none;
	}

	:global(.search-suggestion) {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		min-height: 52px;
		padding: 9px 12px 9px 15px;
		column-gap: 16px;
		border: 1px solid rgb(255 255 255 / 38%);
		border-radius: 16px;
		background: rgb(47 51 57 / 45%);
		box-shadow:
			0 8px 20px rgb(20 22 25 / 13%),
			inset 0 1px 0 rgb(255 255 255 / 28%);
		color: rgb(27 30 34 / 96%);
		text-decoration: none;
		-webkit-backdrop-filter: blur(12px) saturate(1.1);
		backdrop-filter: blur(12px) saturate(1.1);
		animation:
			search-suggestion-cascade var(--suggestion-duration, 330ms) cubic-bezier(0.22, 1, 0.36, 1) var(--suggestion-delay, 55ms) both,
			search-suggestion-glow 2.8s ease-in-out infinite;
		transition:
			background-color 150ms ease,
			border-color 150ms ease;
	}

	:global(.search-suggestion:hover),
	:global(.search-suggestion.is-active) {
		border-color: rgb(255 255 255 / 58%);
		background: rgb(47 51 57 / 54%);
	}

	:global(.search-suggestion-copy) {
		display: grid;
		min-width: 0;
		gap: 1px;
	}

	:global(.search-suggestion strong) {
		overflow: hidden;
		font: 800 0.96rem/1.2 var(--font-body);
		letter-spacing: -0.01em;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	:global(.search-suggestion small) {
		overflow: hidden;
		color: rgb(27 30 34 / 82%);
		font: 650 0.72rem/1.25 var(--font-body);
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	:global(.search-suggestion-arrow) {
		display: grid;
		width: 30px;
		height: 30px;
		border: 1px solid rgb(27 30 34 / 14%);
		border-radius: 50%;
		background: rgb(255 255 255 / 16%);
		font: 800 1rem/1 var(--font-body);
		place-items: center;
	}

	:global(.search-empty) {
		margin: 0;
		padding: 17px 15px;
		border: 1px solid rgb(255 255 255 / 38%);
		border-radius: 16px;
		background: rgb(47 51 57 / 45%);
		box-shadow:
			0 8px 20px rgb(20 22 25 / 13%),
			inset 0 1px 0 rgb(255 255 255 / 28%);
		color: rgb(27 30 34 / 84%);
		font: 700 0.84rem/1.35 var(--font-body);
		text-align: center;
		-webkit-backdrop-filter: blur(12px) saturate(1.1);
		backdrop-filter: blur(12px) saturate(1.1);
		animation:
			search-suggestion-cascade var(--suggestion-duration, 330ms) cubic-bezier(0.22, 1, 0.36, 1) var(--suggestion-delay, 55ms) both,
			search-suggestion-glow 2.8s ease-in-out infinite;
	}

	.search-close span {
		position: relative;
		display: block;
		width: 17px;
		height: 3px;
		border-radius: 999px;
		background: var(--black);
		transform: rotate(45deg);
	}

	.search-close span::after {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: inherit;
		content: "";
		transform: rotate(90deg);
	}

	@keyframes search-open-glow {
		0%,
		100% {
			box-shadow:
				0 8px 28px rgb(37 37 37 / 14%),
				0 0 18px rgb(147 233 249 / 48%),
				0 0 38px rgb(147 233 249 / 20%);
		}

		33% {
			box-shadow:
				0 8px 28px rgb(37 37 37 / 14%),
				0 0 20px rgb(253 191 191 / 52%),
				0 0 42px rgb(253 191 191 / 22%);
		}

		66% {
			box-shadow:
				0 8px 28px rgb(37 37 37 / 14%),
				0 0 20px rgb(124 245 181 / 50%),
				0 0 42px rgb(124 245 181 / 20%);
		}
