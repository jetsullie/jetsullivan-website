---
import Arrow from "../components/common/Arrow.astro";
import SiteMenu from "../components/common/SiteMenu.astro";
import PageMotion from "../components/common/PageMotion.astro";
import HomeGlass from "../components/common/HomeGlass.astro";
import "../styles/home.css";
import "../styles/home-search.css";

const name = "Jet Sullivan";
const pageTitle = `${name} — Actor, Content Creator, and Filmmaker`;
const pageDescription = "Jet Sullivan is an Austin-based actor, producer, and content creator.";
const sections = [
 { id: "about", kicker: "THE PERSON BEHIND THE WORK", lead: "Who is", title: "JET?", tone: "mint", card: "About me.", action: "Meet Jet", href: "/about/", caption: "A little more about the person behind the camera.", copy: "My name is Jet Sullivan, and I am a Moody Honors Radio-Television-Film senior student at the University of Texas at Austin. I am an actor, producer, and videographer." },
 { id: "media", kicker: "IN THE SPOTLIGHT", lead: "News &", title: "MEDIA.", tone: "blue", card: "The latest.", action: "View media", href: "/media/", caption: "Projects, conversations, and a look behind the scenes.", copy: "See what’s new with Jet—from featured projects and interviews to press coverage and moments from behind the scenes." },
 { id: "gear", kicker: "BEHIND THE WORK", lead: "Tools for", title: "THE STORY.", tone: "pink", card: "My gear.", action: "Explore the gear", href: "/gear/", caption: "The cameras, sound, and light behind the stories.", copy: "Take a closer look at the equipment I work with. Explore the collection, see what’s in each kit, and find the tools that bring a project to life." },
 { id: "contact", kicker: "LET’S MAKE SOMETHING", lead: "Start a", title: "CONVERSATION.", tone: "blue", card: "Let’s talk.", action: "Contact Jet", href: "/contact/", caption: "A project, a role, or an idea. It starts with hello.", copy: "Have a project, role, collaboration, or story in mind? Reach out to Jet and start the conversation." },
];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content={pageDescription}
		/>
		<meta name="robots" content="max-snippet:69" />
		<link rel="canonical" href="https://jetsullivan.com/" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://jetsullivan.com/" />
		<meta property="og:site_name" content={name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<link rel="icon" type="image/png" sizes="512x512" href="/brand-center-favicon.png" />
		<title>{pageTitle}</title>
	</head>
 <body class="home-page">
  <a class="home-skip" href="#main">Skip to content</a>
  <SiteMenu />
		<form class="search-bar" action="/" method="get" role="search">
			<button
				class="search-toggle"
				type="button"
				aria-expanded="false"
				aria-label="Open site search"
			>
				<span class="magnifier" aria-hidden="true"></span>
			</button>
			<input
				class="search-input"
				type="search"
				name="q"
				placeholder="Where do you want to go?"
				aria-label="Search the site"
				autocomplete="off"
				spellcheck="false"
				role="combobox"
				aria-autocomplete="list"
				aria-controls="site-search-suggestions"
				aria-expanded="false"
				aria-hidden="true"
				tabindex="-1"
			/>
			<button
				class="search-close"
				type="button"
				aria-label="Close site search"
				aria-hidden="true"
				tabindex="-1"
			>
				<span aria-hidden="true"></span>
			</button>
			<button
				class="visually-hidden"
				type="submit"
				aria-hidden="true"
				tabindex="-1"
			>Search</button>
			<div
				id="site-search-suggestions"
				class="search-suggestions"
				role="listbox"
				aria-label="Suggested pages"
				hidden
			></div>
			<p class="visually-hidden" data-search-status role="status" aria-live="polite"></p>
		</form>

  <main id="main">
   <section class="canvas" data-motion-root aria-labelledby="page-title">
    <HomeGlass tone="blue" />
    <div class="hero-wrap">
     <div class="hero-topline"><span class="eyebrow">ACTOR · FILMMAKER · CREATOR</span><span class="hero-location"><i aria-hidden="true"></i><span data-site-location="short">Austin, TX</span></span></div>
     <div class="hero-composition">
      <div class="hero-copy">
       <h1 id="page-title"><span>JET</span><span class="hero-surname">SULLIVAN</span></h1>
       <p>On screen. Behind the camera.<br />Always here for a good story.</p>
       <a class="hero-explore" href="#explore">Explore my work <Arrow direction="down" /></a>
      </div>
      <div class="portrait-frame">
       <img class="portrait" data-portrait-trigger src="/jet-portrait.jpg" alt="Jet Sullivan" aria-label="Release camera emojis from Jet's portrait" role="button" tabindex="0" draggable="false" width="605" height="1816" fetchpriority="high" />
       <div class="portrait-caption"><span>JET SULLIVAN</span><span>ACTOR & FILMMAKER</span></div>
      </div>
     </div>
    </div>
    <div class="portrait-emoji-layer" aria-hidden="true"></div>
   </section>
   <div id="explore" class="work-band">
		<div class="work-grid-stage hero-work-grid-stage">
			<nav class="work-grid" aria-label="Explore Jet Sullivan's work">
				<a class="work-card card-media" href="/socials/">

					<span class="work-card-icon social-icon" aria-hidden="true">
						<svg viewBox="0 0 96 96" focusable="false">
							<path d="M33 12a16 16 0 1 1 0 32 16 16 0 0 1 0-32ZM6 78c1.5-20 11.1-31 27-31s25.5 11 27 31ZM67 18a13 13 0 1 1 0 26 13 13 0 0 1 0-26ZM45 78c1.3-19 9.4-30 22-30s20.7 11 22 30Z"></path>
						</svg>
					</span>
					<span class="work-card-label">Socials</span><span class="work-card-arrow" aria-hidden="true"><Arrow /></span>
				</a>
				<a class="work-card card-directing" href="/acting/">

					<span class="work-card-icon acting-icon" aria-hidden="true">
						<svg viewBox="0 0 96 96" focusable="false">
							<defs>
								<mask id="acting-eye-cutouts" maskUnits="userSpaceOnUse" x="0" y="0" width="96" height="96">
									<rect width="96" height="96" fill="white"></rect>
									<path d="M28 45Q36 39 43 45" fill="none" stroke="black" stroke-width="6" stroke-linecap="round"></path>
									<circle cx="61" cy="43" r="7" fill="black"></circle>
								</mask>
							</defs>
							<path
								mask="url(#acting-eye-cutouts)"
								d="M16 21Q48 10 80 21L77 57Q73 80 48 89Q23 80 19 57Z"
							></path>
						</svg>
					</span>
					<span class="work-card-label">Acting</span><span class="work-card-arrow" aria-hidden="true"><Arrow /></span>
				</a>
				<a class="work-card card-film" href="/film/">

					<span class="work-card-icon slate-icon" aria-hidden="true">
						<svg viewBox="0 0 96 96" focusable="false">
							<defs>
								<mask id="slate-cutouts" maskUnits="userSpaceOnUse" x="0" y="0" width="96" height="96">
									<rect width="96" height="96" fill="white"></rect>
									<path
										d="M28 32.3 35.7 30.3 38.5 40.9 30.8 42.9ZM45.3 27.7 52.9 25.7 55.7 36.3 48.1 38.3ZM62.5 23.1 70.2 21.1 73 31.7 65.3 33.8Z"
										fill="black"
									></path>
									<rect x="28" y="55" width="40" height="5" rx="2.5" fill="black"></rect>
									<rect x="28" y="67" width="27" height="5" rx="2.5" fill="black"></rect>
								</mask>
							</defs>
							<path
								mask="url(#slate-cutouts)"
								d="M16 31 80 14l5 19-64 17ZM21 47h64v34a7 7 0 0 1-7 7H28a7 7 0 0 1-7-7Z"
							></path>
						</svg>
					</span>
					<span class="work-card-label">Film</span><span class="work-card-arrow" aria-hidden="true"><Arrow /></span>
				</a>
				<a class="work-card card-video" href="/video/">

					<span class="work-card-icon camera-icon" aria-hidden="true">
						<svg viewBox="0 0 96 96" focusable="false">
							<rect x="9" y="27" width="58" height="44" rx="9"></rect>
							<path d="M67 40 88 29v38L67 56Z"></path>
						</svg>
					</span>
					<span class="work-card-label">Video</span><span class="work-card-arrow" aria-hidden="true"><Arrow /></span>
				</a>
			</nav>
		</div>

   </div>
   {sections.map((section, index) => (
    <section class:list={["home-section", `${section.id}-section`, `tone-${section.tone}`, {"section-light": index % 2 === 0, "section-reverse": index % 2 === 1}]} aria-labelledby={`${section.id}-heading`} data-motion-root>
     <HomeGlass tone={section.tone} />
     <div class="section-content">
      <div class="section-heading"><p class="eyebrow">{section.kicker}</p><h2 id={`${section.id}-heading`}>{section.lead}{" "}<span class="home-ink" data-home-shimmer>{section.title}</span></h2></div>
      <div class="section-layout">
       <div class="section-copy"><p>{section.copy}</p></div>
       <a class="section-tab" href={section.href}>
        <span class="eyebrow">{String(index+1).padStart(2,"0")} / {section.id.toUpperCase()}</span>
        <strong>{section.card}</strong><span class="section-tab-description">{section.caption}</span>
        <span class="section-tab-action">{section.action}<span class="action-circle"><Arrow /></span></span>
       </a>
      </div>
     </div>
    </section>
   ))}
  </main>
  <footer class="site-footer"><a class="footer-name" href="/">Jet Sullivan</a><span data-site-location="long">Austin, Texas</span><a href="/contact/">Let’s make something. <Arrow /></a></footer>
  <PageMotion />
 </body>
</html>
<script>
 import "../scripts/home";
</script>
