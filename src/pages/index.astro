	@keyframes search-suggestion-glow {
		0%,
		100% {
			box-shadow:
				0 8px 20px rgb(20 22 25 / 13%),
				0 0 12px rgb(147 233 249 / 40%),
				0 0 22px rgb(147 233 249 / 15%),
				inset 0 1px 0 rgb(255 255 255 / 28%);
		}

		33% {
			box-shadow:
				0 8px 20px rgb(20 22 25 / 13%),
				0 0 13px rgb(253 191 191 / 42%),
				0 0 24px rgb(253 191 191 / 16%),
				inset 0 1px 0 rgb(255 255 255 / 28%);
		}

		66% {
			box-shadow:
				0 8px 20px rgb(20 22 25 / 13%),
				0 0 13px rgb(124 245 181 / 40%),
				0 0 24px rgb(124 245 181 / 15%),
				inset 0 1px 0 rgb(255 255 255 / 28%);
		}
	}

	@keyframes search-close-ripple {
		0% {
			opacity: 0.8;
			transform: translate(-50%, -50%) scale(0.12);
		}

		68% {
			opacity: 0.32;
