---
import "../../styles/post-bubbles.css";
interface Props {
	accentTop: string;
	accent: string;
	accentBottom: string;
	accentSolid?: string;
}

const {
	accentTop,
	accent,
	accentBottom,
	accentSolid = accentBottom,
} = Astro.props;
---

<dialog
	class="post-dialog"
	data-post-dialog
	aria-label="Expanded post"
	style={`--post-accent-top:${accentTop};--post-accent:${accent};--post-accent-bottom:${accentBottom};--post-accent-solid:${accentSolid};`}
>
	<div class="post-dialog-panel" data-post-dialog-panel>
  <div class="post-dialog-toolbar"><span>Jet Sullivan <span aria-hidden="true">/</span> In detail</span>
		<button
			class="post-dialog-close"
			type="button"
			data-post-dialog-close
			aria-label="Close expanded post"
		>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M6 6l12 12M18 6L6 18"></path>
			</svg>
		</button>
  </div>
		<div class="post-dialog-content" data-post-dialog-content></div>
	</div>
</dialog>

<style is:global>
	.post-dialog {
		position: fixed;
		inset: 0;
		width: 100vw;
		width: 100dvw;
		height: 100vh;
		height: 100dvh;
		max-width: 100vw;
		max-height: 100dvh;
		padding: 0;
		margin: 0;
		overflow: hidden;
		border: 0;
		background: transparent;
		color: #252525;
		display: none;
		align-items: center;
		justify-content: center;
	}

	.post-dialog[open] {
		display: flex;
		animation: none;
	}

	.post-dialog::backdrop {
		background: rgb(37 37 37 / 46%);
		transition: background-color 260ms ease, backdrop-filter 260ms ease;
		-webkit-backdrop-filter: blur(9px);
		backdrop-filter: blur(9px);
	}

	.post-dialog[data-closing]::backdrop { background: transparent; -webkit-backdrop-filter: blur(0); backdrop-filter: blur(0); }
	@starting-style {
		.post-dialog[open]::backdrop { background: transparent; -webkit-backdrop-filter: blur(0); backdrop-filter: blur(0); }
	}

	.post-dialog-panel {
		position: relative;
		width: min(920px, calc(100vw - 40px));
		max-width: 920px;
		max-height: calc(100dvh - 32px);
		padding: 68px clamp(24px, 4vw, 44px) 36px;
		overflow: auto;
		border: 1px solid rgb(255 255 255 / 72%);
		border-radius: 34px;
		outline: 1px solid rgb(255 255 255 / 20%);
		outline-offset: -4px;
		background:
			linear-gradient(
				145deg,
				rgb(255 255 255 / 84%),
				color-mix(in srgb, var(--post-accent) 22%, rgb(255 255 255 / 76%))
			);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 78%),
			0 28px 90px rgb(0 0 0 / 34%),
			0 0 45px color-mix(in srgb, var(--post-accent-solid) 24%, transparent);
		-webkit-backdrop-filter: blur(20px) saturate(1.12);
		backdrop-filter: blur(20px) saturate(1.12);
		scrollbar-gutter: stable;
	}

	.post-dialog-close {
		position: absolute;
		z-index: 20;
		top: clamp(16px, 2.4vw, 25px);
		right: clamp(16px, 2.4vw, 25px);
		display: grid;
		width: 46px;
		height: 46px;
		padding: 0;
		border: 1px solid rgb(255 255 255 / 76%);
		border-radius: 50%;
		outline: 1px solid rgb(37 37 37 / 10%);
		outline-offset: -3px;
		background: rgb(255 255 255 / 66%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 86%),
			0 6px 18px rgb(37 37 37 / 13%);
		color: #252525;
		cursor: pointer;
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		place-items: center;
		transition: background-color 160ms ease, box-shadow 160ms ease;
	}

	.post-dialog-close:hover {
		background: rgb(255 255 255 / 90%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 92%),
			0 0 22px color-mix(in srgb, var(--post-accent-solid) 48%, transparent);
	}

	.post-dialog-close:focus-visible {
		outline: 3px solid var(--post-accent-solid);
		outline-offset: 4px;
	}

	.post-dialog-close svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.4;
		stroke-linecap: round;
	}

	.post-dialog-content {
		min-width: 0;
	}

	.post-dialog .post-detail {
		display: flex;
		flex-direction: column;
		gap: clamp(24px, 4vw, 42px);
		min-height: 0;
		margin: 0;
		padding: 0;
		overflow: visible;
		border: 0;
		border-radius: 0;
		outline: 0;
		background: transparent;
		box-shadow: none;
		animation: none;
		transform: none;
		translate: none;
	}

	.post-dialog .post-detail .entry-copy {
		order: -1;
		min-width: 0;
		width: 100%;
		overflow: visible;
	}

	.post-dialog .post-detail h2 {
		display: block;
		margin: 0;
		font: 700 clamp(1.5rem, 3vw, 2.25rem)/1.2 "Myriad Pro", Myriad, Arial, sans-serif;
		letter-spacing: -.025em;
		overflow-wrap: anywhere;
		text-transform: none;
	}

	.post-dialog .post-detail .entry-copy > p {
		display: block;
		margin: 20px 0 0;
		color: rgb(37 37 37 / 82%);
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.75;
		white-space: pre-wrap;
	}

	.post-dialog .post-detail time {
		display: block;
		margin-bottom: 14px;
		color: color-mix(in srgb, var(--post-accent-bottom) 72%, #252525);
		font-size: .82rem;
		font-weight: 900;
		letter-spacing: .1em;
		text-transform: none;
	}

	.post-dialog .post-detail .entry-copy > a,
	.post-dialog .post-detail .entry-attachment > a {
		display: inline-flex;
		margin-top: 28px;
		padding: 0;
		color: color-mix(in srgb, var(--post-accent-bottom) 74%, #252525);
		font: 900 .92rem var(--display, "Arial Black", Arial, sans-serif);
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
		text-transform: none;
	}

	.post-dialog .post-detail .entry-copy > a:focus-visible,
	.post-dialog .post-detail .entry-attachment > a:focus-visible {
		border-radius: 4px;
		outline: 3px solid var(--post-accent-solid);
		outline-offset: 5px;
	}

	.post-dialog .post-detail .entry-image,
	.post-dialog .post-detail .entry-attachment {
		flex: none;
		width: 100%;
		height: auto;
		margin: 0;
		overflow: hidden;
		border-radius: 22px;
		background: rgb(37 37 37 / 8%);
	}

	.post-dialog .post-detail .entry-image img,
	.post-dialog .post-detail .entry-attachment img,
	.post-dialog .post-detail .entry-attachment video,
	.post-dialog .post-detail .entry-attachment iframe {
		display: block;
		width: 100%;
		height: auto;
		min-height: 0;
		max-height: 68dvh;
		border: 0;
		background: #252525;
		object-fit: contain;
	}

	.post-dialog .post-detail .entry-attachment iframe {
		height: min(68dvh, 760px);
		max-height: none;
	}

	.post-dialog .post-detail .audio-attachment,
	.post-dialog .post-detail .file-attachment {
		padding: 24px;
	}

	.post-dialog .post-detail .audio-attachment audio {
		display: block;
		width: 100%;
	}

	.post-dialog .post-detail .pdf-attachment > a {
		margin: 18px 22px 22px;
	}

	.post-dialog .post-detail .entry-source {
		display: inline-flex;
		align-items: center;
		min-height: 29px;
		margin-bottom: 14px;
		padding: 6px 11px;
		border: 1px solid color-mix(in srgb, var(--post-accent-solid) 38%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--post-accent) 34%, rgb(255 255 255 / 62%));
		color: color-mix(in srgb, var(--post-accent-bottom) 74%, #252525);
		font: 900 .72rem var(--display, "Arial Black", Arial, sans-serif);
		letter-spacing: .08em;
		text-transform: none;
	}

	@media (max-width: 640px) {
		.post-dialog {
			width: calc(100vw - 16px);
			max-height: calc(100dvh - 16px);
		}

		.post-dialog-panel {
			max-height: calc(100dvh - 16px);
			padding: 70px 19px 28px;
			border-radius: 24px;
		}

		.post-dialog-close {
			top: 13px;
			right: 13px;
			width: 44px;
			height: 44px;
		}

		.post-dialog .post-detail h2 {
			font-size: 1.6rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.post-dialog[open] { animation: none; }
		.post-dialog-close { transition: none; }
	}

 /* One restrained surface shared with the compact post bubbles. */
 .post-dialog .post-dialog-panel {
  width: min(920px, calc(100vw - 40px));
  max-width: 920px;
  padding:0; border-radius:24px; border:1px solid #66736e; outline:0;
  background:#282e2c; color:#f3f6f4; box-shadow:0 32px 100px #0008;
  scrollbar-gutter:auto;
 }
 .post-dialog-toolbar {
  position:sticky; top:0; z-index:30; display:flex; align-items:center; justify-content:space-between;
  gap:16px; padding:14px 20px; border-bottom:1px solid #ffffff18;
  background:#282e2cf5; backdrop-filter:blur(16px);
  color:#b5c4bc; font:600 11px/1.4 'Myriad Pro',Arial,sans-serif; letter-spacing:.09em; text-transform:uppercase;
 }
 .post-dialog-toolbar > span > span { margin:0 10px; color:var(--post-accent-solid); }
 .post-dialog .post-dialog-close {
  position:static; flex:none; width:36px; height:36px; border:1px solid #ffffff30;
  background:#ffffff08; color:#eff5f1; box-shadow:none; backdrop-filter:none;
 }
 .post-dialog .post-dialog-close:hover { background:#ffffff18; transform:rotate(90deg); }
 .post-dialog .post-dialog-content { padding:28px; }
 .post-dialog .post-detail { gap:24px; }
 .post-dialog .post-detail:has(> .entry-image, > .entry-attachment) { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(0,1fr); align-items:start; }
 .post-dialog .post-detail .entry-copy { order:0; }
 .post-dialog .post-detail h2 { color:#f4f6f5; font-size:clamp(24px,3vw,32px); font-weight:600; line-height:1.15; }
 .post-dialog .post-detail .entry-copy > p { color:#c7d1cc; font:400 15px/1.75 'Myriad Pro',Arial,sans-serif; margin-top:18px; }
 .post-dialog .post-detail time { color:#9eafa6; font:500 11px/1.4 'Myriad Pro',Arial,sans-serif; letter-spacing:.025em; }
 .post-dialog .post-detail .entry-source { background:#ffffff08; color:#c6d5cd; border-color:#ffffff25; font-weight:500; }
 .post-dialog .post-detail :is(.entry-image,.entry-attachment) { order:-1; border-radius:16px; background:#171c19; }
 .post-dialog .post-detail :is(.entry-image,.entry-attachment) :is(img,video) { max-height:58dvh; background:#171c19; }
 .post-dialog .post-detail .entry-copy > a,
 .post-dialog .post-detail .entry-attachment > a {
  display:inline-flex; align-items:center; gap:8px; padding:11px 15px; border:1px solid #ffffff32; border-radius:999px;
  color:#e5eee9; background:#ffffff08; text-decoration:none; font:600 12px/1.4 'Myriad Pro',Arial,sans-serif;
 }
 .post-dialog .post-detail a:hover { background:#ffffff18; border-color:var(--post-accent-solid); }
 @media(max-width:640px) {
  .post-dialog .post-dialog-panel { width: calc(100vw - 16px); }
  .post-dialog .post-dialog-content { padding:20px; }
  .post-dialog .post-detail:has(> .entry-image, > .entry-attachment) { grid-template-columns:minmax(0,1fr); }
  .post-dialog .post-detail :is(.entry-image,.entry-attachment) :is(img,video) { max-height:32dvh; }
 }
</style>
