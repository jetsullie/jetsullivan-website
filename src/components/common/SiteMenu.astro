---
interface Props {
	showHomeButton?: boolean;
	homeButtonHref?: string;
	homeButtonLabel?: string;
}

const {
	showHomeButton = false,
	homeButtonHref = "/",
	homeButtonLabel = "Return to homepage",
} = Astro.props;

const menuItems = [
	{ href: "/", label: "Home" },
	{ href: "/about/", label: "About" },
	{ href: "/contact/", label: "Contact" },
	{ href: "/media/", label: "News/Media" },
	{ href: "/socials/", label: "Socials" },
	{ href: "/acting/", label: "Acting" },
	{ href: "/film/", label: "Film" },
	{ href: "/video/", label: "Video" },
];

const normalizePath = (path: string) =>
	path === "/" ? path : path.replace(/\/+$/, "");
const currentPath = normalizePath(Astro.url.pathname);
const visibleMenuItems = menuItems.filter(
	({ href }) => normalizePath(href) !== currentPath,
);
const expandedMenuHeight = 108 + visibleMenuItems.length * 41;
---

<div
	class="menu-control"
	style={`--menu-expanded-height: ${expandedMenuHeight}px;`}
>
	<button
		class="menu-toggle"
		type="button"
		aria-expanded="false"
		aria-controls="site-menu"
		aria-label="Open site menu"
	>
		<span aria-hidden="true"></span>
	</button>
	<nav
		id="site-menu"
		class="site-menu"
		aria-label="Main navigation"
		aria-hidden="true"
		inert
	>
		{visibleMenuItems.map(({ href, label }) => <a href={href}>{label}</a>)}
	</nav>
</div>

{
	showHomeButton && (
		<a class="home-bubble" href={homeButtonHref} aria-label={homeButtonLabel}>
			<svg
				class="home-arrow-icon"
				viewBox="0 0 26 20"
				aria-hidden="true"
			>
				<path d="M23 10H3M10 3L3 10L10 17"></path>
			</svg>
		</a>
	)
}

<script is:inline src="/site-menu.js" defer></script>

<style>
	:global(:root) {
		--site-control-top: max(
			clamp(18px, 3vh, 32px),
			calc(env(safe-area-inset-top) + 10px)
		);
		--site-control-left: max(
			clamp(18px, 3vw, 48px),
			calc(env(safe-area-inset-left) + 10px)
		);
		--site-control-right: max(18px, calc(env(safe-area-inset-right) + 10px));
		--site-control-bottom: max(18px, calc(env(safe-area-inset-bottom) + 10px));
		--site-control-size: 64px;
		--site-control-gap: 12px;
		--site-control-step: calc(var(--site-control-size) + var(--site-control-gap));
	}

	.menu-control {
		position: fixed;
		z-index: 100;
		top: var(--site-control-top);
		left: var(--site-control-left);
		display: flex;
		align-items: flex-start;
		width: 64px;
		height: 64px;
		border: 1px solid rgb(255 255 255 / 58%);
		border-radius: 32px;
		outline: 1px solid rgb(255 255 255 / 16%);
		outline-offset: -3px;
		background: rgb(255 255 255 / 64%);
		box-shadow: 0 8px 28px rgb(37 37 37 / 14%);
		overflow: hidden;
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		transition:
			width 320ms cubic-bezier(0.34, 1.25, 0.64, 1),
			height 360ms cubic-bezier(0.34, 1.2, 0.64, 1),
			border-radius 280ms ease,
			background-color 180ms ease,
			box-shadow 220ms ease,
			transform 280ms cubic-bezier(0.34, 1.4, 0.64, 1),
			opacity 160ms ease;
	}

	.menu-control.is-search-suppressed {
		visibility: hidden;
		opacity: 0;
		pointer-events: none;
	}

	.menu-control:not(.is-open):has(> .menu-toggle:hover) {
		background: rgb(255 255 255 / 78%);
		box-shadow:
			0 8px 28px rgb(37 37 37 / 14%),
			0 0 18px rgb(255 255 255 / 38%);
		transform: translateY(3px);
	}

	.home-bubble {
		position: fixed;
		z-index: 99;
		top: var(--site-control-top);
		left: calc(var(--site-control-left) + var(--site-control-step));
		display: grid;
		width: 64px;
		height: 64px;
		border: 1px solid rgb(255 255 255 / 58%);
		border-radius: 32px;
		outline: 1px solid rgb(255 255 255 / 16%);
		outline-offset: -3px;
		background: rgb(255 255 255 / 64%);
		box-shadow: 0 8px 28px rgb(37 37 37 / 14%);
		color: #252525;
		text-decoration: none;
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		place-items: center;
		transition:
			background-color 180ms ease,
			box-shadow 220ms ease,
			transform 280ms cubic-bezier(0.34, 1.4, 0.64, 1);
	}

	.home-arrow-icon {
		display: block;
		width: 26px;
		height: 20px;
		fill: none;
		stroke: #252525;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 4;
	}

	.home-bubble:hover {
		background: rgb(255 255 255 / 78%);
		box-shadow:
			0 8px 28px rgb(37 37 37 / 14%),
			0 0 18px rgb(255 255 255 / 38%);
		transform: translateX(-3px);
	}

	.menu-control.is-open {
		width: min(230px, calc(100vw - 36px));
		height: min(var(--menu-expanded-height), calc(100dvh - 36px));
		border-radius: 28px;
	}

	.menu-toggle {
		position: relative;
		display: grid;
		flex: 0 0 62px;
		width: 62px;
		height: 62px;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: pointer;
		place-items: center;
	}

	.menu-toggle > span,
	.menu-toggle > span::before,
	.menu-toggle > span::after {
		display: block;
		width: 24px;
		height: 3px;
		border-radius: 999px;
		background: #252525;
		content: "";
		transition:
			transform 240ms ease,
			opacity 180ms ease;
	}

	.menu-toggle > span {
		position: relative;
	}

	.menu-toggle > span::before,
	.menu-toggle > span::after {
		position: absolute;
		left: 0;
	}

	.menu-toggle > span::before {
		top: -8px;
	}

	.menu-toggle > span::after {
		top: 8px;
	}

	.menu-control.is-open .menu-toggle > span {
		background: transparent;
	}

	.menu-control.is-open .menu-toggle > span::before {
		top: 0;
		transform: rotate(45deg);
	}

	.menu-control.is-open .menu-toggle > span::after {
		top: 0;
		transform: rotate(-45deg);
	}

	.site-menu {
		position: absolute;
		top: 66px;
		bottom: 14px;
		right: 16px;
		left: 16px;
		display: grid;
		gap: 5px;
		align-content: start;
		overflow-y: auto;
		overscroll-behavior: contain;
		opacity: 0;
		pointer-events: none;
		transform: translateY(-8px);
		transition:
			opacity 160ms ease 50ms,
			transform 260ms cubic-bezier(0.34, 1.3, 0.64, 1);
	}

	.menu-control.is-open .site-menu {
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
	}

	.site-menu a {
		padding: 10px 13px;
		border-radius: 12px;
		color: #252525;
		font: 900 0.92rem "Arial Black", "Myriad Pro", Arial, sans-serif;
		text-decoration: none;
		text-transform: uppercase;
		transition:
			background-color 160ms ease,
			transform 220ms ease;
	}

	.site-menu a:hover {
		background: rgb(37 37 37 / 10%);
		transform: translateX(3px);
	}

	@media (max-width: 700px) {
		.menu-control {
			top: calc(var(--site-control-top) + var(--site-control-step));
			left: var(--site-control-left);
		}

		.home-bubble {
			top: var(--site-control-top);
			left: var(--site-control-left);
		}

		.menu-control.is-open {
			width: min(
				230px,
				calc(100vw - var(--site-control-left) - var(--site-control-right))
			);
			height: min(
				var(--menu-expanded-height),
				calc(
					100dvh - var(--site-control-top) - var(--site-control-step) -
						var(--site-control-bottom)
				)
			);
		}
	}

	.menu-toggle:focus-visible,
	.home-bubble:focus-visible,
	.site-menu a:focus-visible {
		outline: 3px solid #fdbfbf;
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.menu-control,
		.home-bubble,
		.menu-toggle > span,
		.menu-toggle > span::before,
		.menu-toggle > span::after,
		.site-menu,
		.site-menu a {
			transition: none;
		}

	}
</style>
