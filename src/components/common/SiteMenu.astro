---
interface Props {
	showHomeButton?: boolean;
}

const { showHomeButton = false } = Astro.props;
---

<div class="menu-control">
	<button
		class="menu-toggle"
		type="button"
		aria-expanded="false"
		aria-controls="site-menu"
		aria-label="Open site menu"
	>
		<span aria-hidden="true"></span>
	</button>
	<nav id="site-menu" class="site-menu" aria-label="Main navigation">
		<a href="/">Home</a>
		<a href="/about/">About</a>
		<a href="/socials/">Socials</a>
		<a href="/media/">Media</a>
		<a href="/contact/">Contact</a>
		<a href="/admin/">Admin</a>
	</nav>
</div>

{
	showHomeButton && (
		<a class="home-bubble" href="/" aria-label="Return to homepage">
			<svg
				class="home-arrow-icon"
				viewBox="0 0 26 20"
				aria-hidden="true"
			>
				<path d="M23 10H3M10 3L3 10L10 17"></path>
			</svg>
		</a>
	)
}

<script is:inline src="/site-menu.js" defer></script>

<style>
	.menu-control {
		position: fixed;
		z-index: 100;
		top: clamp(18px, 3vh, 32px);
		left: clamp(18px, 3vw, 48px);
		display: flex;
		align-items: flex-start;
		width: 64px;
		height: 64px;
		border: 1px solid rgb(255 255 255 / 58%);
		border-radius: 32px;
		outline: 1px solid rgb(255 255 255 / 16%);
		outline-offset: -3px;
		background: rgb(255 255 255 / 64%);
		box-shadow: 0 8px 28px rgb(37 37 37 / 14%);
		overflow: hidden;
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		transition:
			width 320ms cubic-bezier(0.34, 1.25, 0.64, 1),
			height 360ms cubic-bezier(0.34, 1.2, 0.64, 1),
			border-radius 280ms ease,
			background-color 180ms ease,
			box-shadow 220ms ease,
			transform 280ms cubic-bezier(0.34, 1.4, 0.64, 1);
	}

	.menu-control:not(.is-open):has(> .menu-toggle:hover) {
		background: rgb(255 255 255 / 78%);
		box-shadow:
			0 8px 28px rgb(37 37 37 / 14%),
			0 0 18px rgb(255 255 255 / 38%);
		transform: translateY(3px);
	}

	.home-bubble {
		position: fixed;
		z-index: 99;
		top: clamp(18px, 3vh, 32px);
		left: calc(clamp(18px, 3vw, 48px) + 76px);
		display: grid;
		width: 64px;
		height: 64px;
		border: 1px solid rgb(255 255 255 / 58%);
		border-radius: 32px;
		outline: 1px solid rgb(255 255 255 / 16%);
		outline-offset: -3px;
		background: rgb(255 255 255 / 64%);
		box-shadow: 0 8px 28px rgb(37 37 37 / 14%);
		color: #252525;
		text-decoration: none;
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		place-items: center;
		transition:
			background-color 180ms ease,
			box-shadow 220ms ease,
			transform 280ms cubic-bezier(0.34, 1.4, 0.64, 1);
	}

	.home-arrow-icon {
		display: block;
		width: 26px;
		height: 20px;
		fill: none;
		stroke: #252525;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 4;
	}

	.home-bubble:hover {
		background: rgb(255 255 255 / 78%);
		box-shadow:
			0 8px 28px rgb(37 37 37 / 14%),
			0 0 18px rgb(255 255 255 / 38%);
		transform: translateX(-3px);
	}

	.menu-control.is-open {
		width: min(230px, calc(100vw - 36px));
		height: 354px;
		border-radius: 28px;
	}

	.menu-toggle {
		position: relative;
		display: grid;
		flex: 0 0 62px;
		width: 62px;
		height: 62px;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: pointer;
		place-items: center;
	}

	.menu-toggle > span,
	.menu-toggle > span::before,
	.menu-toggle > span::after {
		display: block;
		width: 24px;
		height: 3px;
		border-radius: 999px;
		background: #252525;
		content: "";
		transition:
			transform 240ms ease,
			opacity 180ms ease;
	}

	.menu-toggle > span {
		position: relative;
	}

	.menu-toggle > span::before,
	.menu-toggle > span::after {
		position: absolute;
		left: 0;
	}

	.menu-toggle > span::before {
		top: -8px;
	}

	.menu-toggle > span::after {
		top: 8px;
	}

	.menu-control.is-open .menu-toggle > span {
		background: transparent;
	}

	.menu-control.is-open .menu-toggle > span::before {
		top: 0;
		transform: rotate(45deg);
	}

	.menu-control.is-open .menu-toggle > span::after {
		top: 0;
		transform: rotate(-45deg);
	}

	.site-menu {
		position: absolute;
		top: 66px;
		right: 16px;
		left: 16px;
		display: grid;
		gap: 5px;
		opacity: 0;
		pointer-events: none;
		transform: translateY(-8px);
		transition:
			opacity 160ms ease 50ms,
			transform 260ms cubic-bezier(0.34, 1.3, 0.64, 1);
	}

	.menu-control.is-open .site-menu {
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
	}

	.site-menu a {
		padding: 10px 13px;
		border-radius: 12px;
		color: #252525;
		font: 900 0.92rem "Arial Black", "Myriad Pro", Arial, sans-serif;
		text-decoration: none;
		text-transform: uppercase;
		transition:
			background-color 160ms ease,
			transform 220ms ease;
	}

	.site-menu a:hover {
		background: rgb(37 37 37 / 10%);
		transform: translateX(3px);
	}

	.menu-toggle:focus-visible,
	.home-bubble:focus-visible,
	.site-menu a:focus-visible {
		outline: 3px solid #fdbfbf;
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.menu-control,
		.home-bubble,
		.menu-toggle > span,
		.menu-toggle > span::before,
		.menu-toggle > span::after,
		.site-menu,
		.site-menu a {
			transition: none;
		}

	}
</style>
