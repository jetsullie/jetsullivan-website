---
interface Props { tone?: string; variant?: string }
const { tone = 'blue', variant = 'hero' } = Astro.props;
---
<div class:list={['home-glass', `home-glass--${tone}`, `home-glass--${variant}`]} aria-hidden="true">
 <span class="glass-panel-shape" data-home-motion="far"></span><span class="glass-orb-shape" data-home-motion="deep"></span><span class="glass-small-shape" data-home-motion="near"></span>
</div>
<style>
.home-glass{--tint:147 233 249;position:absolute;inset:0;z-index:-1;overflow:clip;pointer-events:none}
.home-glass--pink{--tint:253 191 191}.home-glass--mint{--tint:124 245 181}
.home-glass span{position:absolute;border:1px solid #ffffff45;background:linear-gradient(135deg,#ffffff15,rgb(var(--tint)/.14));box-shadow:inset 0 1px 0 #ffffff30,0 8px 28px #25252508;backdrop-filter:blur(3px)}
.glass-panel-shape{top:12%;right:-10%;width:min(42vw,600px);aspect-ratio:1;border-radius:32px;transform:rotate(-7deg)}
.glass-orb-shape{bottom:-22%;left:-12%;width:min(40vw,540px);aspect-ratio:1;border-radius:50%;background:linear-gradient(150deg,rgb(var(--tint)/.24),#ffffff08)!important}
.glass-small-shape{right:5%;top:60%;width:80px;aspect-ratio:1;border-radius:20px;transform:rotate(18deg)}
@media(max-width:650px){.glass-panel-shape{width:75vw;right:-30%}.glass-orb-shape{width:75vw;left:-35%}.glass-small-shape{width:50px;right:-2%}}
/* Consistent glass material; vary scale and placement without oversized bands. */
.home-glass--about .glass-panel-shape{width:min(33vw,430px);right:-8%;top:8%;border-radius:48px;transform:rotate(12deg)}
.home-glass--about .glass-orb-shape{width:170px;left:38%;bottom:-100px}
.home-glass--about .glass-small-shape{right:19%;top:70%;width:64px}
.home-glass--media .glass-panel-shape{width:min(32vw,410px);aspect-ratio:1;right:auto;left:-10%;top:5%;border-radius:50%;transform:none}
.home-glass--media .glass-orb-shape{width:190px;left:28%;bottom:-110px}
.home-glass--media .glass-small-shape{width:70px;right:5%;top:16%;transform:rotate(-12deg)}
.home-glass--gear .glass-panel-shape{width:min(28vw,360px);right:-9%;top:12%;border-radius:48px;transform:rotate(-12deg)}
.home-glass--gear .glass-orb-shape{width:220px;left:-130px;bottom:8%}
.home-glass--gear .glass-small-shape{width:60px;right:39%;top:7%;transform:rotate(12deg)}
.home-glass--contact .glass-panel-shape{width:min(32vw,400px);right:-13%;top:35%;border-radius:44px;transform:rotate(12deg)}
.home-glass--contact .glass-orb-shape{width:min(24vw,280px);left:-12%;bottom:-20%}
.home-glass--contact .glass-small-shape{width:54px;right:24%;top:10%;border-radius:50%}
@media(max-width:650px){
 .home-glass--about .glass-panel-shape{width:65vw;right:-35%;top:9%}
 .home-glass--media .glass-panel-shape{width:60vw;left:-34%;top:2%}
 .home-glass--media .glass-orb-shape{width:150px;left:30%;bottom:-100px}
 .home-glass--gear .glass-panel-shape{width:65vw;right:-40%;top:7%}
 .home-glass--contact .glass-panel-shape{width:60vw;right:-40%;top:48%}
 .home-glass--contact .glass-orb-shape{width:50vw;left:-32%;bottom:-14%}
}
</style>
