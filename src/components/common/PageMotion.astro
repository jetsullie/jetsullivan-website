<script>
	const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
	const depthNames = ["far-a", "far-b", "far-c"] as const;

	document.querySelectorAll<HTMLElement>("[data-motion-root]").forEach((root) => {
		if (root.dataset.motionReady === "true") return;
		root.dataset.motionReady = "true";

		const bounds =
			root.querySelector<HTMLElement>("[data-motion-bounds]") ?? root;
		const floatingTabs = Array.from(
			bounds.querySelectorAll<HTMLElement>("[data-motion-float]"),
		);
		const requestedSpeed = Number(root.dataset.motionSpeed || "1");
		const motionSpeed = Number.isFinite(requestedSpeed)
			? Math.min(3, Math.max(0.25, requestedSpeed))
			: 1;

		let targetX = 0;
		let targetY = 0;
		let currentX = 0;
		let currentY = 0;
		let previousTime = performance.now();
		let animationFrame = 0;
		let floatingState: Array<{
			element: HTMLElement;
			followers: HTMLElement[];
			x: number;
			y: number;
			vx: number;
			vy: number;
		}> = [];

		const getFollowers = (element: HTMLElement) => {
			if (!element.id) return [];

			return Array.from(
				root.querySelectorAll<HTMLElement>(
					`[data-motion-follow="${CSS.escape(element.id)}"]`,
				),
			);
		};

		const setFloatingPosition = (
			element: HTMLElement,
			followers: HTMLElement[],
			x: number,
			y: number,
		) => {
			const driftX = `${x}px`;
			const driftY = `${y}px`;
			element.style.setProperty("--drift-x", driftX);
			element.style.setProperty("--drift-y", driftY);

			for (const follower of followers) {
				follower.style.setProperty("--drift-x", driftX);
				follower.style.setProperty("--drift-y", driftY);
			}
		};

		const renderParallax = () => {
			currentX += (targetX - currentX) * 0.09;
			currentY += (targetY - currentY) * 0.09;

			root.style.setProperty("--scene-x", `${currentX * 5}px`);
			root.style.setProperty("--scene-y", `${currentY * 4}px`);
			root.style.setProperty("--deep-x", `${currentX * 11}px`);
			root.style.setProperty("--deep-y", `${currentY * 8}px`);
			root.style.setProperty("--counter-x", `${currentX * -3}px`);
			root.style.setProperty("--counter-y", `${currentY * -2}px`);
			root.style.setProperty("--far-a-x", `${currentX * 1.5}px`);
			root.style.setProperty("--far-a-y", `${currentY}px`);
			root.style.setProperty("--far-b-x", `${currentX * -2.2}px`);
			root.style.setProperty("--far-b-y", `${currentY * -1.5}px`);
			root.style.setProperty("--far-c-x", `${currentX * 3.2}px`);
			root.style.setProperty("--far-c-y", `${currentY * 2.2}px`);
		};

		const prepareFloatingTabs = () => {
			const boundsRect = bounds.getBoundingClientRect();

			floatingState = floatingTabs.map((element, index) => {
				const elementRect = element.getBoundingClientRect();
				const angle = Math.random() * Math.PI * 2;
				const speed = (0.08 + Math.random() * 0.14) * motionSpeed;
				const followers = getFollowers(element);

				if (!element.dataset.motionDepth) {
					if (element.classList.contains("depth-b")) {
						element.dataset.motionDepth = "far-b";
					} else if (element.classList.contains("depth-c")) {
						element.dataset.motionDepth = "far-c";
					} else if (element.classList.contains("depth-a")) {
						element.dataset.motionDepth = "far-a";
					} else {
						element.dataset.motionDepth = depthNames[index % depthNames.length];
					}
				}

				for (const follower of followers) {
					follower.dataset.motionDepth = element.dataset.motionDepth;
					follower.dataset.motionFollowReady = "true";
				}

				const x = elementRect.left - boundsRect.left;
				const y = elementRect.top - boundsRect.top;
				element.style.left = "0px";
				element.style.top = "0px";
				setFloatingPosition(element, followers, x, y);

				return {
					element,
					followers,
					x,
					y,
					vx: Math.cos(angle) * speed,
					vy: Math.sin(angle) * speed,
				};
			});
		};

		const resetMotion = () => {
			if (animationFrame) {
				window.cancelAnimationFrame(animationFrame);
				animationFrame = 0;
			}

			targetX = 0;
			targetY = 0;
			currentX = 0;
			currentY = 0;
			renderParallax();

			for (const element of floatingTabs) {
				element.style.removeProperty("left");
				element.style.removeProperty("top");
				element.style.removeProperty("--drift-x");
				element.style.removeProperty("--drift-y");

				for (const follower of getFollowers(element)) {
					follower.style.removeProperty("--drift-x");
					follower.style.removeProperty("--drift-y");
					delete follower.dataset.motionDepth;
					delete follower.dataset.motionFollowReady;
				}
			}
			floatingState = [];
		};

		const animate = (time: number) => {
			const frameScale = Math.min((time - previousTime) / 16.67, 2.5);
			previousTime = time;
			renderParallax();

			for (const item of floatingState) {
				const maxX = Math.max(0, bounds.clientWidth - item.element.offsetWidth);
				const maxY = Math.max(0, bounds.clientHeight - item.element.offsetHeight);

				item.x += item.vx * frameScale;
				item.y += item.vy * frameScale;

				if (item.x <= 0 || item.x >= maxX) {
					item.x = Math.min(maxX, Math.max(0, item.x));
					item.vx *= -1;
				}

				if (item.y <= 0 || item.y >= maxY) {
					item.y = Math.min(maxY, Math.max(0, item.y));
					item.vy *= -1;
				}

				setFloatingPosition(item.element, item.followers, item.x, item.y);
			}

			animationFrame = window.requestAnimationFrame(animate);
		};

		const startMotion = () => {
			if (motionPreference.matches || document.hidden || animationFrame) return;
			if (!floatingState.length) prepareFloatingTabs();
			previousTime = performance.now();
			animationFrame = window.requestAnimationFrame(animate);
		};

		const handlePointerMove = (event: PointerEvent) => {
			if (
				motionPreference.matches ||
				(event.pointerType && event.pointerType !== "mouse")
			) {
				return;
			}

			targetX = (event.clientX / window.innerWidth - 0.5) * 2;
			targetY = (event.clientY / window.innerHeight - 0.5) * 2;
			startMotion();
		};

		const recenter = () => {
			targetX = 0;
			targetY = 0;
			startMotion();
		};

		const handleVisibilityChange = () => {
			if (document.hidden) {
				if (animationFrame) {
					window.cancelAnimationFrame(animationFrame);
					animationFrame = 0;
				}
				return;
			}
			startMotion();
		};

		const handleMotionPreference = () => {
			if (motionPreference.matches) resetMotion();
			else startMotion();
		};

		window.addEventListener("pointermove", handlePointerMove, { passive: true });
		document.documentElement.addEventListener("mouseleave", recenter);
		document.addEventListener("visibilitychange", handleVisibilityChange);
		motionPreference.addEventListener("change", handleMotionPreference);
		startMotion();
	});
</script>

<style is:global>
	[data-motion-root] {
		--scene-x: 0px;
		--scene-y: 0px;
		--deep-x: 0px;
		--deep-y: 0px;
		--counter-x: 0px;
		--counter-y: 0px;
		--far-a-x: 0px;
		--far-a-y: 0px;
		--far-b-x: 0px;
		--far-b-y: 0px;
		--far-c-x: 0px;
		--far-c-y: 0px;
	}

	[data-motion-depth] {
		--motion-layer-x: 0px;
		--motion-layer-y: 0px;
		will-change: translate;
	}

	[data-motion-depth="scene"] {
		--motion-layer-x: var(--scene-x);
		--motion-layer-y: var(--scene-y);
	}

	[data-motion-depth="deep"] {
		--motion-layer-x: var(--deep-x);
		--motion-layer-y: var(--deep-y);
	}

	[data-motion-depth="counter"] {
		--motion-layer-x: var(--counter-x);
		--motion-layer-y: var(--counter-y);
	}

	[data-motion-depth="far-a"] {
		--motion-layer-x: var(--far-a-x);
		--motion-layer-y: var(--far-a-y);
	}

	[data-motion-depth="far-b"] {
		--motion-layer-x: var(--far-b-x);
		--motion-layer-y: var(--far-b-y);
	}

	[data-motion-depth="far-c"] {
		--motion-layer-x: var(--far-c-x);
		--motion-layer-y: var(--far-c-y);
	}

	[data-motion-depth]:not([data-motion-float]) {
		translate: var(--motion-layer-x) var(--motion-layer-y);
	}

	[data-motion-float] {
		--drift-x: 0px;
		--drift-y: 0px;
		translate:
			calc(var(--motion-layer-x, 0px) + var(--drift-x))
			calc(var(--motion-layer-y, 0px) + var(--drift-y));
		will-change: translate;
	}

	[data-motion-follow][data-motion-follow-ready="true"] {
		right: auto !important;
		left: 0 !important;
		top: 0 !important;
		translate:
			calc(
				var(--motion-layer-x, 0px) + var(--drift-x, 0px) +
					var(--motion-follow-x, 0px)
			)
			calc(
				var(--motion-layer-y, 0px) + var(--drift-y, 0px) +
					var(--motion-follow-y, 0px)
			);
		will-change: translate;
	}

	@media (prefers-reduced-motion: reduce) {
		[data-motion-depth],
		[data-motion-float],
		[data-motion-follow] {
			translate: 0 0;
			will-change: auto;
		}
	}
</style>
