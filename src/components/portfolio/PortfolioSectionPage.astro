---
import SiteMenu from "../common/SiteMenu.astro";
import HomeGlass from "../common/HomeGlass.astro";
import Arrow from "../common/Arrow.astro";
import PostDialog from "../common/PostDialog.astro";
import "../../styles/portfolio.css";

interface Props {
 section: "acting" | "film" | "video";
 title: string;
 eyebrow: string;
 heading: string;
 description: string;
 status: string;
 headingCardHref?: string;
 headingCardLabel?: string;
}
const {section,title,eyebrow,heading,description,status,headingCardHref,headingCardLabel} = Astro.props;
const themes = {
 acting: { color:'#FDBFBF', rgb:'253 191 191', ink:'#914b60', tone:'pink' },
 film: { color:'#EFDA4A', rgb:'239 218 74', ink:'#75650b', tone:'blue' },
 video: { color:'#7CF5B5', rgb:'124 245 181', ink:'#226b49', tone:'mint' },
};
const theme = themes[section];
---
<!doctype html>
<html lang="en">
 <head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="canonical" href={`https://jetsullivan.com/${section}/`} />
  <link rel="icon" type="image/png" href="/brand-center-favicon.png" />
  <title>Jet Sullivan</title>
 </head>
 <body class="socials-page portfolio-body" style={`--page-accent:${theme.color};--page-rgb:${theme.rgb};--page-ink:${theme.ink};`}>
  <a class="social-skip" href="#page-heading">Skip to content</a>
  <header class="social-header">
   <SiteMenu showHomeButton />
   <a class="social-wordmark" href="/">JET SULLIVAN<span>ACTOR · FILMMAKER · CREATOR</span></a>
  </header>
  <main class="social-page portfolio-page">
   <HomeGlass tone={theme.tone} />
   <section class="hero" data-section={section} aria-labelledby="page-heading">
    <div class="social-heading">
     <p class="eyebrow">{eyebrow}</p>
     <h1 id="page-heading" tabindex="-1" aria-label={heading}><span class="hero-name-layer hero-name-base" aria-hidden="true">{Array.from(heading.toUpperCase()).map((letter,index)=><span class="hero-letter" data-letter-index={index}>{letter}</span>)}</span></h1>
    </div>
    <div class="portfolio-intro">
     <p class="introduction">{description}</p>
     {headingCardHref && headingCardLabel && <a class="heading-card" href={headingCardHref}><span>{headingCardLabel}</span><Arrow /></a>}
    </div>
    <div class="collection-heading"><p class="eyebrow">Selected work</p><span>{title} / Jet Sullivan</span></div>
    <p class="sr-only" data-entry-status aria-live="polite">Loading {title.toLowerCase()} posts…</p>
    <div class="entry-grid" data-portfolio-entries data-section={section} data-empty-message={status} aria-busy="true">
     <article class="info-window status-card"><p>Loading {title.toLowerCase()} posts…</p></article>
    </div>
   </section>
  </main>
  <PostDialog accentTop="#FFFFFF" accent={theme.color} accentBottom={theme.ink} accentSolid={theme.color} />
  <footer class="site-footer"><div class="footer-content"><p class="footer-name">Jet Sullivan</p><p data-site-location="long">Austin, Texas</p></div></footer>
 </body>
</html>
<script>
 import "../../scripts/portfolio";
</script>
