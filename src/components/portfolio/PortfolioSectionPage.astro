---
import SiteMenu from "../common/SiteMenu.astro";
import PageMotion from "../common/PageMotion.astro";

interface Props {
	section: "acting" | "film" | "video";
	title: string;
	eyebrow: string;
	heading: string;
	description: string;
	status: string;
	accentTop: string;
	accent: string;
	accentBottom: string;
}

const {
	section,
	title,
	eyebrow,
	heading,
	description,
	status,
	accentTop,
	accent,
	accentBottom,
} = Astro.props;

const windows = Array.from({ length: 20 }, (_, index) => ({
	x: (index * 17 + 3) % 94,
	y: (index * 29 + 8) % 88,
	w: 38 + (index % 7) * 10,
	h: 31 + (index % 6) * 8,
	symbol: ["+", "○", "✦", "×", "◇", "▶", "⌁", "●"][index % 8],
}));
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={`${title} work by Jet Sullivan.`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} — Jet Sullivan</title>
	</head>
	<body>
		<main
			class="page"
			data-motion-root
			style={`--accent-top:${accentTop};--accent:${accent};--accent-bottom:${accentBottom};`}
		>
			<div class="top-frame" data-motion-depth="counter" aria-hidden="true"></div>
			<div class="accent-panel" data-motion-depth="counter" aria-hidden="true"></div>

			<div class="floaters" data-motion-bounds aria-hidden="true">
				{
					windows.map((item, index) => (
						<span
							class="mini-window"
							data-motion-float
							style={`--x:${item.x}%;--y:${item.y}%;--w:${item.w}px;--h:${item.h}px;--delay:-${index * 0.34}s;`}
						>
							<span class="mini-dots"><i></i><i></i><i></i></span>
							<span>{item.symbol}</span>
						</span>
					))
				}
			</div>

			<SiteMenu showHomeButton />

			<section
				class="content"
				data-motion-depth="scene"
				data-section={section}
				aria-labelledby="page-heading"
			>
				<p class="eyebrow">{eyebrow}</p>
				<h1 id="page-heading">{heading}</h1>
				<p class="introduction">{description}</p>
				<p class="sr-only" data-entry-status aria-live="polite">
					Loading {title.toLowerCase()} posts…
				</p>
				<div
					class="entry-grid"
					data-portfolio-entries
					data-section={section}
					data-empty-message={status}
					aria-busy="true"
				>
					<article class="info-window status-card">
						<p>Loading {title.toLowerCase()} posts…</p>
					</article>
				</div>
			</section>
		</main>

		<div class="section-divider footer-divider" aria-hidden="true"></div>

		<footer class="site-footer">
			<div class="footer-content">
				<p class="footer-name">Jet Sullivan</p>
				<span aria-hidden="true"></span>
				<p class="footer-location">Austin, Texas</p>
			</div>
		</footer>

		<PageMotion />
	</body>
</html>

<script>
	interface PortfolioEntry {
		id?: string;
		title?: string;
		description?: string;
		date?: string;
		link?: string | null;
		attachmentUrl?: string | null;
		attachmentType?: string | null;
		attachmentName?: string | null;
		attachmentAlt?: string | null;
		createdAt?: string;
	}

	const safeWebUrl = (value: unknown) => {
		if (typeof value !== "string" || !value.trim()) return null;

		try {
			const url = new URL(value, window.location.origin);
			const isSameOrigin = url.origin === window.location.origin;
			return url.protocol === "https:" ||
				(isSameOrigin && url.protocol === "http:")
				? url
				: null;
		} catch {
			return null;
		}
	};

	const formatDate = (value: unknown) => {
		if (typeof value !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(value)) {
			return null;
		}
		const date = new Date(`${value}T12:00:00`);
		if (Number.isNaN(date.getTime())) return null;
		return new Intl.DateTimeFormat("en-US", {
			year: "numeric",
			month: "long",
			day: "numeric",
		}).format(date);
	};

	const createStatusCard = (message: string, isError = false) => {
		const card = document.createElement("article");
		const copy = document.createElement("p");
		card.className = `info-window status-card${isError ? " error-card" : ""}`;
		copy.textContent = message;
		card.append(copy);
		return card;
	};

	const createAttachment = (entry: PortfolioEntry, title: string) => {
		const attachmentUrl = safeWebUrl(entry.attachmentUrl);
		if (!attachmentUrl) return null;

		const type =
			typeof entry.attachmentType === "string" ? entry.attachmentType : "";
		const name =
			(typeof entry.attachmentName === "string" &&
				entry.attachmentName.trim()) ||
			"Attached file";
		const frame = document.createElement("div");
		frame.className = "entry-attachment";

		if (type.startsWith("image/")) {
			const image = document.createElement("img");
			image.src = attachmentUrl.href;
			image.alt =
				(typeof entry.attachmentAlt === "string" &&
					entry.attachmentAlt.trim()) ||
				title;
			image.loading = "lazy";
			image.decoding = "async";
			frame.append(image);
			return frame;
		}

		if (type.startsWith("video/")) {
			const video = document.createElement("video");
			video.src = attachmentUrl.href;
			video.controls = true;
			video.preload = "metadata";
			video.playsInline = true;
			video.setAttribute("aria-label", entry.attachmentAlt || title);
			frame.append(video);
			return frame;
		}

		if (type.startsWith("audio/")) {
			const audio = document.createElement("audio");
			audio.src = attachmentUrl.href;
			audio.controls = true;
			audio.preload = "metadata";
			audio.setAttribute("aria-label", entry.attachmentAlt || title);
			frame.classList.add("audio-attachment");
			frame.append(audio);
			return frame;
		}

		if (type === "application/pdf") {
			const viewer = document.createElement("iframe");
			const fallback = document.createElement("a");
			viewer.src = `${attachmentUrl.href}#view=FitH`;
			viewer.title = entry.attachmentAlt || `${title} PDF`;
			viewer.loading = "lazy";
			fallback.href = attachmentUrl.href;
			fallback.target = "_blank";
			fallback.rel = "noopener noreferrer";
			fallback.textContent = `Open ${name} in a new tab ↗`;
			frame.classList.add("pdf-attachment");
			frame.append(viewer, fallback);
			return frame;
		}

		const fileLink = document.createElement("a");
		fileLink.href = attachmentUrl.href;
		fileLink.target = "_blank";
		fileLink.rel = "noopener noreferrer";
		fileLink.className = "attachment-file";
		fileLink.textContent = `Open ${name} ↗`;
		frame.classList.add("file-attachment");
		frame.append(fileLink);
		return frame;
	};

	const createEntryCard = (entry: PortfolioEntry) => {
		const card = document.createElement("article");
		const copy = document.createElement("div");
		const title = document.createElement("h2");
		const description = document.createElement("p");
		const formattedDate = formatDate(entry.date);

		card.className = "info-window entry-card";
		copy.className = "entry-copy";
		title.textContent =
			typeof entry.title === "string" && entry.title.trim()
				? entry.title.trim()
				: "Untitled";
		description.textContent =
			typeof entry.description === "string" ? entry.description.trim() : "";

		const attachment = createAttachment(entry, title.textContent);
		if (attachment) card.append(attachment);

		if (formattedDate && typeof entry.date === "string") {
			const time = document.createElement("time");
			time.dateTime = entry.date;
			time.textContent = formattedDate;
			copy.append(time);
		}

		copy.append(title);
		if (description.textContent) copy.append(description);

		const destination = safeWebUrl(entry.link);
		if (destination) {
			const link = document.createElement("a");
			link.href = destination.href;
			link.textContent = "Open linked project ↗";
			if (destination.origin !== window.location.origin) {
				link.target = "_blank";
				link.rel = "noopener noreferrer";
			}
			copy.append(link);
		}

		card.append(copy);
		return card;
	};

	document
		.querySelectorAll<HTMLElement>("[data-portfolio-entries]")
		.forEach(async (collection) => {
			const section = collection.dataset.section || "";
			const emptyMessage =
				collection.dataset.emptyMessage || "No posts have been added yet.";
			const status = collection.parentElement?.querySelector<HTMLElement>(
				"[data-entry-status]",
			);

			try {
				const response = await fetch(
					`/api/media-entries/${encodeURIComponent(section)}`,
				);
				if (!response.ok && response.status !== 404) {
					throw new Error("Request failed");
				}
				const result = response.ok ? await response.json() : { entries: [] };
				const entries = (
					Array.isArray(result.entries) ? result.entries : []
				) as PortfolioEntry[];
				entries.sort((left, right) =>
					`${right.date || ""}|${right.createdAt || ""}`.localeCompare(
						`${left.date || ""}|${left.createdAt || ""}`,
					),
				);
				collection.replaceChildren();

				if (!entries.length) {
					collection.append(createStatusCard(emptyMessage));
					if (status) status.textContent = emptyMessage;
				} else {
					for (const entry of entries) {
						collection.append(createEntryCard(entry));
					}
					if (status) {
						status.textContent = `${entries.length} ${
							entries.length === 1 ? "post" : "posts"
						} loaded.`;
					}
				}
			} catch {
				const message =
					"This collection is unavailable right now. Please try again soon.";
				collection.replaceChildren(createStatusCard(message, true));
				if (status) status.textContent = message;
			} finally {
				collection.setAttribute("aria-busy", "false");
			}
		});
</script>

<style is:global>
	:root {
		--yellow: #efda4a;
		--white: #fff;
		--black: #252525;
		--pink: #fdbfbf;
		--mint: #7cf5b5;
		--display: "Arial Black", "Myriad Pro", Arial, sans-serif;
		--body: "Myriad Pro", Myriad, Arial, sans-serif;
		--portfolio-footer-gap: clamp(105px, 10vw, 150px);
	}
	* { box-sizing: border-box; }
	html { background: var(--black); color: var(--black); font-family: var(--body); }
	body { margin: 0; min-width: 320px; min-height: 100vh; }
	.page {
		position: relative;
		width: 100%;
		padding: clamp(105px, 11vh, 145px) clamp(28px, 6vw, 105px)
			var(--portfolio-footer-gap);
		overflow: hidden;
		background: linear-gradient(
			180deg,
			#fff 0%,
			color-mix(in srgb, var(--accent-top) 42%, #fff) 32%,
			color-mix(in srgb, var(--accent) 50%, #fff) 68%,
			color-mix(in srgb, var(--accent-bottom) 62%, #f4f4f4) 100%
		);
	}
	.top-frame {
		position: absolute; z-index: 8; left: -3%; width: 106%; height: 9vw;
		min-height: 54px; background: var(--black); pointer-events: none;
	}
	.top-frame { top: -5vw; transform: rotate(-3deg); }
	.accent-panel {
		position: absolute; z-index: 1; top: 23%; bottom: -3%; left: 50%;
		width: min(76vw, 1050px); border: 1px solid rgb(255 255 255 / 58%);
		border-radius: 24px;
		outline: 1px solid rgb(255 255 255 / 16%);
		outline-offset: -3px;
		background: color-mix(in srgb, var(--accent) 28%, rgb(255 255 255 / 68%));
		box-shadow: 0 8px 28px rgb(37 37 37 / 14%);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px); transform: translateX(-50%);
	}
	.floaters { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
	.mini-window {
		position: absolute; top: var(--y); left: var(--x); display: grid;
		width: var(--w); height: var(--h); border: 1px solid rgb(255 255 255 / 45%);
		border-radius: clamp(5px, .7vw, 14px); background: rgb(156 166 170 / 20%);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 34%), 0 5px 14px rgb(37 37 37 / 5%);
		color: rgb(37 37 37 / 25%); font: 900 .7rem var(--display);
		backdrop-filter: blur(3px); place-items: center;
	}
	.mini-dots { position: absolute; top: 6px; left: 7px; display: flex; gap: 3px; }
	.mini-dots i { width: 4px; height: 4px; border-radius: 50%; background: var(--pink); }
	.mini-dots i:nth-child(2), .dots i:nth-child(2) { background: var(--yellow); }
	.mini-dots i:nth-child(3), .dots i:nth-child(3) { background: var(--mint); }
	.home-window {
		position: absolute; z-index: 12; top: clamp(70px, 8vh, 105px); left: clamp(28px, 5vw, 82px);
		display: grid; grid-template: auto 1fr / auto 1fr; gap: 8px 12px;
		width: clamp(175px, 13vw, 220px); height: clamp(88px, 7vw, 112px); padding: 17px;
		border: 1px solid rgb(255 255 255 / 52%); border-radius: 28px;
		outline: 1px solid rgb(255 255 255 / 14%); outline-offset: -3px;
		background: linear-gradient(rgb(255 255 255 / 5%), rgb(255 255 255 / 1%)), rgb(37 37 37 / 82%);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 48%), 0 14px 34px rgb(37 37 37 / 12%);
		color: var(--white); font: 900 clamp(.9rem, 1.2vw, 1.2rem) var(--display);
		text-decoration: none; text-transform: uppercase; backdrop-filter: blur(10px);
		transition: transform 320ms cubic-bezier(.34, 1.56, .64, 1);
	}
	.home-window:hover { transform: translateY(4px) scale(1.03); }
	.home-window .dots { grid-column: 1 / -1; }
	.home-window > span:last-child, .arrow { align-self: center; }
	.arrow { font: 900 2.4rem/1 var(--display); }
	.dots { display: flex; gap: 6px; }
	.dots i {
		width: 10px; height: 10px; border: 1px solid rgb(37 37 37 / 18%);
		border-radius: 50%; background: var(--pink);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 48%), 0 1px 3px rgb(37 37 37 / 32%);
	}
	.content {
		position: relative;
		z-index: 30;
		width: min(100%, 1280px);
		margin: 0 auto;
		text-align: center;
	}
	.eyebrow {
		margin: 0 auto clamp(12px, 2vh, 24px); font-size: clamp(.78rem, 1.1vw, 1rem);
		font-weight: 900; letter-spacing: .16em; text-align: center; text-transform: uppercase;
	}
	h1 {
		margin: 0; font: 950 clamp(4rem, 13vw, 13rem)/.72 var(--display);
		letter-spacing: -.035em; text-align: center; text-transform: uppercase;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		overflow: hidden;
		border: 0;
		margin: -1px;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}
	.introduction {
		width: min(90%, 690px);
		margin: clamp(24px, 3vh, 36px) auto 0;
		font-size: clamp(1rem, 1.5vw, 1.3rem);
		font-weight: 700;
		line-height: 1.45;
	}
	.entry-grid {
		display: grid;
		gap: clamp(18px, 2.5vw, 32px);
		width: min(92%, 820px);
		margin: clamp(48px, 6vh, 84px) auto 0;
		text-align: left;
	}
	.info-window {
		position: relative; width: 100%; margin: 0;
		padding: clamp(52px, 6vw, 76px) clamp(25px, 4vw, 54px) clamp(28px, 4vw, 48px);
		border: 1px solid rgb(255 255 255 / 58%); border-radius: 30px;
		outline: 1px solid rgb(255 255 255 / 16%); outline-offset: -3px;
		background: rgb(255 255 255 / 64%);
		box-shadow: 0 8px 28px rgb(37 37 37 / 14%);
		color: var(--black);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		animation: panel-float 4.8s ease-in-out infinite;
	}
	.info-window:nth-child(even) { animation-delay: -2.4s; }
	.entry-card {
		display: flex;
		flex-direction: column;
		gap: clamp(24px, 3vw, 36px);
	}
	.entry-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}
	.info-window h2, .info-window p { margin: 0; }
	.info-window h2 { font: 900 clamp(1.45rem, 2.4vw, 2.2rem) var(--display); text-transform: uppercase; }
	.info-window p { margin-top: 1rem; font-size: clamp(1.05rem, 1.6vw, 1.42rem); font-weight: 600; line-height: 1.45; }
	.entry-copy time {
		margin-bottom: 12px;
		color: color-mix(in srgb, var(--accent-bottom) 72%, var(--black));
		font-size: .78rem;
		font-weight: 900;
		letter-spacing: .1em;
		text-transform: uppercase;
	}
	.entry-copy > a,
	.entry-attachment > a {
		margin-top: 24px;
		color: color-mix(in srgb, var(--accent-bottom) 72%, var(--black));
		font: 900 .9rem var(--display);
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
		text-transform: uppercase;
	}
	.entry-attachment {
		width: 100%;
		overflow: hidden;
		border-radius: 20px;
		background: rgb(37 37 37 / 8%);
	}
	.entry-attachment img,
	.entry-attachment video,
	.entry-attachment iframe {
		display: block;
		width: 100%;
		border: 0;
		background: var(--black);
	}
	.entry-attachment img {
		height: auto;
		max-height: 680px;
		object-fit: contain;
	}
	.entry-attachment video {
		max-height: 680px;
	}
	.entry-attachment iframe {
		height: clamp(430px, 62vw, 720px);
	}
	.audio-attachment,
	.file-attachment {
		padding: 22px;
	}
	.audio-attachment audio {
		display: block;
		width: 100%;
	}
	.pdf-attachment > a {
		display: inline-block;
		margin: 16px 20px 20px;
	}
	.file-attachment .attachment-file {
		display: inline-flex;
		margin: 0;
	}
	.status-card {
		display: grid;
		min-height: 190px;
		text-align: center;
		place-items: center;
	}
	.status-card p {
		width: 100%;
		margin: 0;
	}
	.error-card p {
		color: #8d2929;
	}

	.section-divider {
		--divider-height: clamp(110px, 11vw, 190px);
		position: relative;
		z-index: 20;
		width: 100%;
		height: var(--divider-height);
		margin-block: calc(var(--divider-height) / -2);
		background: var(--black);
		clip-path: polygon(0 28%, 100% 0, 100% 72%, 0 100%);
		pointer-events: none;
	}

	.site-footer {
		position: relative;
		z-index: 1;
		min-height: clamp(310px, 38vh, 480px);
		padding: clamp(150px, 18vw, 240px) clamp(24px, 7vw, 120px) 64px;
		background-color: #383838;
		background-image: radial-gradient(
			circle,
			var(--black) 1.5px,
			transparent 1.6px
		);
		background-size: 24px 24px;
		color: var(--white);
	}

	.footer-content {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 32px;
		align-items: end;
		width: min(1180px, 100%);
		height: 100%;
		margin: 0 auto;
	}

	.footer-name {
		margin: 0;
		font: 950 clamp(2rem, 4vw, 4.5rem) / 0.9 var(--display);
		letter-spacing: -0.06em;
		text-transform: uppercase;
	}

	.site-footer nav {
		display: flex;
		gap: clamp(18px, 3vw, 42px);
	}

	.site-footer a {
		color: inherit;
		font-weight: 900;
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}

	.footer-location {
		justify-self: end;
		margin: 0;
		font-weight: 800;
	}

	@keyframes panel-float {
		0%,
		100% {
			translate: 0 0;
		}

		50% {
			translate: 0 -4px;
		}
	}

	@media (max-width: 820px) {
		:root { --portfolio-footer-gap: 48px; }
		.page {
			display: block;
			min-height: 100svh;
			padding: 128px 22px var(--portfolio-footer-gap);
			overflow-y: auto;
		}
		.accent-panel { top: 28%; width: calc(100% - 28px); }
		.home-window { top: 64px; left: 22px; width: 142px; height: 78px; padding: 12px; border-radius: 22px; }
		.dots { gap: 4px; } .dots i { width: 7px; height: 7px; }
		.arrow { font-size: 1.8rem; } .home-window > span:last-child { font-size: .72rem; }
		.content { padding-top: 0; } h1 { font-size: clamp(3.5rem, 18vw, 7rem); }
		.entry-grid { width: 100%; }
		.info-window { width: 100%; margin: 0; }
	}
	@media (max-width: 480px) {
		.page { padding-top: 128px; } .content { padding-top: 0; }
		.eyebrow { max-width: 66%; font-size: .67rem; }
		.info-window { padding: 50px 22px 28px; border-radius: 24px; }
		.info-window p { font-size: 1rem; }
	}

	@media (max-width: 700px) {
		.section-divider {
			--divider-height: 108px;
		}

		.site-footer {
			min-height: 380px;
			padding: 138px 24px 54px;
		}

		.footer-content {
			grid-template-columns: 1fr;
			gap: 34px;
			align-content: end;
			align-items: start;
		}

		.site-footer nav {
			flex-wrap: wrap;
		}

		.footer-location {
			justify-self: start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-window,
		.info-window {
			animation: none;
			transition: none;
		}
	}
</style>
