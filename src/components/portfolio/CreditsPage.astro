---
import SiteFooter from "../common/SiteFooter.astro";
import SiteMenu from "../common/SiteMenu.astro";
import HomeGlass from "../common/HomeGlass.astro";
import Arrow from "../common/Arrow.astro";
import "../../styles/portfolio.css";
import "../../styles/credits.css";

interface Props {
	section: "film" | "acting";
	metaDescription: string;
	documentTitle: string;
	homeButtonHref: string;
	homeButtonLabel: string;
	eyebrow: string;
	heading?: string;
	introduction: string;
	endpoint: string;
	categoryKicker: string;
	emptyItemMessage: string;
}
const {
	section, metaDescription, documentTitle, homeButtonHref, homeButtonLabel,
	eyebrow, heading = "Credits", introduction, endpoint, categoryKicker, emptyItemMessage,
} = Astro.props;
const themes = {
	acting: { color: "#FDBFBF", rgb: "253 191 191", ink: "#914b60", tone: "pink", label: "Acting" },
	film: { color: "#EFDA4A", rgb: "239 218 74", ink: "#75650b", tone: "blue", label: "Film" },
};
const theme = themes[section];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={metaDescription} />
		<link rel="canonical" href={`https://jetsullivan.com/${section}/credits/`} />
		<link rel="icon" type="image/png" href="/brand-center-favicon.png" />
		<title>{documentTitle}</title>
	</head>
	<body class="socials-page portfolio-body credits-body" style={`--page-accent:${theme.color};--page-rgb:${theme.rgb};--page-ink:${theme.ink};`}>
		<a class="social-skip" href="#credits-heading">Skip to content</a>
		<header class="social-header">
			<SiteMenu showHomeButton homeButtonHref={homeButtonHref} homeButtonLabel={homeButtonLabel} />
			<a class="social-wordmark" href="/">JET SULLIVAN<span>ACTOR · FILMMAKER · CREATOR</span></a>
		</header>
		<main class="social-page portfolio-page credits-page">
			<HomeGlass tone={theme.tone} />
			<section class="hero" aria-labelledby="credits-heading">
				<div class="social-heading">
					<p class="eyebrow">{eyebrow}</p>
					<h1 id="credits-heading" tabindex="-1" aria-label={heading}><span class="hero-name-layer hero-name-base" aria-hidden="true">{Array.from(heading.toUpperCase()).map((letter, index) => <span class="hero-letter" data-letter-index={index}>{letter}</span>)}</span></h1>
				</div>
				<div class="portfolio-intro">
					<p class="introduction">{introduction}</p>
					<a class="heading-card" href={homeButtonHref}><span>{homeButtonLabel}</span><Arrow /></a>
				</div>
				<div class="collection-heading"><p class="eyebrow">{theme.label} credits</p><span>{theme.label} / Jet Sullivan</span></div>
				<p class="sr-only" data-credit-status aria-live="polite">Loading credits…</p>
				<div class="credits-list" data-credit-categories data-credits-endpoint={endpoint}
					data-category-kicker={categoryKicker} data-empty-item-message={emptyItemMessage}
					data-default-category-color={theme.color} aria-busy="true">
					<article class="info-window status-card"><p>Loading credits…</p></article>
				</div>
			</section>
		</main>
		<SiteFooter />
	</body>
</html>

<script>
	import { createArrow } from "../../scripts/arrow";
	import { initializeSiteMotion } from "../../scripts/site-motion";

	initializeSiteMotion({
		canvasSelector: ".credits-page",
		titleSelector: "#credits-heading",
		sectionSelector: ".credits-page,.social-header,.site-footer",
		stationarySelector: ".social-header,.site-footer",
	});

	document.addEventListener("pointermove", (event) => {
		const card = (event.target as Element).closest<HTMLElement>(".credit-card,.heading-card");
		if (!card) return;
		const rect = card.getBoundingClientRect();
		card.style.setProperty("--glass-light-x", `${(event.clientX - rect.left) / rect.width * 100}%`);
		card.style.setProperty("--glass-light-y", `${(event.clientY - rect.top) / rect.height * 100}%`);
	});
	type CreditFilm = {
		id: string;
		name: string;
		link: URL | null;
		dateFrom: string | null;
		dateTo: string | null;
	};

	type CreditCategory = {
		id: string;
		position: string;
		colorRgb: string;
		films: CreditFilm[];
	};

	const categoriesRoot = document.querySelector<HTMLElement>(
		"[data-credit-categories]",
	);
	const creditStatus =
		document.querySelector<HTMLElement>("[data-credit-status]");
	const creditsEndpoint = categoriesRoot?.dataset.creditsEndpoint || "/api/credits";
	const categoryKicker = categoriesRoot?.dataset.categoryKicker || "Position";
	const emptyItemMessage =
		categoriesRoot?.dataset.emptyItemMessage ||
		"No productions have been added to this category yet.";
	const defaultCategoryColor =
		categoriesRoot?.dataset.defaultCategoryColor || "#efda4a";

	const cleanLabel = (value: unknown, maximumLength: number) => {
		if (typeof value !== "string") return null;
		const label = value.trim();
		return label && label.length <= maximumLength ? label : null;
	};

	const safeHttpsUrl = (value: unknown) => {
		if (typeof value !== "string" || !value.trim()) return null;

		try {
			const url = new URL(value);
			return url.protocol === "https:" && !url.username && !url.password
				? url
				: null;
		} catch {
			return null;
		}
	};

	const parseIsoDate = (value: unknown) => {
		if (typeof value !== "string") return null;
		const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value.trim());
		if (!match) return null;

		const year = Number(match[1]);
		const month = Number(match[2]);
		const day = Number(match[3]);
		if (year < 1 || year > 9999) return null;

		const parsed = new Date(0);
		parsed.setUTCHours(0, 0, 0, 0);
		parsed.setUTCFullYear(year, month - 1, day);
		if (
			parsed.getUTCFullYear() !== year ||
			parsed.getUTCMonth() !== month - 1 ||
			parsed.getUTCDate() !== day
		) {
			return null;
		}

		return value.trim();
	};

	const creditDateFormatter = new Intl.DateTimeFormat("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
		timeZone: "UTC",
	});

	const formatCreditDate = (value: string) => {
		const [year, month, day] = value.split("-").map(Number);
		const date = new Date(0);
		date.setUTCHours(0, 0, 0, 0);
		date.setUTCFullYear(year, month - 1, day);
		return creditDateFormatter.format(date);
	};

	const parseColor = (value: unknown) => {
		const match =
			typeof value === "string"
				? /^#([0-9a-f]{6})$/i.exec(value.trim())
				: null;
		const fallbackMatch = /^#([0-9a-f]{6})$/i.exec(defaultCategoryColor);
		const hex = match?.[1] || fallbackMatch?.[1] || "efda4a";
		const channels = [0, 2, 4].map((offset) =>
			Number.parseInt(hex.slice(offset, offset + 2), 16),
		);
		return `${channels[0]} ${channels[1]} ${channels[2]}`;
	};

	const normalizeFilm = (value: unknown, index: number): CreditFilm | null => {
		if (!value || typeof value !== "object") return null;
		const film = value as Record<string, unknown>;
		const name = cleanLabel(film.name, 180);
		if (!name) return null;
		const dateFrom = parseIsoDate(film.dateFrom);
		const requestedDateTo = parseIsoDate(film.dateTo);
		const dateTo =
			dateFrom && requestedDateTo && requestedDateTo > dateFrom
				? requestedDateTo
				: null;

		return {
			id: cleanLabel(film.id, 120) || `film-${index + 1}`,
			name,
			link: safeHttpsUrl(film.link),
			dateFrom,
			dateTo,
		};
	};

	const normalizeCategory = (
		value: unknown,
		index: number,
	): CreditCategory | null => {
		if (!value || typeof value !== "object") return null;
		const category = value as Record<string, unknown>;
		const position = cleanLabel(category.position, 100);
		if (!position) return null;

		const films = Array.isArray(category.films)
			? category.films
					.map((film, filmIndex) => normalizeFilm(film, filmIndex))
					.filter((film): film is CreditFilm => film !== null)
			: [];

		return {
			id: cleanLabel(category.id, 120) || `category-${index + 1}`,
			position,
			colorRgb: parseColor(category.color),
			films,
		};
	};

	const createStatusCard = (message: string, isError = false) => {
		const card = document.createElement("article");
		const copy = document.createElement("p");
		card.className = `info-window status-card${isError ? " error-card" : ""}`;
		copy.textContent = message;
		card.append(copy);
		return card;
	};

	const createFilmItem = (film: CreditFilm) => {
		const item = document.createElement("li");
		const copy = document.createElement("span");
		const name = document.createElement("span");
		copy.className = "film-copy";
		name.className = "film-name";
		name.textContent = film.name;
		copy.append(name);

		let dateLabel = "";
		if (film.dateFrom) {
			const dates = document.createElement("span");
			const fromTime = document.createElement("time");
			const formattedFrom = formatCreditDate(film.dateFrom);
			dates.className = "film-dates";
			fromTime.dateTime = film.dateFrom;
			fromTime.textContent = formattedFrom;

			if (film.dateTo) {
				const toTime = document.createElement("time");
				const formattedTo = formatCreditDate(film.dateTo);
				toTime.dateTime = film.dateTo;
				toTime.textContent = formattedTo;
				dates.append("From ", fromTime, " – To ", toTime);
				dateLabel = `From ${formattedFrom} to ${formattedTo}`;
			} else {
				dates.append("Date ", fromTime);
				dateLabel = `Date ${formattedFrom}`;
			}

			copy.append(dates);
		}

		if (!film.link) {
			const entry = document.createElement("span");
			entry.className = "film-entry";
			entry.append(copy);
			item.append(entry);
			return item;
		}

		const link = document.createElement("a");
		const arrow = document.createElement("span");
		link.href = film.link.href;
		link.target = "_blank";
		link.rel = "noopener noreferrer";
		link.className = "film-entry";
		link.setAttribute(
			"aria-label",
			`${film.name}${dateLabel ? `, ${dateLabel}` : ""} (opens in a new tab)`,
		);
		link.append(copy);
		arrow.className = "outbound-arrow";
		arrow.setAttribute("aria-hidden", "true");
		arrow.append(createArrow());
		link.append(arrow);
		item.append(link);
		return item;
	};

	const createCategoryCard = (category: CreditCategory, index: number) => {
		const card = document.createElement("article");
		const headingGroup = document.createElement("div");
		const marker = document.createElement("span");
		const kicker = document.createElement("p");
		const heading = document.createElement("h2");
		const films = document.createElement("ul");
		const headingId = `credit-category-heading-${index + 1}`;

		card.className = "info-window credit-card";
		card.setAttribute("aria-labelledby", headingId);
		card.style.setProperty("--category-rgb", category.colorRgb);
		headingGroup.className = "credit-heading";
		marker.className = "credit-marker";
		marker.setAttribute("aria-hidden", "true");
		kicker.className = "credit-kicker";
		kicker.textContent = categoryKicker;
		heading.id = headingId;
		heading.textContent = category.position;
		films.className = "film-list";

		headingGroup.append(marker, kicker, heading);

		if (category.films.length) {
			for (const film of category.films) films.append(createFilmItem(film));
		} else {
			const empty = document.createElement("li");
			empty.className = "empty-films";
			empty.textContent = emptyItemMessage;
			films.append(empty);
		}

		card.append(headingGroup, films);
		return card;
	};

	const loadCredits = async () => {
		if (!categoriesRoot || !creditStatus) return;
		categoriesRoot.setAttribute("aria-busy", "true");
		creditStatus.textContent = "Loading credits…";

		try {
			const response = await fetch(creditsEndpoint, {
				credentials: "same-origin",
				headers: { Accept: "application/json" },
			});
			if (!response.ok) throw new Error(`HTTP ${response.status}`);

			const result = (await response.json()) as { categories?: unknown };
			const categories = Array.isArray(result.categories)
				? result.categories
						.map((category, index) => normalizeCategory(category, index))
						.filter(
							(category): category is CreditCategory => category !== null,
						)
				: [];

			if (!categories.length) {
				const message = "No credits have been added yet.";
				categoriesRoot.replaceChildren(createStatusCard(message));
				creditStatus.textContent = message;
				return;
			}

			const fragment = document.createDocumentFragment();
			categories.forEach((category, index) => {
				fragment.append(createCategoryCard(category, index));
			});
			categoriesRoot.replaceChildren(fragment);
			creditStatus.textContent = `${categories.length} credit categor${
				categories.length === 1 ? "y" : "ies"
			} loaded.`;
		} catch {
			const message =
				"Credits are unavailable right now. Please try again soon.";
			categoriesRoot.replaceChildren(createStatusCard(message, true));
			creditStatus.textContent = message;
		} finally {
			categoriesRoot.setAttribute("aria-busy", "false");
		}
	};

	void loadCredits();
</script>
