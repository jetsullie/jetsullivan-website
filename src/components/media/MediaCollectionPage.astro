---
import SiteMenu from "../common/SiteMenu.astro";
import PageMotion from "../common/PageMotion.astro";

interface Props {
	section: "featured" | "interviews" | "behind-the-scenes" | "press";
	title: string;
	eyebrow: string;
	description: string;
	ctaLabel: string;
	emptyMessage: string;
	accentTop: string;
	accent: string;
	accentBottom: string;
	accentSolid: string;
}

const {
	section,
	title,
	eyebrow,
	description,
	ctaLabel,
	emptyMessage,
	accentTop,
	accent,
	accentBottom,
	accentSolid,
} = Astro.props;

const windows = Array.from({ length: 20 }, (_, index) => ({
	x: (index * 17 + 3) % 94,
	y: (index * 29 + 8) % 88,
	w: 38 + (index % 7) * 10,
	h: 31 + (index % 6) * 8,
	symbol: ["+", "○", "✦", "×", "◇", "▶", "⌁", "●"][index % 8],
}));
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content={`${description} Explore ${title.toLowerCase()} by Jet Sullivan.`}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} — Jet Sullivan</title>
	</head>
	<body>
		<main
			class="collection-page"
			data-motion-root
			style={`--accent-top:${accentTop};--accent:${accent};--accent-bottom:${accentBottom};--accent-solid:${accentSolid};`}
		>
			<div class="top-frame" data-motion-depth="counter" aria-hidden="true"></div>
			<div class="accent-panel" data-motion-depth="counter" aria-hidden="true"></div>

			<div class="background-windows" data-motion-bounds aria-hidden="true">
				{
					windows.map((item) => (
						<span
							class="mini-window"
							data-motion-float
							style={`--x:${item.x}%;--y:${item.y}%;--w:${item.w}px;--h:${item.h}px;`}
						>
							<span class="mini-dots"><i></i><i></i><i></i></span>
							<span>{item.symbol}</span>
						</span>
					))
				}
			</div>

			<SiteMenu
				showHomeButton
				homeButtonHref="/media/"
				homeButtonLabel="Return to media"
			/>

			<section
				class="collection-content"
				data-motion-depth="scene"
				data-section={section}
				aria-labelledby="collection-heading"
			>
				<p class="eyebrow">{eyebrow}</p>
				<h1 id="collection-heading">
					{
						section === "behind-the-scenes" ? (
							<>
								<span>Behind the</span>
								<span>Scenes</span>
							</>
						) : (
							title
						)
					}
				</h1>
				<p class="introduction">{description}</p>
				<p class="sr-only" data-media-status aria-live="polite">
					Loading {title.toLowerCase()}…
				</p>

				<div
					class="entry-grid"
					data-media-collection
					data-section={section}
					data-cta-label={ctaLabel}
					data-empty-message={emptyMessage}
					aria-busy="true"
				>
					<article class="entry-card status-card">
						<p>Loading {title.toLowerCase()}…</p>
					</article>
				</div>
			</section>
		</main>

		<div class="section-divider footer-divider" aria-hidden="true"></div>

		<footer class="site-footer">
			<div class="footer-content">
				<p class="footer-name">Jet Sullivan</p>
				<span aria-hidden="true"></span>
				<p class="footer-location">Austin, Texas</p>
			</div>
		</footer>

		<PageMotion />
	</body>
</html>

<script>
	interface MediaEntry {
		id?: string;
		category?: string;
		title?: string;
		description?: string;
		date?: string;
		link?: string;
		url?: string;
		imageUrl?: string;
		imageKey?: string;
		imageAlt?: string;
		alt?: string;
		image?: { url?: string; alt?: string };
		createdAt?: string;
	}

	const safeWebUrl = (value: unknown) => {
		if (typeof value !== "string" || !value.trim()) return null;

		try {
			const url = new URL(value, window.location.origin);
			const isSameOrigin = url.origin === window.location.origin;
			return url.protocol === "https:" || (isSameOrigin && url.protocol === "http:")
				? url
				: null;
		} catch {
			return null;
		}
	};

	const formatDate = (value: unknown) => {
		if (typeof value !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(value)) {
			return null;
		}

		const date = new Date(`${value}T12:00:00`);
		if (Number.isNaN(date.getTime())) return null;

		return new Intl.DateTimeFormat("en-US", {
			year: "numeric",
			month: "long",
			day: "numeric",
		}).format(date);
	};

	const createStatusCard = (message: string, isError = false) => {
		const card = document.createElement("article");
		const copy = document.createElement("p");
		card.className = `entry-card status-card${isError ? " error-card" : ""}`;
		copy.textContent = message;
		card.append(copy);
		return card;
	};

	const createEntryCard = (
		entry: MediaEntry,
		section: string,
		ctaLabel: string,
	) => {
		const card = document.createElement("article");
		const copy = document.createElement("div");
		const title = document.createElement("h2");
		const description = document.createElement("p");
		const formattedDate = formatDate(entry.date);

		card.className = "entry-card";
		copy.className = "entry-copy";
		title.textContent =
			typeof entry.title === "string" && entry.title.trim()
				? entry.title.trim()
				: "Untitled";
		description.textContent =
			typeof entry.description === "string" ? entry.description.trim() : "";

		if (section === "behind-the-scenes") {
			const directImageUrl =
				entry.imageUrl ??
				entry.image?.url ??
				(typeof entry.imageKey === "string"
					? `/api/media/${encodeURIComponent(entry.imageKey)}`
					: undefined);
			const imageUrl = safeWebUrl(directImageUrl);

			if (imageUrl) {
				const imageFrame = document.createElement("div");
				const image = document.createElement("img");
				imageFrame.className = "entry-image";
				image.src = imageUrl.href;
				image.alt =
					(typeof entry.imageAlt === "string" && entry.imageAlt.trim()) ||
					(typeof entry.image?.alt === "string" && entry.image.alt.trim()) ||
					(typeof entry.alt === "string" && entry.alt.trim()) ||
					title.textContent;
				image.loading = "lazy";
				image.decoding = "async";
				imageFrame.append(image);
				card.append(imageFrame);
			}
		}

		if (formattedDate && typeof entry.date === "string") {
			const time = document.createElement("time");
			time.dateTime = entry.date;
			time.textContent = formattedDate;
			copy.append(time);
		}

		copy.append(title);
		if (description.textContent) copy.append(description);

		const destination = safeWebUrl(entry.link ?? entry.url);
		if (destination) {
			const link = document.createElement("a");
			link.href = destination.href;
			link.textContent = ctaLabel;
			if (destination.origin !== window.location.origin) {
				link.target = "_blank";
				link.rel = "noopener noreferrer";
				link.setAttribute(
					"aria-label",
					`${ctaLabel} — opens in a new tab`,
				);
			}
			copy.append(link);
		}

		card.append(copy);
		return card;
	};

	document
		.querySelectorAll<HTMLElement>("[data-media-collection]")
		.forEach(async (collection) => {
			const section = collection.dataset.section || "";
			const ctaLabel = collection.dataset.ctaLabel || "View";
			const emptyMessage =
				collection.dataset.emptyMessage || "No updates have been added yet.";
			const status = collection.parentElement?.querySelector<HTMLElement>(
				"[data-media-status]",
			);

			try {
				const response = await fetch(
					`/api/media-entries/${encodeURIComponent(section)}`,
				);
				if (!response.ok && response.status !== 404) {
					throw new Error("Request failed");
				}

				const result = response.ok ? await response.json() : { entries: [] };
				const entries = (
					Array.isArray(result.entries)
						? result.entries
						: Array.isArray(result.items)
							? result.items
							: Array.isArray(result.media)
								? result.media
								: []
				) as MediaEntry[];

				entries.sort((left, right) =>
					`${right.date || ""}|${right.createdAt || ""}`.localeCompare(
						`${left.date || ""}|${left.createdAt || ""}`,
					),
				);
				collection.replaceChildren();

				if (!entries.length) {
					collection.append(createStatusCard(emptyMessage));
					if (status) status.textContent = emptyMessage;
				} else {
					for (const entry of entries) {
						collection.append(createEntryCard(entry, section, ctaLabel));
					}
					if (status) {
						status.textContent = `${entries.length} ${
							entries.length === 1 ? "update" : "updates"
						} loaded.`;
					}
				}
			} catch {
				collection.replaceChildren(
					createStatusCard(
						"This collection is unavailable right now. Please try again soon.",
						true,
					),
				);
				if (status) {
					status.textContent =
						"This collection is unavailable right now. Please try again soon.";
				}
			} finally {
				collection.setAttribute("aria-busy", "false");
			}
		});
</script>

<style is:global>
	:root {
		--yellow: #efda4a;
		--white: #fff;
		--black: #252525;
		--pink: #fdbfbf;
		--mint: #7cf5b5;
		--display: "Arial Black", "Myriad Pro", Arial, sans-serif;
		--body: "Myriad Pro", Myriad, Arial, sans-serif;
		--collection-footer-gap: clamp(105px, 10vw, 150px);
	}

	* { box-sizing: border-box; }
	html {
		background: var(--black);
		color: var(--black);
		font-family: var(--body);
	}
	body {
		margin: 0;
		min-width: 320px;
		min-height: 100vh;
	}

	.collection-page {
		position: relative;
		width: 100%;
		min-height: 100svh;
		padding: clamp(110px, 12vh, 150px) clamp(28px, 6vw, 105px)
			var(--collection-footer-gap);
		overflow: hidden;
		background: linear-gradient(
			180deg,
			#fff 0%,
			color-mix(in srgb, var(--accent-top) 34%, #fff) 32%,
			color-mix(in srgb, var(--accent) 46%, #fff) 68%,
			color-mix(in srgb, var(--accent-bottom) 58%, #f4f4f4) 100%
		);
	}

	.top-frame {
		position: absolute;
		z-index: 8;
		left: -3%;
		width: 106%;
		height: 9vw;
		min-height: 54px;
		background: var(--black);
		pointer-events: none;
	}
	.top-frame { top: -5vw; transform: rotate(-3deg); }

	.accent-panel {
		position: absolute;
		z-index: 1;
		top: 23%;
		bottom: -3%;
		left: 50%;
		width: min(76vw, 1050px);
		border: 1px solid rgb(255 255 255 / 58%);
		border-radius: 24px;
		outline: 1px solid rgb(255 255 255 / 16%);
		outline-offset: -3px;
		background: color-mix(in srgb, var(--accent) 28%, rgb(255 255 255 / 68%));
		box-shadow: 0 8px 28px rgb(37 37 37 / 14%);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		transform: translateX(-50%);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		overflow: hidden;
		border: 0;
		margin: -1px;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}

	.background-windows {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}
	.mini-window {
		position: absolute;
		top: var(--y);
		left: var(--x);
		display: grid;
		width: var(--w);
		height: var(--h);
		border: 1px solid rgb(255 255 255 / 45%);
		border-radius: clamp(5px, .7vw, 14px);
		background: rgb(156 166 170 / 20%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 34%),
			0 5px 14px rgb(37 37 37 / 5%);
		color: rgb(37 37 37 / 25%);
		font: 900 .7rem var(--display);
		-webkit-backdrop-filter: blur(3px);
		backdrop-filter: blur(3px);
		place-items: center;
	}
	.mini-dots {
		position: absolute;
		top: 6px;
		left: 7px;
		display: flex;
		gap: 3px;
	}
	.mini-dots i {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--pink);
	}
	.mini-dots i:nth-child(2) { background: var(--yellow); }
	.mini-dots i:nth-child(3) { background: var(--mint); }

	.collection-content {
		position: relative;
		z-index: 30;
		min-width: 0;
		width: min(100%, 1280px);
		max-width: 100%;
		margin: 0 auto;
		text-align: center;
	}
	.eyebrow {
		margin: 0 auto clamp(12px, 2vh, 24px);
		font-size: clamp(.78rem, 1.1vw, 1rem);
		font-weight: 900;
		letter-spacing: .16em;
		text-transform: uppercase;
	}
	h1 {
		margin: 0;
		font: 950 clamp(4.5rem, 12vw, 12rem)/.78 var(--display);
		letter-spacing: -.025em;
		overflow-wrap: anywhere;
		text-transform: uppercase;
	}
	h1 span { display: block; }
	.collection-content[data-section="behind-the-scenes"] h1 {
		font-size: clamp(3.1rem, 8vw, 8.2rem);
		line-height: .86;
	}
	.introduction {
		width: min(90%, 690px);
		margin: clamp(24px, 3vh, 36px) auto 0;
		font-size: clamp(1rem, 1.5vw, 1.3rem);
		font-weight: 700;
		line-height: 1.45;
	}

	.entry-grid {
		display: grid;
		gap: clamp(18px, 2.5vw, 32px);
		min-width: 0;
		width: min(92%, 820px);
		max-width: 100%;
		margin: clamp(48px, 6vh, 84px) auto 0;
		text-align: left;
	}
	.entry-card {
		position: relative;
		display: flex;
		min-width: 0;
		width: 100%;
		max-width: 100%;
		min-height: 230px;
		padding: clamp(32px, 4vw, 48px) clamp(25px, 4vw, 54px);
		overflow: hidden;
		border: 1px solid rgb(255 255 255 / 58%);
		border-radius: 30px;
		outline: 1px solid rgb(255 255 255 / 16%);
		outline-offset: -3px;
		background: rgb(255 255 255 / 64%);
		box-shadow: 0 8px 28px rgb(37 37 37 / 14%);
		color: var(--black);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		animation: card-float 5.2s ease-in-out infinite;
	}
	.entry-card:nth-child(even) { animation-delay: -2.6s; }
	.entry-card:hover { animation-play-state: paused; }
	.entry-copy {
		position: relative;
		z-index: 1;
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: flex-start;
		min-width: 0;
	}
	.entry-copy time {
		margin-bottom: 12px;
		color: color-mix(in srgb, var(--accent-bottom) 72%, var(--black));
		font-size: .78rem;
		font-weight: 900;
		letter-spacing: .1em;
		text-transform: uppercase;
	}
	.entry-copy h2 {
		margin: 0;
		font: 900 clamp(1.25rem, 2.4vw, 2rem)/1.08 var(--display);
		overflow-wrap: anywhere;
		text-transform: uppercase;
	}
	.entry-copy p {
		margin: 15px 0 0;
		color: rgb(37 37 37 / 78%);
		font-size: clamp(.98rem, 1.3vw, 1.12rem);
		font-weight: 600;
		line-height: 1.5;
	}
	.entry-copy a {
		margin-top: auto;
		padding-top: 26px;
		color: color-mix(in srgb, var(--accent-bottom) 72%, var(--black));
		font: 900 .9rem var(--display);
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
		text-transform: uppercase;
		transition: color 180ms ease, transform 260ms cubic-bezier(.34, 1.4, .64, 1);
	}
	.entry-copy a:hover { color: var(--black); transform: translateX(3px); }
	.entry-copy a:focus-visible {
		border-radius: 4px;
		outline: 3px solid var(--accent-solid);
		outline-offset: 4px;
	}

	.entry-image {
		flex: 0 0 42%;
		align-self: stretch;
		min-width: 0;
		margin: clamp(-48px, -4vw, -32px) 26px clamp(-48px, -4vw, -32px)
			clamp(-54px, -4vw, -25px);
		overflow: hidden;
		background: rgb(255 255 255 / 10%);
	}
	.entry-image img {
		display: block;
		width: 100%;
		height: 100%;
		min-height: 230px;
		object-fit: cover;
	}
	.status-card {
		grid-column: 1 / -1;
		align-items: center;
		justify-content: center;
		min-height: 190px;
		text-align: center;
	}
	.status-card p {
		min-width: 0;
		width: 100%;
		max-width: 100%;
		margin: 0;
		font-size: clamp(1rem, 1.6vw, 1.2rem);
		font-weight: 800;
		overflow-wrap: anywhere;
		white-space: normal;
	}
	.error-card p { color: #8d2929; }

	.section-divider {
		--divider-height: clamp(110px, 11vw, 190px);
		position: relative;
		z-index: 20;
		width: 100%;
		height: var(--divider-height);
		margin-block: calc(var(--divider-height) / -2);
		background: var(--black);
		clip-path: polygon(0 28%, 100% 0, 100% 72%, 0 100%);
		pointer-events: none;
	}

	.site-footer {
		position: relative;
		z-index: 1;
		min-height: clamp(310px, 38vh, 480px);
		padding: clamp(150px, 18vw, 240px) clamp(24px, 7vw, 120px) 64px;
		background-color: #383838;
		background-image: radial-gradient(
			circle,
			var(--black) 1.5px,
			transparent 1.6px
		);
		background-size: 24px 24px;
		color: var(--white);
	}

	.footer-content {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 32px;
		align-items: end;
		width: min(1180px, 100%);
		height: 100%;
		margin: 0 auto;
	}

	.footer-name {
		margin: 0;
		font: 950 clamp(2rem, 4vw, 4.5rem) / 0.9 var(--display);
		letter-spacing: -0.06em;
		text-transform: uppercase;
	}

	.site-footer nav {
		display: flex;
		gap: clamp(18px, 3vw, 42px);
		justify-content: center;
	}

	.site-footer a {
		color: inherit;
		font-size: 0.82rem;
		font-weight: 900;
		letter-spacing: 0.12em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.site-footer a:hover {
		color: var(--accent-solid);
	}

	.site-footer a:focus-visible {
		border-radius: 3px;
		outline: 3px solid var(--accent-solid);
		outline-offset: 5px;
	}

	.footer-location {
		justify-self: end;
		margin: 0;
		font: 900 clamp(1rem, 1.5vw, 1.4rem) var(--display);
		text-transform: uppercase;
	}

	@keyframes card-float {
		0%,
		100% { translate: 0 0; }
		50% { translate: 0 -4px; }
	}

	@media (max-width: 820px) {
		.collection-page {
			display: block;
			min-height: 100svh;
			padding: 178px 24px var(--collection-footer-gap);
		}
		.accent-panel {
			top: 23%;
			width: calc(100% - 28px);
		}
		h1 { font-size: clamp(3.5rem, 18vw, 7rem); }
		.collection-content[data-section="interviews"] h1 {
			font-size: clamp(2.7rem, 12vw, 5rem);
			overflow-wrap: normal;
			word-break: normal;
		}
		.collection-content[data-section="behind-the-scenes"] h1 {
			font-size: clamp(1.9rem, 7.6vw, 3.8rem);
		}
		.entry-grid {
			width: 100%;
		}
	}

	@media (max-width: 480px) {
		.collection-page {
			padding: 166px 16px var(--collection-footer-gap);
		}
		.eyebrow { max-width: 76%; font-size: .67rem; }
		.introduction { width: 100%; font-size: .98rem; }
		.entry-grid { gap: 15px; margin-top: 36px; }
		.entry-card {
			min-height: 230px;
			padding: 30px 21px;
			border-radius: 22px;
		}
		.entry-image {
			flex-basis: 40%;
			margin: -30px 18px -30px -21px;
		}
		.entry-image img { min-height: 230px; }
	}

	@media (max-width: 390px) {
		.entry-card:has(.entry-image) { display: block; }
		.entry-image {
			width: calc(100% + 42px);
			height: 190px;
			margin: -30px -21px 24px;
		}
		.entry-image img { min-height: 0; }
	}

	@media (max-width: 700px) {
		.section-divider {
			--divider-height: 108px;
		}

		.site-footer {
			min-height: 380px;
			padding: 138px 24px 54px;
		}

		.footer-content {
			grid-template-columns: 1fr;
			gap: 34px;
			align-content: end;
			align-items: start;
		}

		.site-footer nav {
			flex-wrap: wrap;
		}

		.footer-location {
			justify-self: start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.entry-card,
		.entry-copy a { animation: none; transition: none; }
	}
</style>
