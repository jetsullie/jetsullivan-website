---
import SiteMenu from "./SiteMenu.astro";
import PageMotion from "./PageMotion.astro";

interface Props {
	title: string;
	eyebrow: string;
	heading: string;
	description: string;
	status: string;
	accentTop: string;
	accent: string;
	accentBottom: string;
}

const {
	title,
	eyebrow,
	heading,
	description,
	status,
	accentTop,
	accent,
	accentBottom,
} = Astro.props;

const windows = Array.from({ length: 20 }, (_, index) => ({
	x: (index * 17 + 3) % 94,
	y: (index * 29 + 8) % 88,
	w: 38 + (index % 7) * 10,
	h: 31 + (index % 6) * 8,
	symbol: ["+", "○", "✦", "×", "◇", "▶", "⌁", "●"][index % 8],
}));
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={`${title} work by Jet Sullivan.`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} — Jet Sullivan</title>
	</head>
	<body>
		<main
			class="page"
			data-motion-root
			style={`--accent-top:${accentTop};--accent:${accent};--accent-bottom:${accentBottom};`}
		>
			<div class="top-frame" data-motion-depth="counter" aria-hidden="true"></div>
			<div class="bottom-frame" data-motion-depth="counter" aria-hidden="true"></div>
			<div class="accent-panel" data-motion-depth="counter" aria-hidden="true"></div>

			<div class="floaters" data-motion-bounds aria-hidden="true">
				{
					windows.map((item, index) => (
						<span
							class="mini-window"
							data-motion-float
							style={`--x:${item.x}%;--y:${item.y}%;--w:${item.w}px;--h:${item.h}px;--delay:-${index * 0.34}s;`}
						>
							<span class="mini-dots"><i></i><i></i><i></i></span>
							<span>{item.symbol}</span>
						</span>
					))
				}
			</div>

			<SiteMenu showHomeButton />

			<section class="content" data-motion-depth="scene" aria-labelledby="page-heading">
				<p class="eyebrow">{eyebrow}</p>
				<h1 id="page-heading">{heading}</h1>
				<div class="info-window">
					<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<h2>{title}</h2>
					<p>{description}</p>
					<p class="status">{status}</p>
				</div>
			</section>

			<p class="location" data-motion-depth="deep">Austin, TX</p>
		</main>
		<PageMotion />
	</body>
</html>

<style>
	:root {
		--yellow: #efda4a;
		--white: #fff;
		--black: #252525;
		--pink: #fdbfbf;
		--mint: #7cf5b5;
		--display: "Arial Black", "Myriad Pro", Arial, sans-serif;
		--body: "Myriad Pro", Myriad, Arial, sans-serif;
	}
	:global(*) { box-sizing: border-box; }
	:global(html) { background: var(--black); color: var(--black); font-family: var(--body); }
	:global(body) { margin: 0; min-width: 320px; min-height: 100vh; }
	.page {
		position: relative;
		display: grid;
		width: 100%;
		min-height: 100svh;
		padding: clamp(90px, 10vh, 130px) clamp(28px, 6vw, 105px) clamp(80px, 8vh, 110px);
		overflow: hidden;
		background: linear-gradient(180deg, #fff 0%, #effcff 32%, #d4f7fd 68%, #c0f2fb 100%);
		isolation: isolate;
	}
	.top-frame, .bottom-frame {
		position: absolute; z-index: 8; left: -3%; width: 106%; height: 9vw;
		min-height: 54px; background: var(--black); pointer-events: none;
	}
	.top-frame { top: -5vw; transform: rotate(-3deg); }
	.bottom-frame { bottom: -5vw; transform: rotate(-3deg); }
	.accent-panel {
		position: absolute; z-index: 1; top: 24%; bottom: -2%; left: 50%;
		width: min(76vw, 1050px); border: 1px solid rgb(255 255 255 / 48%);
		border-radius: 24px;
		background: linear-gradient(180deg, var(--accent-top), var(--accent) 42%, var(--accent-bottom) 135%);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 52%), 0 12px 36px rgb(37 37 37 / 7%);
		backdrop-filter: blur(8px); transform: translateX(-50%);
	}
	.floaters { position: absolute; z-index: 0; inset: 0; overflow: hidden; pointer-events: none; }
	.mini-window {
		position: absolute; top: var(--y); left: var(--x); display: grid;
		width: var(--w); height: var(--h); border: 1px solid rgb(255 255 255 / 45%);
		border-radius: clamp(5px, .7vw, 14px); background: rgb(156 166 170 / 20%);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 34%), 0 5px 14px rgb(37 37 37 / 5%);
		color: rgb(37 37 37 / 25%); font: 900 .7rem var(--display);
		backdrop-filter: blur(3px); place-items: center;
	}
	.mini-dots { position: absolute; top: 6px; left: 7px; display: flex; gap: 3px; }
	.mini-dots i { width: 4px; height: 4px; border-radius: 50%; background: var(--pink); }
	.mini-dots i:nth-child(2), .dots i:nth-child(2) { background: var(--yellow); }
	.mini-dots i:nth-child(3), .dots i:nth-child(3) { background: var(--mint); }
	.home-window {
		position: absolute; z-index: 12; top: clamp(70px, 8vh, 105px); left: clamp(28px, 5vw, 82px);
		display: grid; grid-template: auto 1fr / auto 1fr; gap: 8px 12px;
		width: clamp(175px, 13vw, 220px); height: clamp(88px, 7vw, 112px); padding: 17px;
		border: 1px solid rgb(255 255 255 / 52%); border-radius: 28px;
		outline: 1px solid rgb(255 255 255 / 14%); outline-offset: -3px;
		background: linear-gradient(rgb(255 255 255 / 5%), rgb(255 255 255 / 1%)), rgb(37 37 37 / 82%);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 48%), 0 14px 34px rgb(37 37 37 / 12%);
		color: var(--white); font: 900 clamp(.9rem, 1.2vw, 1.2rem) var(--display);
		text-decoration: none; text-transform: uppercase; backdrop-filter: blur(10px);
		transition: transform 320ms cubic-bezier(.34, 1.56, .64, 1);
	}
	.home-window:hover { transform: translateY(4px) scale(1.03); }
	.home-window .dots { grid-column: 1 / -1; }
	.home-window > span:last-child, .arrow { align-self: center; }
	.arrow { font: 900 2.4rem/1 var(--display); }
	.dots { display: flex; gap: 6px; }
	.dots i {
		width: 10px; height: 10px; border: 1px solid rgb(37 37 37 / 18%);
		border-radius: 50%; background: var(--pink);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 48%), 0 1px 3px rgb(37 37 37 / 32%);
	}
	.content { position: relative; z-index: 3; align-self: center; justify-self: center; width: min(100%, 1100px); }
	.eyebrow {
		margin: 0 auto clamp(12px, 2vh, 24px); font-size: clamp(.78rem, 1.1vw, 1rem);
		font-weight: 900; letter-spacing: .16em; text-align: center; text-transform: uppercase;
	}
	h1 {
		margin: 0; font: 950 clamp(4.5rem, 12vw, 12rem)/.78 var(--display);
		letter-spacing: -.02em; text-align: center; text-transform: uppercase;
	}
	.info-window {
		position: relative; width: min(88%, 690px); margin: clamp(48px, 6vh, 84px) auto 0;
		padding: clamp(52px, 6vw, 76px) clamp(25px, 4vw, 54px) clamp(28px, 4vw, 48px);
		border: 1px solid rgb(255 255 255 / 46%); border-radius: 30px;
		outline: 1px solid rgb(255 255 255 / 12%); outline-offset: -3px;
		background: rgb(37 37 37 / 82%);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 28%), 0 18px 45px rgb(37 37 37 / 15%);
		color: var(--white); backdrop-filter: blur(10px);
	}
	.info-window > .dots { position: absolute; top: 22px; left: 25px; }
	.info-window h2, .info-window p { margin: 0; }
	.info-window h2 { font: 900 clamp(1.45rem, 2.4vw, 2.2rem) var(--display); text-transform: uppercase; }
	.info-window p { margin-top: 1rem; font-size: clamp(1.05rem, 1.6vw, 1.42rem); font-weight: 600; line-height: 1.45; }
	.info-window .status { padding-top: .9rem; border-top: 1px solid rgb(255 255 255 / 20%); color: var(--accent); }
	.location {
		position: absolute; z-index: 5; right: clamp(32px, 6vw, 110px); bottom: clamp(54px, 7vh, 92px);
		margin: 0; font: 950 clamp(1.3rem, 2.2vw, 2.6rem)/1 var(--display); letter-spacing: -.06em;
	}
	@media (max-width: 820px) {
		.page { display: block; min-height: 100svh; padding: 105px 24px 90px; overflow-y: auto; }
		.accent-panel { top: 33%; width: calc(100% - 28px); }
		.home-window { top: 64px; left: 22px; width: 142px; height: 78px; padding: 12px; border-radius: 22px; }
		.dots { gap: 4px; } .dots i { width: 7px; height: 7px; }
		.arrow { font-size: 1.8rem; } .home-window > span:last-child { font-size: .72rem; }
		.content { padding-top: 94px; } h1 { font-size: clamp(3.5rem, 18vw, 7rem); }
		.info-window { width: 100%; margin-top: 42px; }
		.location { right: 24px; bottom: 46px; font-size: 1.25rem; }
	}
	@media (max-width: 480px) {
		.page { padding-top: 92px; } .content { padding-top: 112px; }
		.eyebrow { max-width: 66%; font-size: .67rem; }
		.info-window { padding: 50px 22px 28px; border-radius: 24px; }
		.info-window p { font-size: 1rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.home-window { transition: none; }
	}
</style>
